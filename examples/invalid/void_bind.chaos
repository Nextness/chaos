// expect-stage: type
// expect-error: cannot bind a Void value
// A 'Void <> Error' value has nothing to bind; use the bare 'unless catch'.
Some_Error :: error {
    GENERIC;
}

f :: proc -> (Void <> Some_Error) {
    return .GENERIC!;
}

#entry main :: proc -> S64 {
    x := f() unless catch {
        return -1;
    }
    return 0;
}