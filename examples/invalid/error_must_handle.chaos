// expect-stage: type
// expect-error: must handle the error before using the value
// The value of an error-returning call must be handled before it is used.
Some_Error :: error { GENERIC; }

f :: proc (x: S64) -> (S64 <> Some_Error) {
    return x;
}

main :: proc -> S64 {
    r := f(5);
    return r;
}
