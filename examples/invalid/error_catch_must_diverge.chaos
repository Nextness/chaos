// expect-stage: type
// expect-error: the catch block must diverge
// A catch block that falls through would leave the value undefined.
Some_Error :: error { GENERIC; }

f :: proc (x: S64) -> (S64 <> Some_Error) {
    return x;
}

main :: proc -> S64 {
    r := f(5) unless catch {
    }
    return r;
}
