// expect-exit: 0
// expect-stdout: <empty>
// expect-stderr: <empty>
// Namespaced import: members are reached through the namespace binding.
c :: #import «core»;
#entry main :: proc -> S64 {
    if !c.is_digit(48)             then return 1;
    if c.is_digit(65)              then return 2;
    if c.int_to_string(42) != «42» then return 3;
    if c.string_to_int(«42») != 42 then return 4;
    return 0;
}
