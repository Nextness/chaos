// expect-exit: 0
// expect-stdout: <empty>
// expect-stderr: <empty>
// Struct field reads and writes on plain values: 's.field' targets for '=',
// '+=', '++', and reads through indexing and nested structs.
Point :: struct {
    x: S64;
    y: S64;
}

Outer :: struct {
    inner: Point;
    label: String;
}

#entry main :: proc -> S64 {
    p := Point.{x=1, y=2};
    if p.x != 1 || p.y != 2 { return 1; }
    p.x = 10;
    p.y += 5;
    if p.x != 10 || p.y != 7 { return 2; }
    p.x++;
    p.y--;
    if p.x != 11 || p.y != 6 { return 3; }

    o := Outer.{inner=Point.{x=3, y=4}, label=«hi»};
    o.inner.x = 9;
    o.label = «bye»;
    if o.inner.x != 9 || o.label != «bye» { return 4; }

    arr := []Point.{Point.{x=1, y=2}};
    arr[0].x = 5;
    if arr[0].x != 5 { return 5; }

    return 0;
}
