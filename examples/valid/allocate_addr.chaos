// expect-exit: 0
// expect-stdout: <empty>
// expect-stderr: <empty>
// '#allocate <size>' returns an Addr to a heap block. Addr accepts any pointer
// value implicitly and is cast back to a pointer with '.(*T)'. '#deallocate'
// is currently accepted but does not reclaim bump-arena storage.
#entry main :: proc -> S64 {
    buf := #allocate 16;
    p: *S64 = buf.(*S64);
    p.* = 42;
    if p.* != 42 { return 1; }

    // A pointer value assigns to Addr implicitly.
    a: Addr = p;
    q: *S64 = a.(*S64);
    if q.* != 42 { return 2; }

    #deallocate buf;
    return 0;
}
