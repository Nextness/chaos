// expect-exit: 5
// expect-stdout: <empty>
// expect-stderr: <empty>
// A matching value-or-error pair can be re-raised with 'return r;'.
Some_Error :: error {
    GENERIC;
    SOMETHING_ELSE;
}

f :: proc (x: S64) -> (S64 <> Some_Error) {
    if x < 0 {
        return .GENERIC!;
    }
    return x * 2;
}

g :: proc -> (S64 <> Some_Error) {
    r := f(-1);
    if r catch {
        return r;
    }
    return r;
}

#entry main :: proc -> S64 {
    r := g() unless catch {
        return 5;
    }
    return r;
}
