// expect-exit: 40
// A range loop index binding is scoped to the loop body and does not replace
// an outer binding with a different name.
#entry main :: proc -> S64 {
    arr := []S64.{1, 2, 3};
    idx := 40;
    for i, elem: arr {
        if elem == 2 {
            continue;
        }
    }
    return idx;
}
