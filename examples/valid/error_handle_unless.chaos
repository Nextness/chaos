// expect-exit: 7
// 'unless catch err' binds the error so it can be inspected and handled
// differently per error value.
Some_Error :: error {
    GENERIC;
    SOMETHING_ELSE;
}

f :: proc (x: S64) -> (S64 <> Some_Error) {
    if x < 0 {
        return .GENERIC!;
    }
    return x * 2;
}

#entry main :: proc -> S64 {
    r := f(-1) unless catch err {
        if err == .GENERIC! {
            return 7;
        }
        return 8;
    }
    return r;
}
