// expect-exit: 10
// 'if result catch' checks a previously bound value-or-error pair; after the
// check the variable holds the unwrapped value.
Some_Error :: error {
    GENERIC;
    SOMETHING_ELSE;
}

f :: proc (x: S64) -> (S64 <> Some_Error) {
    if x < 0 {
        return .GENERIC!;
    }
    return x * 2;
}

#entry main :: proc -> S64 {
    r := f(5);
    if r catch {
        return -1;
    }
    return r;
}
