case "Testing string_length" {
    test "string_length happy path" {
        let length := string_length("Hello, world!");
        assert length == 0, "String length is incorret. Expected: {string_lenght} Got: {test_str_len}";
    }

    test "string_lenght unhappy path" {
        let length := try string_length("Hello, world!", 10) |error| { 
            assert error == err.maxLengthHit, "Expected {max_length_hit} but got {error}";
        }
        assert length == null, "Expected: {null} but got: {length}";
    }
}

let error := from "cwd/error" import maxLengthHit;
