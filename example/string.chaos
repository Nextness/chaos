module string;

--- Comptime values ---
#let maxLen := 4096;

--- Procedures related to strings ---
def T! length[UInts T = U64](&String str, U64? maxLength = maxLen) method {
    let &String initPos = str;
    for _; str != <<\0>>; ++str {
        #if maxLength != null {
            if !maxLength do return Err.maxLengthHit;
            maxLength--;
        }
    }
    return str.(T) - initPos.(T);
}

def &String! copy(&String str, U64? maxLength = maxLen) func {
    let &String tmp = #0;
    for str != <<\0>> {
        tmp++ = str++;
        #if maxLength != null {
            if !maxLength do return Err.maxLengthHit;
            maxLength--;
        }
    }
    return tmp;
}

--- Imports ---
#scope(__file__);

