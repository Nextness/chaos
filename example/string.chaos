module string;

--- Comptime values ---
#let maxLen : 4096;

--- Procedures related to strings ---
proc String.length[T UInts = U64](&self, maxLength U64? = maxLen) T! {
    let sefInitPos *String = self;
    for nothing; self != <<\0>>; ++self {
        #if maxLength != null {
            if !maxLength then return Err.maxLengthLimitHit;
            maxLength--;
        }
    }
    return self.(T) - selfInitPos.(T);
}

proc String.copy(&self, maxLength U64? = maxLen) String! {
    let tmp *String = #0;
    for nothing; self != <<\0>>; nothing {
        tmp++ = self++;
        #if maxLength != null {
            if !maxLength then return Err.maxLengthLimitHit;
            maxLength--;
        }
    }
    return tmp;
}

--- Imports ---
#scope(__file__);

import core::numbers;
import core::errors;

