MAX-LEN :: 4096;

length :: proc (str: String, max-length: U64? = MAX-LEN) -> I64! {
    init-pos := &str;
    while str != «\0» evaluate ++str {
        #if max-length != undefined {
            if not max-length return "max-length-hit";
            max-length--;
        }
    }
    return str - init-pos;
}

copy :: proc (str: &String, max-length: U64? = MAX-LEN) -> String! {
    tmp: *String;
    while str != «\0» evaluate tmp++ = str++ {
        #if max-length !=undefined {
            if not max-length return "max-length-hit";
            max-length--;
        }
    }
    return tmp;
}

#module string;
#import «core::numbers.chaos»;
#import «core::errors.chaos»;

