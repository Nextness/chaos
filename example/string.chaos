#let maxLen := 4096;

proc length
    generic T: UInts = U64
    expects str: *Str, maxLength: *?U64 = maxLen
    returns T!
executes
    let initPos: *String = str;
    while str != «\0» : ++str executes
        if maxLength != null executes
            if !maxLength return maxLengthHit!;
            maxLength--;
        end if
    end while
    return (str as T) - (initPos as T);
end proc

proc copy
    expects str: &String, maxLength: ?U64 = maxLen
    returns *String!
executes
    let tmp *String;
    while str != «\0» executes
        tmp++ = str++;
        if maxLength != null executes
            if !maxLength return maxLengthHit!;
            maxLength--;
        end if
    end while
    return tmp;
end proc

#module string;
#import «core::numbers.chaos»;
#import «core::errors.chaos»;

