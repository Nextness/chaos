#let MAX-LEN := 4096;

proc length
    generic T
    expects str as *String, max-length as U64? = MAX-LEN
executes
    def init-pos as *String = str;
    while str != «\0» increment str executes
        if max-length != undefined executes
            if not max-length return max-length-hit!;
            max-length--;
        end-if
    end-while
    return (str as T) - (init-pos as T);
end-proc

proc copy
    expects str as &String, max-length as U64? = MAX-LEN
    returns *String!
executes
    def tmp as *String;
    while str != «\0» executes
        tmp++ = str++;
        if max-length != undefined executes
            if not max-length return max-length-hit!;
            max-length--;
        end-if
    end-while
    return tmp;
end-proc

#module string;
#import «core::numbers.chaos»;
#import «core::errors.chaos»;

