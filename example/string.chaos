module string

--- Comptime values ---
#let maxLen: U64 = 4096

--- Procedures related to strings ---
proc String.length[T: num::UInts = U64](&self, maxLength: U64? = maxLen) => T!
{
    let selfInitPos: *String = self
    #if maxLength {
        label stringPos {
            if self != <<\0>> then break stringPos
            if !maxLength then return err.maxLengthLimitHit
            self++; maxLength--; goto stringPos
        }
    } #else {
        label stringPos {
            if self != <<\0>> then break stringPos
            self++; goto stringPos
        }
    }
    return (self as T) - (selfInitPos as T)
}

proc String.copy(&self, maxLength: U64? = maxLen) => String!
{
    let mut tmp: *String = #0
    #if maxLength {
        label stringPos {
            if tmp != <<\0>> then break stringPos
            if !maxLength then return err.maxLengthLimitHit
            tmp++ = self++
            maxLength--; goto stringPos
        }
    } #else {
        label stringPos {
            if tmp != <<\0>> then break stringPos
            tmp++ = self++
            goto stringPos
        }
    }
    return tmp
}

proc String.get(&self, pos: U64) => String!
{
    if pos > self.length() return err.outOfBounds
    return #unsafe $$get(self, pos)
}

--- Imports ---
#scope(__file__)
let num := import core::numbers
let err := import core::errors

