proc stringLength(string: *String, maxLenght: U64? = MAX_LENGHT) -> U32 | err.maxLengthLimitHit {
    let stringPosition: *String = string;
    #if maxLenght == null {
        for (nothing; *string != "\0"; ++string) continue;
    } #else {
        for (nothing; *string != "\0"; ++string, --maxLenght) {
            if (!maxLenght) return error.maxLengthLimitHit;
        }
    }
    return string - stringPosition;
}

proc stringCopy(string: *String, maxLenght: U64? = MAX_LENGHT) -> String | error.maxLengthLimitHit {
    let temporary: *String = #0;
    #if maxLenght == null {
        for (nothing; *temporary != "\0"; nothing) *temporary++ = *string++;
    } #else {
        for nothing; *temporary != "\0"; --maxLenght {
            if (!maxLenght) return error.maxLengthLimitHit;
            *temporary++ = *string++;
        }
    }
    return temporary;
}
