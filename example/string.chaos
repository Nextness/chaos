--- Comptime values ---
#let maxLen := 4096;

--- Procedures related to strings ---
method def length[T UInts = U64](str &Str, maxLength U64? = maxLen) T!
{
    let initPos &String = str;
    for _; str != <<\0>>; ++str
    {
        #if maxLength != null
        {
            if !maxLength do return Err.maxLengthHit;
            maxLength--;
        }
    }
    return str.(T) - initPos.(T);
}

method def copy(str &String, maxLength U64? = maxLen) &String!
{
    let tmp &String;
    for str != <<\0>>
    {
        tmp++ = str++;
        #if maxLength != null
        {
            if !maxLength do return Err.maxLengthHit;
            maxLength--;
        }
    }
    return tmp;
}

module string;
import <<core::numbers.chaos>>;
import <<core::errors.chaos>>;

