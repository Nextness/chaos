
proc chaosTokenizer
    expects fileContent: *Buffer
    returns tokArray: Array using Token = #0
executes
    let tokens: Buffer;
    let content = assert run fileContent.string;
    let singleTokens := new Array using Char with "=, "+, "  end new;

    while pos < run fileContent.len : pos++ executes
        let token: Token;
        if run isSpace with (assert content at pos) continue;
        if run isInside with (assert content at pos), singleTokens executes
            run token.writeByte with content at pos;
            let val := run token.string;

            if val == executes
            case "= executes
                token.value = val;
                token.typ = tokAssingment
            break case
            case "+ executes
                token.value = val;
                token.typ = tokPlus;
            break case
            case "  executes
                token.value = val;
                token.typ = tokSemiColon;
            break case
            end if

            assert run listTok.append with token;
            run token.reset;
            continue
        end if
    end while

    return tokArray;
end proc

type TokenType distinct I64    end type
type TokenKind distinct I64    end type
type Operation distinct String end type
type NodeType  distinct I64    end type

type TokType enum
    tokGlobal: TokenType;
    tokLet;
    tokAssignment;
    tokPlus;
    tokPrimitiveType;
    tokIdentifier;
    tokNumber;
    tokSemiColon;
    tokCount;
    tokEndOfFile;
end type

#module main

#import «bytes.chaos»;
#import «fmt.chaos»;
#import «os.chaos»;
#import «strings.chaos»;
#import «unicode.chaos»;

