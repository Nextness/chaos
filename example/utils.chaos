is-uppercase <T> :: proc (val: T) -> Bool {
    #if   (T == Byte)   result :: internal.is-uppercase<Byte>(val);
    #elif (T == String) result :: internal.is-uppercase<String>(val);
    #else               #exit «Failed to compile - unsupported type {type-of T}»;
    return result;
}

Lexer-Error-Config :: struct {
    error-msg: String;
    examples: Array<dyn, String?>;
    example-count: I64;
}

new-lexer-error :: proc (error-msg: String) -> Lexer-Error-Config {
    return Lexer-Error-Config(
        error-msg = error-msg,
        examples = Array<dyn, String>(),
        example-count = 0,
    );
}

Lexer-Error-Config.new-example :: proc (self: *Self, examples: ...String) -> Void {
    example-len :: length(examples);
    assert example > 0;

    pad :: «    »;
    self.example-count += 1;
    preffix :: «({self.example-count})»;
    while id, example in examples {
        if id == 0 {
            tmp :: «{pad}{preffix} {example}»;
            self.examples.append(tmp);
            continue;
        }
        tmp :: «{pad}    {example}»;
        self.examples.append(tmp);
    }
}

get-something :: proc (id: &String) -> U64! {
    id :: «»; // This should fail, since it is a reference, and references cannot be assigned.
              // In a sense, this value is immutable.
    result: I64 = some-operation(id);
    return result;
}

