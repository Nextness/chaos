struct SimpleStruct {
    field1: F64,
    field2: U64,
    field3: String,
}

proc SimpleStruct.__Addition__[T, U](self: T, other: U) -> Nihil {
    #if typeOf(self), typeOf(other) == {
        #case *Self | Self, *Self | Self {
            self.field1 += other.field1;
            self.field2 += other.field2;
            self.field3 = i"{self.field3} {other.field3}";
            return Nihil;
        }
        #case *Self | Self, F64 {
            self.field1 += other;
            return Nihil;
        }
        #case *Self | Self, U64 {
            self.field2 += other;
            return Nihil;
        }
    }
}

proc SimpleStruct.__Subtraction__[T, U](self: T, other: U) -> Nihil {
    ...;
}

