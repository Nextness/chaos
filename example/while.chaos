proc main(nothing: Nihil) -> Nihil {
    exampleWhileDefault();
    exampleWhileWithExpression();
    exampleWhileWithRang();
    exampleWhileInList();
    exampleWhileWithDict();
}

proc exampleWhileDefault(nothing: Nihil) -> Nihil {
    let someCondition, increment := true, 0;
    for someCondition {
        increment++;
        println(i"Increment count: {increment}");
        if increment == 3 {
            println("Breaking out of the loop");
            break;
        }
    }
}

proc exampleWhileWithExpression(nothing: Nihil) -> Nihil {
    let someCondition, increment := true, 0;
    for nothing; someCondition; increment++ {
        println(i"Increment count: {increment}");
        if (increment == 3) {
            println("Breaking out of the loop");
            someCondition = false;
        }
    }
}

proc exampleWhileWithRange(nothing: Nihil) -> Nihil {
    for (0..10) println(i"Current value: {it}");
}

proc exampleWhileWithNamedRange(nothing: Nihil) -> Nihil {
    for (someValue in 0..10) println(i"Current value: {some_value}");
}

proc exampleWhileInList(nothing: Nihil) -> Nihil {
    let exampleList: List[4, String] = {"element_0", "element_1", "element_2", "element_3"};
    for (element in exampleList) println(i"{element}");
}

proc exampleWhileWithDict(nothing: Nihil) -> Nihil {
    let exampleDict: Dict[4, String, U64] = {"element_0": 0, "element_1": 1, "element_2": 2, "element_3": 3};
    for (value in exampleDict) println(i"{value}");
    for (key, value in exampleDict) println(i"{value}");
}
