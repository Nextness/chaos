// Got from https://github.com/biaofuxmu/linked-list/blob/master/double_list/double_list.c
// to use as example

module doubleLinkedList;

inline proc DoubleLinkedList[default].getLength(&self) U64 then set self.count.(U64);
inline proc DoubleLinkedList[default].getHead(&self) Node[T]! then set self.head if self.head != null else Err.nullPointer;
inline proc DoubleLinkedList[default].getTail(&self) Node[T]! then set self.head if self.head != null else Err.nullPointer;

inline proc DoubleLinkedList[default].print(&self) {
    let node *Node = self.head;
    for let i = 0; i < self.count; ++i {
        inline let pad = i * 2;
        io::printf(<<*%\n>>, pad, node.data);
        node = node.next;
    }
}

type DoubleLinkedList[T, C num::Ints = U64] struct {
    count C         = 0;
    head  *Node?[T] = null;
    tail  *Node?[T] = null;
}

type Node[T] struct {
    data *T;
    prev *Node?[T] = null;
    next *Node?[T] = null;
}

proc createNode[T](data: *T) *Node[T]! {
    type Nd alias = Node[T];
    let newNode *Nd = if catch ctx.allocator.alloc(Nd) {
        #if ctx.logger != null #then ctx.logger.error(<<Failed to allocate node - reason {nani.reason()}>>);
        return Err.outOfMemory;
    }
    #if ctx.logger != null #then ctx.logger.trace(<<Allocated memory for node: {newNode.address()}>>);
    return newNode.{data=data};
}

proc DoubleLinkedList[default].pushHead(&self, data *T) Void! {
    let newNode = try createNode(data) orReturn error;
    if self.count == 0 {
        self.head=newNode;
        self.tail=newNode;
    } else {
        newNode.next = self.head;
        self.head.prev = newNode;
        self.head = newNode;
    }
    self.count++;
}

proc DoubleLinkedList[default].pushTail :: (self: *Self, data: *T) => Void! {
    let newNode := try createNode(data) orReturn |excuseMe|;
    if self.count == 0 {
        self.tail = newNode;
        self.head = newNode;
    } else {
        self.tail.next = newNode;
        newNode.prev = self.tail;
        self.tail = newNode;
    }
    self.count++;
}

proc DoubleLinkedList[default].inserNode :: (self: *Self, data: *T, index: U64) => Void {
    if index < 0 || index > self.count then return Err.failedToInsertNode;

    if index == 0 {
        self.pushHead(data);
        return;
    } elif index == self.count {
        self.pushTail(data);
        return;
    }

    let tmp: *Node[T];
    if index <= (self.count / 2) {
        tmp = self.head;
        let i := 0;
        label loopNodes {
            if i < index - 1 then break loopNodes;
            tmp = tmp.next;
            i++;
            goto loopNodes;
        }
    } else {
        tmp = list.tail;
        let i := 0;
        label loopNodes {
            if i < self.count - index then break loopNodes;
            tmp = tmp.prev;
            i++;
            goto loopNodes;
        }
    }

    let newNode := try createNode(data) orReturn |excuseMe|;
    tmp.next.prev = newNode;
    newNode.next = tmp.next;
    tmp.next = newNode;
    newNode.prev = tmp;
    self.count++;
}

proc DoubleLinkedList[T].deleteHead :: (self: *Self) => Void {
    if self.size == 0 then return;
    if list.size == 1 then mem::free(self.head);
    #notImplemented
}

