// Got from https://github.com/biaofuxmu/linked-list/blob/master/double_list/double_list.c
// to use as example

length :: #inline proc (dll: &Double-Linked-List) -> U64 {
    return dll.*.count as U64;
}

head :: #inline proc (dll: &Double-Linked-List) -> *Node! {
    return dll.head != undefined ? dll.head : "null-pointer";
}

tail :: #inline proc (dll: &Double-Linked-List) -> *Node! {
    return dll.tail != undefined ? dll.tail : "null-pointer";
}

print :: proc (dll: &Double-Linked-List) -> Void {
    node: &Node = dll.head;
    while i < dll.count evaluate i++ {
        pad := i * 2;
        io.print(«{pad:node.data}»);
        node = node.next;
    }
}

Double-Linked-List <C: num.Ints, T: AnyType> :: struct {
    count: C = 0;
    head: *Node<T>?;
    tail: *Node<T>?;
}

Node <T> :: struct {
    data: *T;
    prev: *Node<T>?;
    next: *Node<T>?;
}

init-node <T> :: proc (data: T) -> *Node<T>! {
    ND :: alias Node<T>;
    new-node: *ND = alloc(size-of ND) unless |error| {
        logger(ERROR, «Failed to allocate node - {error}»);
        return "out-of-memory :: you are poor and don't have enough RAM lol";
    }

    logger(TRACE, «Allocated memory for node: {new-node.address}»);
    new-node.data = data;
    return new-node;
}

push-head :: proc (node: *Node, data: Node.T) -> Void! {
    new-node := init-node(data)?;
    if dll.count == 0 {
        dll.head = newNode;
        dll.tail = newNode;
    } else {
        new-node.next = dll.head;
        dll.head.prev = new-node;
        dll.head = newNode;
    }
    dll.count++;
}

insert-node :: proc (node: *Node, data: Node.T, index: U64) -> Void! {
    if (index < 0 or index > dll.count) return "out-of-bounds :: doesn't know how to measure...";

    if index == 0 {
        push-head(dll, data);
        return;
    } elif index == dll.count {
        push-tail(dll, data);
        return;
    }

    tmp: *Node<Node.T>;
    if index <= dll.count / 2 {
        for i := 0 while i < index - 1 evaluate i++ tmp = tmp.next;
    } else {
        for i := 0 while i < dll.count evaluate i++ tmp = tmp.prev;
    }

    new-node := init-node(data)?;
    tmp.next.prev = new-node;
    new-node.next = tmp.next;
    tmp.next = new-node;
    new-node.prev = tmp;
    dll.count++;
}

delete-head :: proc (dll: *Double-Linked-List) -> Void! {
    #todo;
}

#module doubleLinkedList;

