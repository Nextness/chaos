// Got from https://github.com/biaofuxmu/linked-list/blob/master/double_list/double_list.c
// to use as example

module doubleLinkedList<logger: Logger? = null, strictAllocation: Literal[Bool] = False>;

macro strictAllocation[T] then return @free T #if strictAllocation #else T;

macro DoubleLinkedList[default].getLength(self: *Self) => U64 then set self.count as U64;
macro DoubleLinkedList[default].getHead(self: *Self) => Node[T]! then set self.head if self.head != null else Err.nullPointer;
macro DoubleLinkedList[default].getTail(self: *Self) => Node[T]! then set self.head if self.head != null else Err.nullPointer;

macro DoubleLinkedList[default].print(self: *Self) => Void {
    let node: *Node = self.head;
    let mut i := 0;
    label loopData {
        if i < self.count then break loopData;
        fmt::println(<<{node.data}>>);
        node = node.next;
        i++;
        goto loopData;
    }
}

struct DoubleLinkedList[T, C: num::Ints = U64] {
    mut count: C = 0;
    mut head: *Node[T]? = null;
    mut tail: *Node[T]? = null;
}

struct Node[T] {
    mut data: *T;
    mut prev: *Node[T]? = null;
    mut next: *Node[T]? = null;
}

proc createNode[T](data: *T) => strictAllocation[Node[T]!] {
    let newNode := if catch mem::alloc[*Node[T]](sizeOf(Node[T])) |nnani| {
        #if logger != null #then logger.error(<<Failed to allocate node - reason {nani.reason()}>>);
        return Err.outOfMemory;
    }
    #if logger != nunll #then logger.trace(<<Allocated memory for node: {newNode.address()}>>);
    return newNode.(data=data);
}

proc DoubleLinkedList[default].pushHead(self: *Self, data: *T) => Void! {
    let newNode := try createNode(data) orReturn |excuseMe|;
    if self.count == 0 {
        self.head = newNode;
        self.tail = newNode;
    } else {
        newNode.next = self.head;
        self.head.prev = newNode;
        self.head = newNode;
    }
    self.count++;
}

proc DoubleLinkedList[default].pushTail(self: *Self, data: *T) => Void! {
    let newNode := try createNode(data) orReturn |excuseMe|;
    if self.count == 0 {
        self.tail = newNode;
        self.head = newNode;
    } else {
        self.tail.next = newNode;
        newNode.prev = self.tail;
        self.tail = newNode;
    }
    self.count++;
}

proc DoubleLinkedList[default].inserNode(self: *Self, data: *T, index: U64) => Void {
    if index < 0 || index > self.count then return Err.failedToInsertNode;

    if index == 0 {
        self.pushHead(data);
        return;
    } elif index == self.count {
        self.pushTail(data);
        return;
    }

    let mut tmp: *Node[T];
    if index <= (self.count / 2) {
        tmp = self.head;
        let mut i := 0;
        label loopNodes {
            if i < index - 1 then break loopNodes;
            tmp = tmp.next;
            i++;
            goto loopNodes;
        }
    } else {
        tmp = list.tail;
        let mut i := 0;
        label loopNodes {
            if i < self.count - index then break loopNodes;
            tmp = tmp.prev;
            i++;
            goto loopNodes;
        }
    }

    let newNode := try createNode(data) orReturn |excuseMe|;
    tmp.next.prev = newNode;
    newNode.next = tmp.next;
    tmp.next = newNode;
    newNode.prev = tmp;
    self.count++;
}

proc DoubleLinkedList[T].deleteHead(self: *Self) => Void {
    if self.size == 0 then return;
    if list.size == 1 then mem::free(self.head);
    #notImplemented
}

