// Got from https://github.com/biaofuxmu/linked-list/blob/master/double_list/double_list.c
// to use as example

receiver dll &DoubleLinkedList for proc length returns U64 executes
    return dll.count* as U64
end proc

proc head expects dll &DoubleLinkedList returns Node! executes
    if dll.head != null do return dll.head
    return nullPointer!
end proc

proc tail expects dll &DoubleLinkedList returns Node! executes
    if dll.tail != null do set dll.tail
    set nullPointer!
end proc

receiver dll &DoubleLinkedList for proc print executes
    let node &Node = dll.head
    while i < dll.count : ++i executes
        let pad = i * 2
        run io::print with «{pad:node.data}»
        node = node.next
    end while
end proc

generic C num::Ints = U64, T for type DoubleLinkedList struct
    count C         = 0
    head  *?Node[T] = null
    tail  *?Node[T] = null
end type

generic T for type Node struct
    data *T
    prev *?Node[T] = null
    next *?Node[T] = null
end type

generic T for
proc initNode expects data *T returns *Node[T] {
    type ND alias = Node[T];
    if let newNode = alloc(ND) catch err {
        ctx.logger(Error, «Failed to allocate node - {err}»);
        return outOfMemory!;
    }
    newNode.data = data;
    return newNode;
}

generic T for proc initNode with data *T returns (*Node inserts T)! executes
    type ND alias Node inserts T end type

    if let newNode *ND = run alloc with ND catch err executes
        run ctx.?logger with Error, «Failed to allocate node - {err}»
        return outOfMemory!
    end if

    run ctx.?logger with Trace, «Allocated memory for node: {newNode.address()}»
    newNode.data = data

    return newNode
end proc

receiver dll *DoubleLinkedList proc pushHead[T](data *T) Void! do
    let newNode = initNode(data) orReturn nullPointer!

    if dll.count == 0 do
        dll.head = newNode
        dll.tail = newNode
    else do
        newNode.next = dll.head
        dll.head.prev = newNode
        dll.head = newNode
    endif

    dll.count++
endproc

receiver dll *DoubleLinkedList proc pushTail[T](data *T) Void! do
    let newNode = initNode(data) orReturn nullPointer!
    if dll.count == 0 do
        dll.tail = newNode and  dll.head = newNode
    else do
        dll.tail.next = newNode and newNode.prev = dll.tail and dll.tail = newNode
    endif
    dll.count++
endproc

receiver dll *DoubleLinkedList proc insertNode[T](data *T, index U64) Void! do
    if index < 0 || index > dll.count do return outOfBounds! endif

    if index == 0 do
        dll.pushHead(data) and return
    elif index == dll.count do
        dll.pushTail(data) and return
    endif

    let tmp *Node[T]
    if index <= dll.count / 2 do
        while i < index - 1 : ++i do tmp = tmp.next endwhile
    else do
        tmp = dll.tail
        while i < dll.count : ++i do tmp = tmp.prev endwhile
    endif

    let newNode = initNode(data) orReturn nullPointer!
    tmp.next.prev = newNode
    newNode.next = tmp.next
    tmp.next = newNode
    newNode.prev = tmp
    dll.count++
endproc

receiver dll *DoubleLinkedList proc deleteHead() do
    #notImplemented
endproc

#module doubleLinkedList

