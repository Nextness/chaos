// Got from https://github.com/biaofuxmu/linked-list/blob/master/double_list/double_list.c
// to use as example

#macro
proc length
    receiver dll: &DoubleLinkedList
    returns U64
executes
    #set *dll.count as U64;
end proc

#macro
proc head
    receiver dll: &DoubleLinkedList
    returns *Node!
executes
    #set (dll.head != undefined) ? dll.head : nullPointer!;
end proc

#macro
proc tail
    receiver dll: &DoubleLinkedList
    returns *Node!
executes
    #set (dll.tail != undefined) ? dll.tail : nullPointer!;
end proc


proc print
    receiver dll: &DoubleLinkedList
executes
    let node &Node = dll.head;
    while i < dll.count : ++i executes
        let pad = i * 2;
        run io::print with «{pad:node.data}»;
        node = node.next;
    end while
end proc

type DoubleLinkedList
    generic C: num::Ints = U64, T: AnyType
struct
    count: C              = 0;
    head:  *Node? using T = undefined;
    tail:  *Node? using T = undefined;
end type

type Node
    generic T: AnyType
struct
    data: *T;
    prev: *Node? using T = null;
    next: *Node? using T = null;
end type

proc initNode
    generic T: AnyType
    expects data: *T
    returns (*Node using T)!
executes
    type ND alias
        Node using T;
    end type

    if let newNode *ND = run alloc with ND catch err executes
        run ctx.logger with Erro,«Failed to allocate node - {err}»;
        return outOfMemory!
    end if

    run ctx.logger with Trace, «Allocated memory for node: {newNode.address()}»;
    newNode.data = data;
    return newNode;
end proc

proc pushHead
    generic T: AnyType
    expects data: T
    returns Void!
executes
    let newNode := run initNode with data or return nullPointer!;

    if dll.count == 0 executes
        dll.head = newNode;
        dll.tail = newNode;
    else executes
        newNode.next = dll.head;
        dll.head.prev = newNode;
        dll.head = newNode;
    end if

    dll.count++;
end proc

proc pushHead
    generic T: AnyType
    expects data: T
    returns Void!
executes
    let newNode := run initNode with data or return nullPointer!;

    if dll.count == 0 executes
        dll.tail = newNode;
        dll.head = newNode;
    else executes
        dll.tail.next = newNode;
        newNode.prev = dll.tail;
        dll.tail = newNode;
    end if

    dll.count++;
end proc

proc insetNode
    generic T: AnyType
    expects data: *T, index: U64
    returns Void!
executes
    if (index < 0 || index > dll.count) return outOfbounds!;

    if index == 0 executes
        run dll.pushHead with data;
        return;
    elif index == dll.count executes
        run dll.pushTail with data;
        return;
    end if

    let tmp: *Node using T;
    if index <= (dll.count / 2) executes
        while (i < index - 1 : ++i) tmp = tmp.next;
    else executes
        tmp = dll.tail;
        while (i < dll.count : ++i) tmp = tmp.prev;
    end if

    let newNode := run initNode with data or return nullPointer!;
    tmp.next.prev = newNode;
    newNode.next = tmp.next;
    tmp.next = newNode;
    newNode.prev = tmp;
    dll.count++;
end proc

proc deleteHead
    receiver dll: *DoubleLinkedList
executes
    #notImplemented;
end proc

#module doubleLinkedList;

