// Got from https://github.com/biaofuxmu/linked-list/blob/master/double_list/double_list.c
// to use as example

receiver dll &DoubleLinkedList inline proc length() U64 do
    set dll.count.(U64*)
endproc

inline proc head(dll &DoubleLinkedList) Node! do
    if dll.head != null do set dll.head endif
    set nullPointer!
endproc

inline proc tail(dll &DoubleLinkedList) Node! do
    if dll.tail != null do set dll.tail endif
    set nullPointer!
endproc

receiver dll &DoubleLinkedList proc print() do
    let node &Node = dll.head
    while i < dll.count : ++i do
        let pad = i * 2
        io::print(«{pad:node.data}»)
        node = node.next
    endwhile
endproc

type DoubleLinkedList[C num::Ints = U64, T] struct
    count C        = 0
    head  *?Node[T] = null
    tail  *?Node[T] = null
endtype

type Node[T] struct
    data *T
    prev *?Node[T] = null
    next *?Node[T] = null
endtype

proc initNode[T](data *T) *Node[T]! do
    type ND alias Node[T] endtype

    if let newNode *ND = alloc(ND) catch err do
        ctx.?logger(Error, «Failed to allocate node - {err}»)
        return outOfMemory!
    endif

    ctx.?logger(Trace, «Allocated memory for node: {newNode.address()}»)
    return *newNode.{data=data}
endproc

receiver dll *DoubleLinkedList proc pushHead[T](data *T) Void! do
    let newNode = initNode(data) orReturn nullPointer!

    if dll.count == 0 do
        dll.head = newNode
        dll.tail = newNode
    else do
        newNode.next = dll.head
        dll.head.prev = newNode
        dll.head = newNode
    endif

    dll.count++
endproc

receiver dll *DoubleLinkedList proc pushTail[T](data *T) Void! do
    let newNode = initNode(data) orReturn nullPointer!
    if dll.count == 0 do
        dll.tail = newNode and  dll.head = newNode
    else do
        dll.tail.next = newNode and newNode.prev = dll.tail and dll.tail = newNode
    endif
    dll.count++
endproc

receiver dll *DoubleLinkedList proc insertNode[T](data *T, index U64) Void! do
    if index < 0 || index > dll.count do return outOfBounds! endif

    if index == 0 do
        dll.pushHead(data) and return
    elif index == dll.count do
        dll.pushTail(data) and return
    endif

    let tmp *Node[T]
    if index <= dll.count / 2 do
        while i < index - 1 : ++i do tmp = tmp.next endwhile
    else do
        tmp = dll.tail
        while i < dll.count : ++i do tmp = tmp.prev endwhile
    endif

    let newNode = initNode(data) orReturn nullPointer!
    tmp.next.prev = newNode
    newNode.next = tmp.next
    tmp.next = newNode
    newNode.prev = tmp
    dll.count++
endproc

receiver dll *DoubleLinkedList proc deleteHead() do
    #notImplemented
endproc

#module doubleLinkedList

