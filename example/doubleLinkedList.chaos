// Got from https://github.com/biaofuxmu/linked-list/blob/master/double_list/double_list.c
// to use as example

module doubleLinkedList;

#overload def U64 length(&DoubleLinkedList[C, T] dll) macro {
    set @cast(*dll.count, U64);
}

#overload def Node[T]! head(&DoubleLinkedList[C, T] dll) macro {
    set *dll.head if dll.head != null else Err.nullPointer;
}

#overload def Node[T]! tail(&DoubleLinkedList[C, T] dll) macro {
    set *dll.tail if dll.tail != null else Err.nullPointer;
}

#overload def Void print(&DoubleLinkedList dll) method {
    let &Node node = *dll.head;
    for let i = 0; i < *dll.count; ++i {
        let pad = i * 2;
        printf(<<*%\n>>, pad, node.data);
        node = node.next;
    }
}

type DoubleLinkedList[num::Ints C = U64, T] struct {
    C         count = 0;
    &Node?[T] head  = null;
    &Node?[T] tail  = null;
}

type Node[T] struct {
    &T        data;
    &Node?[T] prev = null;
    &Node?[T] next = null;
}

def &Node[T]! createNode[T](data: &T) func {
    type ND alias Node[T];
    if let &ND newNode |err| = alloc(ND); catch err {
        ctx.?logger(Error, <<Failed to allocate node - reason {nani.reason()}>>);
        return Err.outOfMemory;
    }
    ctx.?logger(Trace, <<Allocated memory for node: {newNode.address()}>>);
    return &(*newNode.{data=data});
}

def Void! pushHead[T](&DoubleLinkedList dll, &T data) method {
    let newNode = try createNode(data) orReturn Err.nullPointer;
    if *dll.count == 0 {
        *dll.head=newNode;
        *dll.tail=newNode;
    } else {
        newNode.next = *dll.head;
        *dll.head.prev = newNode;
        *dll.head = newNode;
    }
    self.count++;
}

def Void! pushTail[T](&DoubleLinkedList dll, &T data) method {
    let newNode = try createNode(data) orReturn Err.nullPointer;
    if *dll.count == 0 {
        *dll.tail = newNode;
        *dll.head = newNode;
    } else {
        *dll.tail.next = newNode;
        newNode.prev = *dll.tail;
        *dll.tail = newNode;
    }
    *dll.count++;
}

def Void insertNode[T](&DoubleLinkedList dll, &T data, U64 index) method {
    if index < 0 || index > *dll.count do return Err.failedToInsertNode;

    if index == 0 {
        *dll.pushHead(data);
        return;
    } elif index == *dll.count {
        *dll.pushTail(data);
        return;
    }

    let &Node[T] tmp;
    if index <= (*dll.count / 2) {
        tmp = *dll.head;
        for let i = 0; i < index - 1; ++i {
            tmp = tmp.next;
        }
    } else {
        tmp = *dll.tail;
        for let i = 0; i < *dll.count; ++i {
            tmp = tmp.prev;
        }
    }

    let newNode = try createNode(data) orReturn Err.nullPointer;
    *tmp.next.prev = newNode;
    newNode.next = *tmp.next;
    *tmp.next = newNode;
    newNode.prev = *tmp;
    *dll.count++;
}

def Void deleteHead(&DoubleLinkedList dll) method {
    if *dll.size == 0 then return;
    if *dll.size == 1 then free(dll.head);
    #notImplemented
}

