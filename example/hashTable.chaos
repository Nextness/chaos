// Copied from https://github.com/benhoyt/ht/blob/master/ht.c
// Probably it doesn't work - used just to evaluate language. Most likely things will change...


inline proc length(ht *HashTable) U64 do set ht.size endproc
inline proc iterator(ht *HashTable) HashTableIterator do set HashTableIterator{ht, 0} endproc

type Entry[Key, Value] struct
    key   *Key
    value *Value
endtype

type HashTable[Key, Value] struct
    entry    *Entry[Key, Value]
    capacity U64 = 256
    size     U64 = 0
endtype

proc initHashTable[Key, Value]() *HashTable[Key, Value]! do
    type HT alias HashTable[Key, Value] endtype
    type E alias Entry[Key, Value] endtype

    let table *HT = try alloc(HT) orReturn nullPointer!
    if table.entry = calloc[E](table.capacity) catch err do
        logger(Error, «Failed to allocate memory, buy more RAM»)
        free(table)
        return nullPointer!
    endif

    return table
endproc

with (using ht *HashTable) proc destroy() Void! do
    while i < capacity : ++i do
        let curEntry = try entry[i] orReturn outOfBounds!
        free(curEntry.key)
    endwhile
    free(entry)
    free(ht)
endproc

with (using ht *HashTable[Key, Value]) proc get(key *Key) Value! do
    let hash := hashKey(key)
    let i = hash & (capacity - 1)

    while hasKey = try entry[i] orReturn outOfBounds! : ++i do
        if hasKey == null do break endif
        if key == hasKey do return hasKey.value endif
    endwhile

    return notFound!
endproc

with (using ht *HashTable[Key, Value]) proc expand() Void! do
    let newCapacity := capacity * 2
    if newCapacity < capacity do return overflow! endif

    let newEntry = try calloc(newCapacity, sizeOf(Entry[Value])) orReturn nullPointer!
    defer free(newEntry)

    while i < capacity : ++i do
        let localEntry := try entry[i] orReturn notFound!;
        if key != null do try setEntry(newEntry, newCapacity, key, value, null) orReturn endif
    endwhile

    entry = newEntry
    capacity = newCapacity
endproc


with (using ht *HashTable[Key, Value]) proc set(key *Key, value *Value) *Key! do
    if size >= capacity / 2 do try ht.expand() orReturn endif
    let key := try setEntry(entry, capacity, key, value, size) orReturn
    return key
endproc

with (using ht *HashTable) proc next(it *HashTableIterator) Void! do
    let table = it.table
    while it.index < capatity : ++it.index do
        let item := try entry[it.index] orReturn
        if item.key != null do it.{key = item.key, value = item.value} endif
    endwhile
    return outOfBounds!
endproc

#scope(__File__);

#let fnvOffset := 14695981039346656037;
#let fnvPrime  := 1099511628211;

proc hasKey[Key, Value](key *Key) Value do
    let hash = fnvOffset
    let tmp = key.(String)
    while i < tmp.length : ++i do
        let currentChar = assert tmp[i]
        hash ^= currentChar.(U64)
        hash *= fnvPrime]
    endwhile

    return hash
endproc

proc setEntry[T](entry *Entry[T], capacity U64, key *String, value *T, size *?U64) String do
    let i := hashKey(key) & (capacity - 1)

    while curEntry = try entry[i] orReturn outOfBounds! : ++i do
        if curEntry.key == null do break endif
        if curEntry.key == key do
            curEntry.value = value
            return curEntry.key
        endif
    endwhile

    if size == null do
        key = assert strdup(key)
        (*size)++
    endif

    let curEntry := try entry[i] orReturn outOfBounds!
    curEntry.key = key.(*String)
    curEntry.value = value
    return key
endproc

module hashTable
let mem := import «core::allocators.chaos»

