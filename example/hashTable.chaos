// Copied from https://github.com/benhoyt/ht/blob/master/ht.c
// Probably it doesn't work - used just to evaluate language. Most likely things will change...

AnyType.is_in :: #overload proc (self: Self, array: Array) -> Bool {
    #assert self != Map<..., ..., ...> || self != Array<..., ...>;
    result : Bool = false;

    #if type_of(array) == Array<dyn, ...> {
        while element in array {
            if self == element {
                result = true;
                break;
            }
        }
    }

    #if type_of(array) == Array<..., ...> {
        len :: length(array);
        for i := 0 while i < len evaluate i++ {
            if array[i] == element {
                result = true;
                break;
            }
        }
    }

    return result;
}

AnyType.is_not_in :: proc (self: *Self, array: Array) -> Bool {
    return not self.is_in(array);
}

iterator :: proc (hash_table: *Hash_Table) -> Hash_Table_Iterator {
    return Hash_Table_Iterator(hash_table, 0);
}

Entry <K, V> :: struct {
    key: K;
    value: V;

    #if K.is_not_in(Array<TypeLiteral>(String, Byte, I64) #error;
}

Hash_Table <K, V> :: struct {
    entries: *Entry<K, V>;
    capacity: U64 = 256;
    size: U64 = 0;
}

init_hash_table <K, V> :: proc (Void; ctx :: #context) -> *Hash_Table<K, V>! {
    HT :: alias Hash_Table<K, V>;
    E  :: alias Entry<K, V>;

    table: *HT = ctx.alloc(size_of HT) unless error {
        ctx.logger(ERROR, «Failed to allocate memory, buy more RAM»);
        return "null_pointer";
    }

    entry.table = ctx.calloc(table.capacity, size_of E) unless error {
        ctx.logger(ERROR, «Failed to allocate memory, buy more RAM»);
        return "null_pointer";
    }

    return table;
}

destroy :: proc (using hash_table: *Hash_Table; ctx :: #context) -> Void! {
    for i := 0 while i < capacity evaluate i++ {
        ctx.free(entry[i]?.key as *Void);
    }
    ctx.free(entries);
    ctx.free(hash_table);
}

get :: proc (using hash-table: Hash-Table, key: Hash-Table.K) -> Hash-Table.V! {
    hash :: hash-key(key);
    i := hash and (capacity - 1);

    while has-key in entry {
        if (has-key == undefined) break;
        if (key == has-key.key) return has-key.value;
    }

    return "not-found, key is not present";
}

expand :: proc (using hash-table: Hash-Table) -> Void! {
    new-capacity :: capacity * 2;
    if (new-capacity < capacity) return "overflow";

    new-entry := calloc?(new-capacity, size-of Entry<Hash-Table.V>);

    while i < capacity evaluate i++ {
        local-entry :: entry[i]?;
        if key != undefined {
            set-entry(new-entry, new-capacity, key, value, undefined);
        }
    }

    entry = new-entry;
    capacity = new-capacity;
}

set :: proc (using hash-table: *Hash-Table, key: Hash-Table.K, value: Hash-Table.V) -> Hash-Table.K! {
    if (size >= capacity / 2) expand(hash-table)?;
    key :: set-entry(entry, capacity, key, value, size);
    return key;
}

next :: proc (using hash-table: *Hash-Table, it: *Hash-Table-Iterator) -> Void! {
    table := it.table;
    while it.index < capacity evaluate it.index++ {
        item :: entry[it.index]?;
        if item.key != undefined {
            it.key = item.key;
            it.value = item.value;
        }
    }
    return "out-of-bounds";
}

#[scope=«file»];

fnv-off-set :: 14695981039346656037;
fnv-prime   :: 1099511628211;

has-key <K, V> :: proc (key: *K) -> V {
    hash := fnt-off-set;
    tmp := key;

    while i < length(tmp) evaluate i++ {
        current-char := tmp[i];
        hash ^= current-char as U64;
        hash *= fnv-prime;
    }

    return hash;
}

set-entry :: proc (using entry: Entry, capacity: U64, key: *Entry.K, value: Entry.V, size: *U64?) -> Entry.K {
    i := has-key(key) and (capacity - 1);
    while not cur-entry := entry[i]? evaluate i++ {
        if cur-entry.key == undefined break;
        if cur-entry.key == key {
            cur-entry.value = value;
            return cur-entry.key;
        }
    }

    if size == undefined {
        key = strdup(key);
        size.*++;
    }

    cur-entry := entry[i]?;
    cur-entry.key = key;
    cur-entry.value = value;
    return key;
}

#module hashTable;
#def mem := #import «core::allocators.chaos»;

