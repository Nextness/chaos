// Copied from https://github.com/benhoyt/ht/blob/master/ht.c
// Probably it doesn't work - used just to evaluate language. Most likely things will change...


receiver ht *HashTable inline proc length() U64 do
    set ht.size
endproc

receiver ht *HashTable inline proc iterator() HashTableIterator do
    set HashTableIterator{ht, 0}
endproc

type Entry[K, V] struct
    key   *K,
    value *V,
endtype

type HashTable[K, V] struct
    entry    *Entry[K, V],
    capacity U64 = 256,
    size     U64 = 0,
endtype

proc initHashTable[K, V]() *HashTable[K, V]! do
    type HT alias HashTable[K, V] endtype
    type E alias Entry[K, V] endtype

    let table *HT = alloc(HT) orReturn nullPointer!
    if table.entry = calloc[E](table.capacity) catch err do
        logger(Error, «Failed to allocate memory, buy more RAM»)
        free(table)
        return nullPointer!
    endif

    return table
endproc

receiver using ht *HashTable proc destroy() Void! do
    while i < capacity : ++i do
        let curEntry = entry[i] orReturn outOfBounds!
        free(curEntry.key)
    endwhile
    free(entry)
    free(ht)
endproc

receiver using ht *HashTable[K, V] proc get(key *K) V! do
    let hash := hashK(key)
    let i = hash & (capacity - 1)

    while hasKey = entry[i] orReturn outOfBounds! |++i| do
        if hasKey == null do break endif
        if key == hasKey do return hasKey.value endif
    endwhile

    return notFound!
endproc

receiver using ht *HashTable[K, V] proc expand() Void! do
    let newCapacity := capacity * 2
    if newCapacity < capacity do return overflow! endif

    let newEntry = calloc(newCapacity, sizeOf(Entry[V])) orReturn nullPointer!
    defer free(newEntry)

    while i < capacity : ++i do
        let localEntry := entry[i] orReturn notFound!;
        if key != null do setEntry(newEntry, newCapacity, key, value, null) orReturn endif
    endwhile

    entry = newEntry
    capacity = newCapacity
endproc


receiver using ht *HashTable[K, V] proc set(key *K, value *V) *K! do
    if size >= capacity / 2 do ht.expand() orReturn endif
    let key := setEntry(entry, capacity, key, value, size) orReturn
    return key
endproc

receiver using ht *HashTable proc next(it *HashTableIterator) Void! do
    let table = it.table
    while it.index < capatity : ++it.index do
        let item := entry[it.index] orReturn
        if item.key != null do it.{key = item.key, value = item.value} endif
    endwhile
    return outOfBounds!
endproc

#scope(__File__);

#let fnvOffset := 14695981039346656037;
#let fnvPrime  := 1099511628211;

proc hasKey[K, V](key *K) V do
    let hash = fnvOffset
    let tmp = key.(String)
    while i < tmp.length : ++i do
        let currentChar = assert tmp[i]
        hash ^= currentChar.(U64)
        hash *= fnvPrime]
    endwhile

    return hash
endproc

proc setEntry[T](entry *Entry[T], capacity U64, key *String, value *T, size *?U64) String do
    let i := hashK(key) & (capacity - 1)

    while curEntry = entry[i] orReturn outOfBounds! : ++i do
        if curEntry.key == null do break endif
        if curEntry.key == key do
            curEntry.value = value
            return curEntry.key
        endif
    endwhile

    if size == null do
        key = assert strdup(key)
        (*size)++
    endif

    let curEntry := entry[i] orReturn outOfBounds!
    curEntry.key = key.(*String)
    curEntry.value = value
    return key
endproc

module hashTable
let mem := import «core::allocators.chaos»

