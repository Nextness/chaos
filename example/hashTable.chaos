// Copied from https://github.com/benhoyt/ht/blob/master/ht.c
// Probably it doesn't work - used just to evaluate language. Most likely things will change...

proc iterator
    expects hash-table as *Hash-Table
    returns Hash-Table-Iterator
executes
    def result as Hash-Table-Iterato = new with hash-table, 0 end-new;
    return result;
end-proc

type Entry
    generic K, V
struct
    key   as *K;
    value as *V;
end-type

type Hash-Table
    generic K, V
struct
    entry    as Entry using K, V;
    capacity as U64 = 256;
    size     as U64 = 0;
end-type

proc init-hash-table
    generic K, V
    returns (*Hash-Table using K, V)!
executes
    def HT as Type = alias Hash-Table using K, V;
    def E  as Type = alias Entry sing K, V;

    def table as *HT = run? alloc with size-of HT);
    if entry.table = run calloc using E with table.capacity catch err executes
        run logger with error, «Failed to allocate memory, buy more RAM»;
        return null-pointer!;
    end-if

    return table;
end-proc

proc destroy
    expects exposed hash-table as *Hash-Table
    returns Void!
executes
    while i < capacity increment i executes
        def cur-entry = entry at? i;
        run free with cur-entry.key;
    end-while

    run free with entry;
    run free with hash-table;
end-proc

proc get
    expects exposed hash-table as Hash-Table, key as Hash-Table.K
    returns Hash-Table.V!
executes
    def hash = run hash-key with key;
    def i = hash & (capacity - 1);
    while has-key = entry at? i increment i executes
        if has-key == undefined break;
        if key == has-key.key return has-key.value;
    end-while
    return not-found!;
end-proc

proc expand
    expects exposed hash-table as *Hash-Table
    returns Void!
executes
    def new-capacity = capacity * 2;
    if new-capacity < capacity return overflow!;

    def new-entry = run? calloc with new-capacity, size-of Entry using V;
    defer run free with new-entry;

    while i < capacity increment i executes
        def local-entry = entry at? i;
        if key != undefined executes
            run? set-entry with new-entry, new-capacity, key, value, undefined;
        end-if
    end-while
    entry = new-entry;
    capacity = new-capacity;
end-proc

proc set
    expects exposed hash-table as *Hash-Table, key as Hash-Table.K, value as Hash-Table.V
    returns *Hash-Table.K!
executes
    if (size >= capacity / 2) run? expand with hash-table;
    def key = run? set-entry with entry, capacity, key, value, size;
    return key;
end-proc

proc next
    expects hash-table as *Hash-Table, it as *Hash-Table-Iterator
    returns Void!
executes
    def table = it.table;
    while it.index < capacity increment it.index executes
        def item = entry at? it.index;
        if item.key != undefined executes
            it.key = item.key;
            it.value = item.value;
        end-if
    end-while
    return out-of-bounds!;
end-proc

#[scope=«file»];

#let fnvOffset := 14695981039346656037;
#let fnvPrime  := 1099511628211;

proc hasKey
    generic K: AnyType, V: AnyType
    expects key *K
    returns V
executes
    let hash := fnvOffset;
    let tmp := key as String;
    while i < tmp.length : ++i executes
        let currenChar := assert tmp[i];
        hash ^= currentChar as U64;
        hash *= fnvPrime;
    end while
    return hash;
end proc

proc setEntry
    generic T: AnyType
    expects entry *Entry inserts T, capacity U64, key *String, value *T, size *?U64
    returns String
executes
    let i := (call hashKey with key) & (capacity - 1);
    while curEntry = entry[i] or false : ++i executes
        if curEntry.key == null executes break;
        if curEntry.key == key executes
            curEntry.value = value;
            return curEntry.key;
        end if
    end while

    if size == undefined executes
        let key = assert call strdup with key;
        (size*)++;
    end if

    let curEntry := entry[i] or return outOfBounds!;
    curEntry.key = key as String;
    curEntry.value = value;
    return key;
end proc

#module hashTable;
let mem := #import «core::allocators.chaos»;

