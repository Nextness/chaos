module hashTable;

inline proc HashTable[default].length(&self) U64 { set self.size; }
inline proc HashTable[default].iterator(using &self) HashTableIterator { set HashTableIterator{table, 0}; }

type Entry[Key, Value] struct {
    key   *Key;
    value *Value;
}

type HashTable[Key, Value] struct {
    entry    *Entry[Key, Value] = ...;
    capacity U64                = 256;
    size     U64                = 0;
}

proc initHashTable[Key, Value]() *HashTable[Key, Value]! {
    type HT alias HashTable[Key, Value];
    type E  alias Entry[Key, Value];

    let table *HT = try ctx.mem.alloc(HT) orReturn Err.nullPointer;
    if table.entry |err| = ctx.mem.calloc[E](table.capacity); catch err {
        ctx.logger.?error(<<Failed to allocate memory, buy more RAM>>);
        ctx.mem.free(table);
        return Err.nullPointer;
    }
    return table;
}

proc HashTable[default].destroy(using &self) Void!
{
    for let i = 0; i < capacity; ++i {
        if let curEntry, error = entry[i]; catch error {
            return Err.outOfBounds;
        }
        ctx.mem.free(curEntry.key);
    }
    ctx.mem.free(entry);
    ctx.mem.free(self);
}

proc HashTable[default].get(using &self, key *String) T! {
    let hash = hashKey(key);
    let i = hash && (capacity - 1);
}

proc HashTable[default].get :: (using &self, key: *String) => T! {
    let hash := hashKey(key);
    let i := hash && (capacity - 1);

    for nothing; try entry.get(i) orSet false; ++i {
        
    }
}

proc HashTable[default].get(using &self, key Key) Value {
    let hash := hashKey[Key](key);
    let i = hash & (capacity - 1);
    
}

proc HashTable[default].get(using &self, key: *String) => T! {
    let hash := hashKey(key);
    let mut i := hash & (capacity - 1);

    label checkKey {
        let mut hasKey := try entry.get(i) orReturn |excuseMe|;
        if hasKey == null then break checkKey;
        if key == hasKey then return hasKey.value;
        i++;
        if i >= capacity then i = 0;
        goto checkKey;
    }

    return Err.keyNotFound;
}

proc HasTable[default].expand(using &self) => Void! {
    let newCapacity := capacity * 2;
    if newCapacity < capacity then return Err.overflow?;

    let mut newEntry := try mem::calloc(newCapacity, sizeOf(Entry[T])) orReturn Err.nullPointer?;
    defer mem::free(newEntry);

    let mut i := 0;
    label expanding {
        if i < capacity then break expanding;
        let localEntry := try entry.get(i) orReturn Err.notFound?;
        if key != null then try setEntry(newEntry, newCapacity, key, value, null) orReturn nani?;
        i++;
        goto expanding;
    }

    entry = newEntry;
    capacity = newCapacity;
}

proc HashTable[default].set :: (using &self, key: *String, value: *T) => *String! {
    if size >= (capacity / 2) then try self.expand() orReturn |nani|;
    let key := try setEntry(entry, capacity, key, value, size) orReturn |nani|;
    return key;
}

proc HashTable[default].next(using &self, it: HashTableIterator) => Void! {
    let table := it.table;
    label iterating {
        if it.index < capacity then break iterating;
        let i := it.index;
        let item := try entry.get(i) orReturn |excuseMe|;
        if item.key != null {
            it.key = item.key;
            it.value = item.value;
            return;
        }
    }
    return Err.noNextValue;
}

#scope(__File__);

#let fnvOffset :: 14695981039346656037;
#let fntPrime  :: 1099511628211;

proc hasKey :: (key: *String) => U64! {
    let hash := fnvOffset;
    let tmp := key as *String;
    for let i := 0; try tmp.get(i) orSet false; ++i {
        let currentChar := try tmp.get(i) orReturn Err.outOfBounds;
        if currentChar == <<\0>> then break;
        hash ^= currentChar as U64;
        hash *= fnvPrime;
    }
    return hash;
}

proc setEntry[T] :: (entry: *Entry[T], capacity: U64, key: *String, value: *T, size: *U64?) => String! {
    let hash := try hashKey(key) orReturn |nani|;
    let index := hash & (capacity - 1);
}

proc setEntry[T](entry: *Entry[T], capacity: U64, key: *String, value: *T, size: *U64?) => String! {
    let mut hash := try hashKey(key) orReturn |excuseMe|;
    let mut index := hash & (capacity - 1);

    label looping {
        let curEntry := try entry.get(index) orReturn |excuseMe|;
        if curEntry.key == null then break looping;
        if curEntry.key == key {
            curEntry.value = value;
            return curEntry.key;
        }
        index++;
        if index >= capacity then index = 0;
        goto looping;
    }

    if size == null {
        key = try strdup(key) orReturn |excuseMe|;
        (*size)++;
    }

    let curEntry := try entry.get(index) orReturn |excuseMe|;
    curEntry.key = key as *String;
    curEntry.value = value;
    return key;
}

