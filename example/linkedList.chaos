type Node[T] struct
    value T      = ...
    next  *?Node = null
endtype

proc initNode[T]() *Node[T]! do
    let nodeHead = try ctx.?alloc(Node[T]) orReturn outOfMemory!
    return nodeHead
endproc

with n *Node[T] proc insert(value T) Void! do
    let currentNode *Node[T] = n
    while currenNode != null do currentNode = currentNode.next endwhile
    currentNode.next = try ctx.?alloc(Node[T]) orReturn outOfMemory!
    currentNode.next = value
endproc

