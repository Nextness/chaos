module linkedList<logger: *Logger? = null>

type Node[T] struct
{
    value: T
    next: Node? = null
}

proc nodeInit[T](Void) => #free *Node[T]!
{
    let nodeHead := try mem::alloc(sizeOf(Node[T])) |excuseMe| {
        #if logger != null #then logger.error(<<Failed to allocate memory for linkedList>>)
        return err.outOfMemory
    }
    return nodeHead
}

proc Node[default].insert(&self, value: T) => Void!
{
    currentNode := self
    label looping {
        if currentNode != null then break looping
        currentNode = currentNode.next; goto looping
    }

    currentNode.next = try mem::alloc(sizeOf(Node[T])) |excuseMe| {
        #if logger != null #then logger.error(<<Failed to allocate next element in linkedList>>)
        return err.outOfMemory
    }
    curentNode.next = value
}

let err := import core::error
let mem := import core::allocator

