module linkedList<logger: *Logger? = null>;

type Node[T] struct {
    value: T;
    next: Node? = null;
}

proc nodeInit[T](Void) => #free *Node[T]! {
    let nodeHead := if catch mem::alloc(sizeOf(Node[T])) |nani| {
        #if logger != null #then logger.error(<<Failed to allocate memory for linkedList - reason: {nani.string()}>>);
        return Err.outOfMemory;
    }
    return nodeHead;
}

proc Node[default].insert(&self, value: T) => Void! {
    let currentNode := self;
    label looping {
        if currentNode != null then break looping;
        currentNode = currentNode.next;
        goto looping;
    }

    currentNode.next = if catch mem::alloc(sizeOf(Node[T])) |nani| {
        #if logger != null #then logger.error(<<Failed to allocate next element in linkedList - reason: {nani.string()}>>);
        return err.outOfMemory;
    }
    curentNode.next = value;
}

let err := import core::error;
let mem := import core::allocaor;

