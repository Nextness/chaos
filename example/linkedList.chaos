module linkedList[logger: Literal?[Logger] = null];

type Node[T] struct
{
    value T     = ...;
    next *Node? = null;
}

proc nodeInit[T](Void) strictAllocator[*Node[T]]!
{
    if let nodeHead = ctx.mem.alloc(Node[T]); catch error {
        #if logger != null #then logger.error(<<Failed to allocate memory for linkedList - reason: {nani.string()}>>);
       return Err.outOfMemory;
    }
    return nodeHead;
}

proc Node[default].insert(&self, value: T) Void!
{
    let currentNode = self;
    for let currentNode = self; currentNode != null; currentNode = currentNode.next;

    if currentNode.next = ctx.mem.alloc(Node[T]); catch error {
        #if logger != null #then logger.error(<<Failed to allocate next element in linkedList - reason: {nani.string()}>>);
        return err.outOfMemory;
    }
    currentNode.next = value;
}

import core::error;
import core::allocator;

