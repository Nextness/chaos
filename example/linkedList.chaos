module linkedList;

type Node[T] struct {
    T      value = ...;
    &Node? next  = null;
}

def &Node[T]! nodeInit[T]() func {
    if let nodeHead = ctx.?alloc(Node[T]); catch error {
       ctx.?logger(Error, <<Failed to allocate memory for linkedList - reason: {error.string}>>);
       return Err.outOfMemory;
    }
    return nodeHead;
}

def Void! insert[T](Node[T] node, T value) method {
    let &Node?[T] currentNode = &node;
    for currenNode != null {
        currentNode = currentNode.next;
    }

    currentNode.next |error| = ctx.?alloc(Node[T]);
    if catch error {
        ctx.?logger(Error, <<Failed to allocate next element in linkedList - reason: {error.string}>>)
        return Err.outOfMemory;
    }

    currentNode.next = value;
}

import <<core::error.chaos>>;
import <<core::allocator.chaos>>;

