Node <T> :: struct {
    value: T? = undefined;
    next: *Node?<T> = undefined;
}

init-node <T> :: proc -> *Node<T>! {
    node-head := alloc(size-of Node<T>)?;
    return node-head;
}

insert :: proc (n: *Node, value: Node.T) -> Void {
    current-node := n;
    while (current-node != undefined) current-node = current-node.next;
    current-node.next = value;
}

#module linkedList;
#import «core::error.chaos»;
#import «core::allocator.chaos»;

