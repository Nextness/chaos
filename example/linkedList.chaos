struct Node[T] {
    value: T,
    next: Node? = null.
}

proc nodeInit[T]() -> *Node[T]! {
    let nodeHead := try mem.alloc(sizeOf(Node[T])) as *Node[T] |error| {
        println(i"{error}");
        return err.outOfMemory;
    };
    return nodeHead;
}

proc Node[T].insert(self: *Self, value: T) -> Nihil! {
    for currentNode := self; !currendNode:?; currentNode = currentNode.next) nothing;
    currentNode.next = try mem.alloc(sizeOf(Node[T])) as *Node[T] |error| {
        println(i"{error}");
        return err.outOfMemory;
    };
    currentNode.next = value;
}

let err := from "{default}/errors.chaos" include OutOfMemory;
let mem := from "{default}/allocator.chaos" include alloc;

