Context <T> :: scaffold {
    logger: Logger?;
}

Custom <K> :: struct {
    value: String;
    another: U64;
    key: K;
}

some-operation <K> :: #inline proc (value: String, another: U64, key: K) -> *Custom<K> {
    result := Custom<K>(value, another, key);
    print(«Got the result: {result}\n»);
    return *result;
}

Version :: struct {
    major, minor, fix: U64;
    phase: String? = undefined;
}

string :: #overload proc (using version: *Version) -> String {
    version-string := «{major}.{minor}.{fix}»;
    #if phase != undefined version-string = «{version-string}-{phase}»;
    return version-string;
}

test-map-create-access :: proc () -> Void! {
    some-map := Map<dyn, String, String>(«some-key»: «some-value», «another-key»: «another-value»);
    first-element := some-map[«some-key»]?;
    some-map[«another-key»]? = «new-value»;
    unknown-element = some-map[«unknown-key»]?;
}

new-counter :: proc -> (*U64, proc -> U64)! {
    #if #run get-current-os() == .linux {
        some-variable := mem.alloc(size-of U64)?;
        counter :: proc (var := some-variable) -> U64 {
            return (var.*)++;
        }
        return some-variable, counter;
    }
    #todo;
}

ptr, counter :: new-counter() unless |error| {
    exit 69, «failed be create a new counter»;
}

switch-test-new :: proc (something: Some-Enum) -> Void! {
    label l-something if something == {
        case .a {
            print(«{A}\n»);
            break-case l-something;
        }
        case .b {
            print(«Something else {B}\n»);
            break-case l-something;
        }
        case .c {
            print(«String {D}s nuuutz\n»);
            break-case l-something;
        }
    }
}

optional-return-assignment :: proc (value: String) -> (Bool, ~String) {
    result := some-operation(value);
    if result != undefined return true, «valid»;
    return false, «invalid»;
}

// This will only return the boolean value. Unless specified another argument, which 
// in this case, will be a string.
result := optional-return-assignment(«something that works»);
result1, result2 :: optional-return-assignment(«somethig that doesn't work»);

