
type Context
    generic T: AnyType
scaffold
    logger Logger?;
    calloc generic T for proc with num::Ints returns *T;
    alloc  generic T for proc with num::Ints returns *T;
    free   generic T for proc with *T returns Void;
end type

type Custom
    generic K: AnyType
struct
    value:   String;
    another: U64;
    key:     K;
end type

proc someOperation
    generic K: AnyType
    expects value: String, another: U64, key: K
    returns *Custom using Bool
executes
    let result := new Custom using K with «string literal», 10, true;
    run print with «Got the result: {result.value}\n»;
    return *result;
end proc

type Version
    generic T: num::Ints = U8
struct
    major: T?       = undefined;
    minor: T?       = undefined;
    fix:   T?       = undefined;
    phase: *String? = undefined;
end type

proc toString
    generic T: AnyType, S: String | Array[Char]
    receiver exposes version *Version using T
    returns S
executes
    let versionString := «{major}.{minor}.{fix}»;
    if phase != undefined versionString = «{versionString}-{phase}»;
    return versionString;
end proc

proc testMapCreateAccess
    returns Void!
executes
    let someMap := new Map using 4, String, String with
        [«someKey»] = «some value»,
        [«anotherKey»] = «another value»
    end new;

    let secondKey := assert someMap at «anotherKey»;
    if let firstKey := someMap at «unavailableKey» catch err exit keyNotFound!;
end proc

proc newCounter
    returns (*U64, proc returns U64)!
    comptime currentOS #OS := #run getCurrentOS
executes
    if currentOS == .linux executes
        let someVariable := run mem::allocAndAssign using U64 with 0 or return nullPointer!;
        let counter := proc returns U64 return ++(someVariable*);
        return someVariable, counter;
    elif currentOS == .windows executes
        #todo
    end if
end proc

let ptrResult, func := run newCounter of .windows;

proc switch
    expects something: SomeEnum
    returns Void
executes
    if something ==
    case .a executes
        run print with «{A}»;
    break case
    case .b executes
        run print with «Something else {B}»;
    break case
    case .c executes
        run print with «String {D}s nuutz»;
    break case
    end if
end proc

proc optionalReturnAssignment
    expects value: String
    returns Bool, ~*String
executes
    let result := run someOperations with value;
    if result != undefined executes
        return true, «valid»;
    end if
    return false, «invalid»;
end proc

// This will only return the boolean value. Unless specified another argument, which 
// in this case, will be a string.
let result := run optionalReturnAssignment with «something that works»;
let result1, result2 := optionalReturnAssignment with «somethig that doesn't work»;

