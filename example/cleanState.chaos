scaffold
type Context
    generic T
struct
    logger as Logger?;
end-type

type Custom
    generic K
struct
    value as String;
    another as U64;
    key as K;
end-type

proc some-operation
    generic K
    expects value as String, another as U64, key as K
    returns *Custom using Bool
executes
    def result = new Custom using K with «string literal», 10, true;
    run print with «Got the result: {result.value}\n»;
    return *result;
end-proc

type Version
    generic T
struct
    major as T? = undefined;
    minor as T? = undefined;
    fix as T? = undefined;
    phase as *String? = undefined;
end-type

proc to-string
    expects exposed version as *Version
    return String
executes
    def version-string = «{major}.{minor}.{fix}»;
    if phase != undefined versionString = «{versionString}-{phase}»;
    return version-string;
end-proc

proc test-map-create-access returns Void! executes
    def some-map = new Map using 4, String, String with
        «some-key»    = «some value»,
        «another-key» = «another value»,
    end-new;
    def first-element = some-map at «some-key»;
    some-map at «another-key» = «new value»;
    def unknown-element = some-map at? «unknown-key»;
end-proc

proc new-counter returns (*U64, proc returns U64)! executes
    #if #get-current-os == .linux #executes
        def some-variable = run? mem::alloc with size-of U64;
        def counter = proc returns U64 executes
            return ++(some-variable.*);
        end-proc
        return some-variable, counter;
    #else #executes
        #todo
    #end-if
end-proc

if def ptr-result, func = run new-counter catch err executes
    exit 69, «failed to create a new counter»;
end-if

proc switch-test
    expects something: Some-Enum
    return Void
executes
    if something ==
    case .a executes
        run print with «{A}»;
        break-case;
    case .b executes
        run print with «Something else {B}»;
        break-case;
    case .c executes
        run print with «String {D}s nuuutz»;
        break-case;
    end-if
end-proc

proc optional-return-assignment
    expects value as String
    returns Bool, ~*String
executes
    def result = run some-operation with value;
    if result != undefined executes
        return true, «valid»;
    end-if
    return false, «invalid»;
end-proc

// This will only return the boolean value. Unless specified another argument, which 
// in this case, will be a string.
def result = run optional-return-assignment with «something that works»;
def result1, result2 = run optional-return-assignment with «somethig that doesn't work»;

