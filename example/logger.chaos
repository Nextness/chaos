
type Log scaffold
    // Expected Fields for logging
    dateFormat String = «%YEAR-%MONTH-%DAY %hour-%minute-%second»,
    output Array inserts Stream = new with StdOut end new,
    incldueOSName Bool = false,
    logLevel ?EnumArray inserts U64 = undefined

    // Expected Methods for logging
    receiver *Self proc trace with message ...String returns Void end proc
    receiver *Self proc debug with message ...String returns Void end proc
    receiver *Self proc info with message ...String returns Void end proc
    receiver *Self proc warning with message ...String returns Void end proc
    receiver *Self proc error with message ...String returns Void end proc
    receiver *Self proc critical with message ...String returns Void end proc
end type

type LoggerLevel enumArray U64
    trace,
    debug,
    info,
    warning,
    error,
    critical,
    disabled,
end type

type Log builds Logger struct
    dateFormat = default,
    output = default,
    includeOSName = default,
    logLevel LoggerLevel = .info,
end type

#overload
receiver using self *Logger proc trace(message ...String) do
    #if loglevel <= .trace do
        #notImplemented(«Default trace log needs to be implemented»)
    else do
        #compiler(__optimize_out__)
    endif
end proc

#overload
receiver using self *Logger proc debug(message ...String) do
    #if loglevel <= .debug do
        #notImplemented(«Default debug log needs to be implemented»)
    else do
        #compiler(__optimize_out__)
    endif
endproc

#overload
receiver using self *Logger proc info(uessage: ...String) do
    #if loglevel <= .info do
        #notImplemented(«Default info log needs to be implemented») 
    else do
        #compiler(__optimize_out__)
    endif
endproc

#overload
receiver using self *Logger proc warnin, message ...String) do
    #if loglevel <= .warning do
        #notImplemented(«Default warning log needs to be implemented»)
    else do
        #compiler(__optimize_out__)
    endif
endproc

#overload
receiver using self *Logger proc error(message ...String) do
    #if loglevel <= .error do
        #notImplemented(«Default error log needs to be implemented»)
    else do
        #compiler(__optimize_out__)
    endif
endproc

#overload
receiver using self *Logger proc criticr, message ...String) do
    #if loglevel <= .critical do
        #notImplemented(«Default critical log needs to be implemented»)
    else do
        #compiler(__optimize_out__)
    endif
endproc

#module logger
#let io := #import «core::fmt::io.chaos»

