enum LoggerLevel as U64
{
    Trace
    Debug
    Info
    Warning
    Error
    Critical
    Disaster
}

enum SaveLogLocation as U64
{
    Cloud
    Local
}

enum DateLanguage as U64
{
    English
    Portuguese
}

interface Logger
{
    dateFormat: String = <<%YEAR-%MONTH-%DAY %hour-%minute-%second>>
    dateLanguage: DateLanguage = English
    output: FileDescriptor = StdOut
    incldueOSName: Bool = ...
    saveLogLocation: Literal[SaveLogLocation] = ...
    #if self.saveLogLocation == Cloud #then logUrl: String = ...
    #if self.saveLogLocation == Cloud #then authenticationMethod: AuthenticationMethod = ...
    #if self.saveLogLocation == Local #then dirPath: Path = ...

    proc Self.trace(&self, logMessage: Variadic[String]) => Void
    proc Self.debug(&self, logMessage: Variadic[String]) => Void
    proc Self.info(&self, logMessage: Variadic[String]) => Void
    proc Self.warning(&self, logMessage: Variadic[String]) => Void
    proc Self.error(&self, logMessage: Variadic[String]) => Void
    proc Self.critical(&self, logMessage: Variadic[String]) => Void
    proc Self.disaster(&self, logMessage: Variadic[String]) => Void
}

struct Logger.Logger {
    dateFormat: String = default;
    dateLanguage: DateLanguage = default;
    output: Output = default;
    includeOSName: Bool = false;
    saveLocation: Literal[SaveLogLocation] = LOCAL;
    dirPath: Path = <<./>>;
}

proc Logger.trace(self: *Self, log: Variadic[String]) {

}

proc Logger.debug(self: *Self, log: Variadic[String]) {

}

proc Logger.info(self: *Self, log: Variadic[String]) {

}

proc Logger.warning(self: *Self, log: Variadic[String]) {

}

proc Logger.error(self: *Self, log: Variadic[String]) {

}

proc Logger.critical(self: *Self, log: Variadic[String]) {

}


