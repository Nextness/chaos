
type Log scaffold
    // Expected Fields for logging
    dateFormat String = «%YEAR-%MONTH-%DAY %hour-%minute-%second»
    output List[dynamic, Stream] = list(StdOut)
    incldueOSName Bool = false
    logLevel enumArray U64 = ...

    // Expected Methods for logging
    proc trace(self &Self, message ...String)
    proc debug(self &Self, message ...String)
    proc info(self &Self, message ...String)
    proc warning(self &Self, message ...String)
    proc error(self &Self, message ...String)
    proc critical(self &Self, message ...String)
    proc disaster(self &Self, message ...String)
endtype

type LoggerLevel enumArray U64
    trace
    debug
    info
    warning
    error
    critical
    disabled
endtype

type Log builds Logger struct
    dateFormat = default
    output = default
    includeOSName = default
    logLevel LoggerLevel = .info
endtype

#overload
with (using self *Logger) proc trace(message ...String) do
    #if loglevel <= .trace do
        #notImplemented(«Default trace log needs to be implemented»)
    else do
        #compiler(__optimize_out__)
    endif
endproc

#overload
with (using self *Logger) proc debug(message ...String) do
    #if loglevel <= .debug do
        #notImplemented(«Default debug log needs to be implemented»)
    else do
        #compiler(__optimize_out__)
    endif
endproc

#overload
with (using self *Logger) proc info(uessage: ...String) do
    #if loglevel <= .info do
        #notImplemented(«Default info log needs to be implemented») 
    else do
        #compiler(__optimize_out__)
    endif
endproc

#overload
with (using self *Logger) proc warnin, message ...String) do
    #if loglevel <= .warning do
        #notImplemented(«Default warning log needs to be implemented»)
