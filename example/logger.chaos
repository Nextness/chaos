
type Log scaffold
    // Expected Fields for logging
    dateFormat: String = «%YEAR-%MONTH-%DAY %hour-%minute-%second»;
    output := new Array using Stream with StdOut end new;
    incldueOSName: Bool = false;
    logLevel: EnumArray? using U64 = undefined;

    // Expected Methods for logging
    proc trace receiver &Self expects message: ...String returns Void;
    proc debug receiver &Self expects message: ...String returns Void;
    proc info receiver &Self expects message: ...String returns Void;
    proc warning receiver &Self expects message: ...String returns Void;
    proc error receiver &Self expects message: ...String returns Void;
    proc critical receiver &Self expects message: ...String returns Void;
end type

type LoggerLevel enumArray
    trace: U64;
    debug;
    info;
    warning;
    error;
    critical;
    disabled;
end type

type Log
    builds Logger
struct
    dateFormat := default;
    output := default;
    includeOSName := default;
    logLevel: LoggerLevel = .info;
end type

proc trace
    receiver exposes self: &Logger
    expects message: ...String
executes
    #if loglevel <= .trace executes
        #notImplemented(«Default trace log needs to be implemented»)
    else executes
        #compiler(__optimize_out__)
    end if
end proc

