enum LoggerLevel {
    Trace: U64 = 0;
    Debug;
    Info;
    Warning;
    Error;
    Critical;
    Disaster;
}

enum SaveLogLocation {
    Cloud: U64 = 0;
    Local;
}

enum DateLanguage {
    English,
    Portuguese,
}

interface Logger {
    dateFormat: String = <<%YEAR-%MONTH-%DAY %hour-%minute-%second>>;
    dateLanguage: DateLanguage = English;
    output: FileDescriptor = StdOut;
    includeOSName: Bool = ...;
    saveLogLocation: Literal[SaveLogLocation] = ...;
    #if self.saveLogLocation == {
        #case Cloud {
            logUrl: String = ...;
            authenticationMethod: AuthenticationMethod = ...;
        } #break;
        #case Local {
            dirPath: Path = ...;
        } #break;
    }

    proc Self.trace(self: *Self, logMessage: Variadic[String]) -> Void;
    proc Self.debug(self: *Self, logMessage: Variadic[String]) -> Void;
    proc Self.info(self: *Self, logMessage: Variadic[String]) -> Void;
    proc Self.warning(self: *Self, logMessage: Variadic[String]) -> Void;
    proc Self.error(self: *Self, logMessage: Variadic[String]) -> Void;
    proc Self.critical(self: *Self, logMessage: Variadic[String]) -> Void;
    proc Self.disaster(self: *Self, logMessage: Variadic[String]) -> Void;
}

struct Logger.Logger {
    dateFormat: String = default;
    dateLanguage: DateLanguage = default;
    output: Output = default;
    includeOSName: Bool = false;
    saveLocation: Literal[SaveLogLocation] = LOCAL;
    dirPath: Path = <<./>>;
}

proc Logger.trace(self: *Self, log: Variadic[String]) {

}

proc Logger.debug(self: *Self, log: Variadic[String]) {

}

proc Logger.info(self: *Self, log: Variadic[String]) {

}

proc Logger.warning(self: *Self, log: Variadic[String]) {

}

proc Logger.error(self: *Self, log: Variadic[String]) {

}

proc Logger.critical(self: *Self, log: Variadic[String]) {

}


