Logger-Level :: enum-array {
    trace: U64;
    debug;
    info;
    warning;
    error;
    critical;
    disabled;
}

Log :: scaffold {
    date-format: String = «%YEAR-%MONTH-%DAY %hour-%minute-%second»;
    output: Array<dyn, Stream> = (STD-OUT);
    include-os-name: Bool = false;
    log-level: Enum-Array<U64>? = undefined;
}

Log.Logger :: struct {
    date-format := default;
    output := default;
    include-os-name := default;
    log-level: Logger-Level = .info;
}

log :: proc (l: Logger, log-level: Logger-Level, message: String) {
    #if log-level < l.log-level {
        #optimize-out;
    }
}

#module logger;
#let io = #import «core::fmt::io.chaos»;

