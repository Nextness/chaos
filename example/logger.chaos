
type Log scaffold
{
    // Expected Fields for logging
    dateFormat String = <<%YEAR-%MONTH-%DAY %hour-%minute-%second>>;
    output List[dynamic, Stream] = list(StdOut);
    incldueOSName Bool = false;

    // Expected Methods for logging
    method def trace(self &Self, message ...String);
    method def debug(self &Self, message ...String);
    method def info(self &Self, message ...String);
    method def warning(self &Self, message ...String);
    method def error(self &Self, message ...String);
    method def critical(self &Self, message ...String);
    method def disaster(self &Self, message ...String);
}

type LoggerLevel enumArray U64
{
    trace;
    debug;
    info;
    warning;
    error;
    critical;
    disabled;
}

type Logger build Log struct
{
    dateFormat = default;
    output = default;
    includeOSName = default;
    logLevel LoggerLevel = .info;
}

#overload method def trace(using self &Logger, message ...String)
{
    #notImplemented(<<Default trace log needs to be implemented>>) #if logLevel <= .trace #else #compiler(__optimize_out__);
}

#overload method def debug(using self &Logger, message ...String)
{
    #notImplemented(<<Default debug log needs to be implemented>>) #if logLevel <= .trace #else #compiler(__optimize_out__);
}

#overload method def info(using self &Logger, message: ...String)
{
    #notImplemented(<<Default info log needs to be implemented>>) #if logLevel <= .trace #else #compiler(__optimize_out__);
}

#overload method def warning(using self &Logger, message ...String)
{
    #notImplemented(<<Default warning log needs to be implemented>>) #if logLevel <= .trace #else #compiler(__optimize_out__);
}

#overload method def error(using self &Logger, message ...String)
{
    #notImplemented(<<Default error log needs to be implemented>>) #if logLevel <= .trace #else #compiler(__optimize_out__);
}

#overload method def critical(using self &Logger, message ...String)
{
    #notImplemented(<<Default critical log needs to be implemented>>) #if logLevel <= .trace #else #compiler(__optimize_out__);
}

module logger;
let io := import <<core::fmt::io.chaos>>;

