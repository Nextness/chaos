enum LoggerLevel {
    TRACE := "trace",
    DEBUG := "debug",
    INFO := "info",
    WARNING := "warning",
    ERROR := "error",
    CRITICAL := "critical",
    DISASTER := "disaster",

    #configuration(__Start__, 0),
    #configuration(__Step__, 1),
}

enum SaveLogLocation {
    CLOUD := "cloud",
    LOCALLY := "locally",

    #configuration(__Start__, 0b1),
    #configuration(__Step__, 0b1),
}

enum DateLanguage {
    ENGLISH,
    PORTUGUESE,
}

interface struct LoggerInterface {
    dateFormat: String = "%YEAR-%MONTH-%DAY %hour-%minutes-%seconds",
    dateLanguage: DateLanguage = .ENGLISH,
    output: Output = .STANDARD,
    includeOSName: Bool = ...,
    saveLocation: SaveLocation = ...,
    #if self.saveLocation == {
        #case .CLOUD {
            logUrl: String = ...,
            authenticationMethod: AuthenticationMethod = ...,
            logCredential: String = ...,
            #if (self.retryOnFailure) retryCount: U64 = ...,
        }
        #case .LOCAL {
            dirPath: String'Path = ...,
        }
    }
};

struct LoggerInterface::Loger {
    const dateFormat: String = default,
    const dateLanguage: DateLanguage = default,
    const output: Output = default,
    const includeOSName: Bool = false,
    const saveLocation: LogLocation = .LOCAL,
    const dirPath: String'Path = "./",
}

proc Logger.trace(self: *Self, log: Variadic[String]) -> Nihil {

}

proc Logger.debug(self: *Self, log: Variadic[String]) -> Nihil {

}

proc Logger.info(self: *Self, log: Variadic[String]) -> Nihil {

}

proc Logger.warning(self: *Self, log: Variadic[String]) -> Nihil {

}

proc Logger.error(self: *Self, log: Variadic[String]) -> Nihil {

}

proc Logger.critical(self: *Self, log: Variadic[String]) -> {

}


