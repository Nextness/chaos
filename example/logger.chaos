module logger<logLevel: Literal[LoggerLevel] = Trace>

type LoggerLevel enum U64
{
    Trace
    Debug
    Info
    Warning
    Error
    Critical
    Disaster
}

type Logger interface #exact
{
    dateFormat: String = <<%YEAR-%MONTH-%DAY %hour-%minute-%second>>
    output: List[dynamic, Stream] = {StdOut}
    incldueOSName: Bool = false

    proc trace(&self, message: Variadic[String]) => Void
    proc debug(&self, message: Variadic[String]) => Void
    proc info(&self, message: Variadic[String]) => Void
    proc warning(&self, message: Variadic[String]) => Void
    proc error(&self, message: Variadic[String]) => Void
    proc critical(&self, message: Variadic[String]) => Void
    proc disaster(&self, message: Variadic[String]) => Void
}

type Logger impl Logger struct
{
    dateFormat := default;
    output := default;
    includeOSName := false;
}

proc Logger.trace(&self, message: Variadic[String]) => Void #override
{
    #if logLevel == Trace {
        // Implementation here
    } #else {
        #compilerOptiomization(__REMOVE__)
    }
}

proc Logger.debug(&self, message: Variadic[String]) => Void #override
{
    #if logLevel == Debug {
        // Implementation here
    } #else {
        #compilerOptiomization(__REMOVE__)
    }
}

proc Logger.info(&self, message: Variadic[String]) => Void #override
{

}

proc Logger.warning(&self, message: Variadic[String]) => Void #override
{

}

proc Logger.error(&self, message: Variadic[String]) => Void #override
{

}

proc Logger.critical(&self, message: Variadic[String]) => Void #override
{

