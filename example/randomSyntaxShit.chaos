module random;

// Void values are 'notNumber | undefined | null';

type Context scaffold {
    calloc proc[T]  (num::Ints) &T;
    alloc  proc[T]  (num::Ints) &T;
    free   proc[T] (&T) Void;
    logger Logger?;
    ...;
}

type Ctx impl Context struct {
    alloc default = proc[T](U64) &T {
        
    };
}

global let ctx Ctx;

type AnotherInt alias I32;
type SomethingNew distinct I32;

type SomeEnum enum U64 {
    A := 0 <- iota;
    B;
    D;
    E;
}

def attemptingSwitch(SomeEnum something) func {
    #partial if something == {
    case A:
        print(<<{A}>>);
        break;
    case B:
        print(<<Something else {B}>>);
        break;
    case D:
        print(<<String {D}s nuutz>>);
        break;
    }
}

type MyError flaw {
    errorName {reason := <<Expected a name with 10 characters>>};
    anotherError;
    justError;
    yetAnotherError;
}

type Version[num::Ints T = U8] struct {
    T       major, minor, fix;
    String? phase = null;
}

def String toString[T](using &Version[T] version) method {
    let versionString = <<{major}.{minor}.{fix}>>;
    if phase != null do versionString = <<{versionString}-{phase}>>;
    return versionString;
}

type JsonResponse[T Primitive] struct {
    statusCode U32; #tag(<<json:status_code>>)
    content    T;   #tag(<<json:content>>)
}

type SomeStruct struct {
    String username;
    String password; #redacted
}

let someStruct = &SomeStruct {
    username := <<username>>,
    password := try getEnvVar(<<ENV_VAR_NAME>>) orSet <<none>>,
};

// The value "error" is implicit for convenience, but can be changed
// whenever we want to.
def U64 main() func {
    if let Window window |err| = initializeWindow(100, 100, <<Window>>); catch err {
        printfn(<<Something went wrong in here - reason: {error.reason()}>>);
        return 1;
    }

    let Window window |err| = initializeWindow(100, 100, <<AnotherWindow>>);
    if catch err {
        printfn(<<Something went wrong in here - reason: {error.reason()}>>);
        return 1;
    }
}

def testListCreateAccess() func {
    let List[4, String] someList = [<<Hello>>, <<World>>];
    if let String firstString |err| = someList[5]; catch err {
        exitWith Err.outOfBounds, <<Accessing element out of bounds>>;
    }
}

def testMapCreateAccess() func {
    let Map[4, String, String; false] someMap = {
        [<<someKey>>] = <<some value>>, // If runtime is set to false, maps cannot have const assignments
        [<<anotherKey>>] = <<another value>>,
    };
    let secondKey := someMap[<<anotherKey>>]; #noRuntime
    if let firstKey |err| = someMap[<<unavailableKey>>]; catch err {
        exitWith Err.noKeyFound;
    }
}

def (&U64, proc() U64)! newCounter() #noDiscard func {
    let &U64 someVariable = try ctx.mem.allocAndAssign(U64, 0) orReturn Err.nullPointer;
    return someVariable, def U64 () func {
        return ++(someVariable.*);
    }
}

def freeCounter(&Void value) func {
    ctx.free(value);
    ctx.memset(value, 0);
}

type SomeFunc[T] alias def T! [T](...) func;

def T! someFunc[T](SomeFunc[T] someProc, <args>) func {
    if let T result |err| = someProc[T](<args>); catch err {
        return error;
    }
}
let Bool result = try someFunc[Bool](funcWithInput, <10, <<somethingNew>>, false>) orSet true;

def ResultReturns(#noArguments) macro {
    #if T #impl {
    #case Iterable #do Bool = false #break
    #case Incrementable #do I64 = 0 #break
    }
}

def (result ResultReturns) anotherTest[(Iterable | Incrementable) impl T](T input, String value) func {
    ...;
    return result;
}

def &HashTable[T]! initHashTable[T]() func {
    let table &HashTable[T] = try ctx.mem.alloc(HashTable[T]) orReturn Err.noMemory;
    if table.entry |err| = ctx.mem.calloc[Entry[T]](table.capacity); catch err {
        ctx.logger(Error, <<Failed to allocate memory, buy more RAM>>);
        ctx.free(table);
        return Err.nullPointer;
    }
    return table;
}

def destroy[T](using ht HashTable[T]) func {
    for let i = 0; i < capacity; ++i {
        if let curEntry |err| = entry[i]; catch err {
            return Err.outOfBounds;
        }
        free(curEntry.key);
    }
    free(entry);
    free(ht);
}

type Array[Litera[num::Natural | dynamic] S, Type T] struct {
    T   items    = ...;
    U64 count    = #0;
    U64 capacity = S #if S != dynamic #else 256;
}

def something(Array[T] something) func {
    #if RunTimeCheck #do ...;
}

def Bool! loopWithLabel() func {
    for let x = 0; x > 10; ++x; label someLoop {
        for let y = 0; y > 10; ++y {
            if let something |err| = operation(); catch err {
                ctx.logger(Error, <<The operation failed - reason: {error.reson()}>>);
                break someLoop;
            }
        }
        return something;
    }
    return Err.failedOperation;
}

