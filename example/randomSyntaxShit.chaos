#module random

// Void values are 'notNumber | undefined | null';

type Context scaffold
    logger ?Logger
    calloc proc[T](num::Ints) &T
    alloc  proc[T](num::Ints) &T
    free   proc[T](&T) Void
endtype

type Contex builds Ctx struct
    logger = default
    alloc = proc[T](U64 size) &T do
        
    endproc
    calloc = default
    free = default
endtype

let ctx Ctx

type AnotherInt alias I32 endtype
type SomethingNew distinct I32 endtype

type SomeEnum enum U64
    a := (0 << iota)
    b
    d
    e
endtype

/** -- Explanation --
 *  Perform Sha3 using '<nameOfEnum>.<value>' and get the first 64 bits starting fromthe begining.
 *  At comp time sha3(AnotherEnum.somethingInHere) is 1cc2a66e347661378dde3fc074c46e...
 *  When we call AnotherEnum.somethingInHere we will have 482518638 [1cc2a66e3]
**/
type AnotherEnum enumUnique
    somethingInHere
    anotherThingInHere
    yetAnotherThingIsHere
endtype

let someChar Char := "a

proc attemptingSwitch(something SomeEnum) Void do
    #partial if something == do
        case a do print(«{A}»)                endcase
        case b do print(«Something else {B}») endcase
        case d do print(«String {D}s nuutz»)  endcase
    endif
endproc

type Version[T num::Ints = U8] struct
    major, minor, fix T
    phase             *?String = null
endtype

proc toString[T](using version &Version[T]) String do
    let versionString = «{major}.{minor}.{fix}»
    if phase != null do versionString = «{versionString}-{phase}» endif
    return versionString
endproc

type JsonResponse[T Primitive] struct
    statusCode U32 #tag(«json:status_code») = ...
    content    T   #tag(«json:content»)     = ...
endtype

type SomeStruct struct
    username String
    password String #redacted
endtype

let someStruct = make &SomeStruct with
    username := «username»,
    password := try getEnvVar(«ENV_VAR_NAME») orSet «none»,
endmake

// The value "error" is implicit for convenience, but can be changed
// whenever we want to.
proc main() U64 do
    if let window Window = initializeWindow(100, 100, «Window») catch err do
        printfn(«Something went wrong in here - reason: {error.reason()}»)
        return 1
    endif

    let window Window = try initializeWindow(100, 100, «AnotherWindow») orExitWith 1
endproc

proc testListCreateAccess() Void! do
    let someList = make List[4, String] with «Hello», «World» endmake
    if let firstString String = someList[5] catch err do
        exitWith outOfBounds!, «Accessing element out of bounds»
    endif
endproc

proc testMapCreateAccess() Void! do
    let someMap =
        make Map[4, String, String] with
            [«someKey»] = «some value»,
            [«anotherKey»] = «another value»,
        endmake

    let secondKey := assert someMap[«anotherKey»]
    if let firstKey = someMap[«unavailableKey»] catch err do
        exitWith noKeyFound!
    endif
endproc

proc newCounter() (*U64, proc U64)! do
    let someVariable *U64 = try mem::allocAndAssign(U64, 0) orReturn nullPointer!
    proc counter() U64 do
        return ++(someVariable*)
    endproc
    return someVariable, counter
endproc

proc freeCounter(value *Void) do
    ctx.free(value)
    ctx.memset(value, 0)
endproc

type SomeFunc[T] alias
    (proc[T](...) T! do ... endproc)
endtype

proc someFunc[T](someProc SomeFunc[T], <args>) T! do
    if let result T = someProc[T](<args>) catch err do
        return err
    endif
endproc
let result Bool = try someFunc[Bool](funcWithInput, <10, «somethingNew», false>) orSet true

inline proc ResultReturns(#noArguments) do
    if T builds do
        case Iterable do result Bool = false endcase
        case Incrementable do result I64 = 0 endcase
    endif
endproc

proc ResultReturns anotherTest[(Iterable | Incrementable) builds T](T input, String value) do
    ...
    return result
endproc

let someMap *Map[-, String, U32] := newMap()
let someArray *Array[-, String] := newArray()

proc something(Array[T] something) do
    #if RunTimeCheck do ... endif
endproc

proc loopWithLabel() Bool! do
    while x > 10 : ++x label someLoop do
        while y > 10 : ++y do
            if let something = operation() catch err do
                ctx.logger(Error, «The operation failed - reason: {err}»)
                break someLoop
            endif
        endwhile
        return something
    endwhile
    return failedOperation!
endproc

#scope(«file»)

#import «core::allocator.chaos»
#import «core::logger.chaos»
#let num := #import «core::numbers.chaos»

