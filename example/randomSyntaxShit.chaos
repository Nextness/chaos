/** -- Explanation --
 *  Perform Sha3 using '<nameOfEnum>.<value>' and get the first 64 bits starting fromthe begining.
 *  At comp time sha3(AnotherEnum.somethingInHere) is 1cc2a66e347661378dde3fc074c46e...
 *  When we call AnotherEnum.somethingInHere we will have 482518638 [1cc2a66e3]
**/
Another_Enum :: enum {
    SOMETHING_IN_HERE : #unique = iota;
    ANOTHER_THING_HERE;
    YET_ANOTHER_THING_IS_HERE;
}

Json_Response <T> :: struct {
    status_code: U32? = undefined; #tag «json:status_code»
    content: T? = undefined;       #tag «json:content»
}

Json_Response.something_crazy :: proc (self: *Self, status-code: U32) -> Void! {
    self.status-code = status-code;
}

response := Json_Response(...)?;
result :: response.something_crazy() unless error {
    exit 1;
}

Some_Struct :: struct {
    username: String;
    password: String; #redacted
}

some_struct := #global Some_Struct(
    username = «username»,
    password = get_env_var(«ENV_VAR_NAME», «None»),
);

main :: #entry proc (Void) -> U64 {
    window := initialize_with(100, 100, «Window») unless error {
        print(«Something went wrong in here - {error}»);
        return 1;
    }
}

loop_with_label :: proc (Void) -> Bool! {
    while x > 10 evaluate x++ label loop {
        while y > 10 evaluate y++ {
            operation() unless error {
                logger(ERROR, «The operation failed - reason: {error.reason}»);
                break loop;
            }
        }
        return something;
    }
    return "operation-failed, Because you suck!";
}

#scope = «file»;

#module random;
#import «core::allocator.chaos»;
#import «core::logger.chaos»;
num :: #import «core::numbers.chaos»;

