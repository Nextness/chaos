#module random

// Void values are 'nan | undefined | null';

type Context scaffold
    logger ?Logger,
    calloc generic T in proc with num::Ints returns *T end proc,
    alloc  generic T in proc with num::Ints returns *T end proc,
    free   generic T in proc with &T returns Void end proc,
end type

type Contex builds Ctx struct
    logger = default,
    alloc = generic T in proc with size U64 returns *T do
    end proc,
end type

let ctx Ctx

type AnotherInt alias I32 end type
type SomethingNew distinct I32 end type

type SomeEnum enum U64
    a := (0 << iota),
    b,
    d,
    e,
end type

/** -- Explanation --
 *  Perform Sha3 using '<nameOfEnum>.<value>' and get the first 64 bits starting fromthe begining.
 *  At comp time sha3(AnotherEnum.somethingInHere) is 1cc2a66e347661378dde3fc074c46e...
 *  When we call AnotherEnum.somethingInHere we will have 482518638 [1cc2a66e3]
**/
type AnotherEnum enumUnique
    somethingInHere,
    anotherThingInHere,
    yetAnotherThingIsHere,
end type

let someChar Char := "a

proc attemptingSwitch with something SomeEnum returns Void do
    #partial if something == do
        case a do call print with «{A}» end case
        case b do call print with «Something else {B}» end case
        case c do call print with «String {D}s nuutz» end case
    end if
end proc

generic T num::Ints = U8 in type Version struct
    major ?T       = undefined,
    minor ?T       = undefined,
    fix   ?T       = undefined,
    phase *?String = null,
end type

generic T in proc toString with using version &Version inserts T returns String do
    let versionString = «{major}.{minor}.{fix}»
    if phase != null do versionString = «{versionString}-{phase}» end if
    return versionString
end proc

generic T Primitive in type JsonResponse struct
    #tag(«json:status_code») statusCode U32 = undefined,
    #tag(«json:content»)     content    T        = undefined,
end type

type SomeStruct struct
    username String,
    password String #redacted,
end type

let someStruct = new &SomeStruct with
    username := «username»,
    password := getEnvVar(«ENV_VAR_NAME») or set «none»,
end new

// The value "error" is implicit for convenience, but can be changed
// whenever we want to.
proc main returns U64 do
    if let window Window = call initializeWindow with 100, 100, «Window» catch err do
        call printfn with «Something went wrong in here - reason: {error.reason()}»
        return 1
    end if

    let window Window = call initializeWindow with 100, 100, «AnotherWindow» or exitWith 1
end proc

proc testListCreateAcces returns Void! do
    let someList = new Array inserts String with «Hello», «World» end new
    if let firstString String = someList[5] catch err do
        exitWith outOfBounds!, «Accessing element out of bounds»
    end if
end proc

proc testMapCreateAcces returns Void! do
    let someMap = new Map inserts 4, String, String with
        [«someKey»] = «some value»,
        [«anotherKey»] = «another value»,
    end new

    if secondKey := assert someMap[«anotherKey»]
    if let firstKey = someMap[«unavailableKey»] catch err do
        exitWith keyNotFound!
    end if
end proc

type #OS enumUnique
    linux,
    windows,
end type

proc newCounter
    returns (*U64, proc returns U64)!
    comptime currentOS #OS := #call getCurrentOS
do
    // TODO: fix highlight in #if
    if currentOS == .linux do
        let someVariable *U64 = call mem::allocAndAssign with U64, 0 or return nullPointer!
        proc counter returns U64 do
            return ++(someVariable*)
        end proc
        return someVariable, counter
    elif currentOS == .windows do
        // TODO: not implemented yet
    endif
end proc

let ptrResult, func := call newCounter at .windows

proc freeCounter with value *Void do
    call ctx.free with value
    call ctx.memset with value, 0
endproc

type (SomeFunc inserts T) alias (generic T in proc with ... returns T!) end type

generic T in
proc someFunction
    with someProc SomeFunc inserts T, <args>
    returns T!
do
    if let result T = call someProc inserts T with <args> catch err do
        return err
    end if
    return result
end proc
let result Bool = call someFunction
    inserts Bool
    with funcWithInput, <10, «somethingNew», false>
    or return true

if something do call theOperation end if

proc ResultReturns with #noArguments do
    if T builds do
    case Iterable do result Bool = false end case
    case Incrementable do result I64 = 0 end case
    end if
end proc

generic T builds Iterable | Incrementable in
proc anotherTest with input T, value String returns ResultReturns do
    ...
    return result
end proc

proc loopWithLabel return Bool! executes
    while x > 10 : ++x label loop executes
        while y > 10 : ++y executes
            if let something = run operation; catch something executes
                run ctx.logger with Error, «The operation failed - reason: {something}»;
                break loop;
            end if
        end while
        return something;
    end while
    return operationFailed!;
end proc

proc loopWithLabel returns Bool! do
    while x > 10 : ++x label someLoop do
        while y > 10 : ++y do
            if let something = call operation catch err do
                call ctx.logger with Error, «The operation failed - reason: {err}»
                break someLoop
            end if
        end while
        return something
    end while
    return operationFailed!
end proc

proc coroutineInChaosExample with something String returns Bool do

end proc

if let result := async run coroutineInChaosExample with «something» catch err do
    // failed for some reason
end if

#scope(«file»)

