#module random

/** -- Explanation --
 *  Perform Sha3 using '<nameOfEnum>.<value>' and get the first 64 bits starting fromthe begining.
 *  At comp time sha3(AnotherEnum.somethingInHere) is 1cc2a66e347661378dde3fc074c46e...
 *  When we call AnotherEnum.somethingInHere we will have 482518638 [1cc2a66e3]
**/
type AnotherEnum enum
    somethingInHere: #unique = iota;
    anotherThingInHere;
    yetAnotherThingIsHere;
end type

proc some-function
    expects input1 as &String
    returns Void!
executes

end-proc

type Json-Response
    generic T
struct
    status-code as U32? = undefined; #tag «json:status_code»
    content as T? = undefined;  #tag «json:content»
end-type

type Some-Struct struct
    username as String;
    password as String; #redacted
end-type

def some-struct = new *Some-Struct with
    username = «username»,
    password = (run get-env-var with «ENV_VAR_NAME», «None»),
end-new;

proc main returns U64 executes
    if def window as Window = run initialize-window with 100, 100, «Window» catch-into err executes
        run print-fn with  «Something went wrong in here - reason: {err}»;
        return 1;
    end-if

    window = run? initialize-window with 100, 100, «AnotherWindow»;
end-proc

proc loop-with-label returns Bool1 executes
    while x > 10 evaluate x += 1 label loop executes
        while y > 10 evaluate y += 1 executes
            if def something = run operation catch-into err executes
                run logger with error, «The operation failed - reason: {err}»;
                break loop;
            end-if
        end-while
        return something;
    end-while
    return operation-failed!;
end-proc

def any-error as Any-Error? = #0;
if run operation with input catch-into any-error executes

end-if

proc testing-while-loops executes
    while i < 1 evaluate i = run? some-operation with some-input executes
        
    end-while
end-proc

#scope(«file»);

#import «core::allocator.chaos»;
#import «core::logger.chaos»;
#let num := #import «core::numbers.chaos»;

