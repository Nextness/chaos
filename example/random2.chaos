module random;

// Void values are 'notANumber | undefined | null';

type Context scaffold {
    calloc proc[T]  (num::Ints) &T;
    alloc  proc[T]  (num::Ints) &T;
    free   proc[T] (&T) Void;
    logger Logger?;
    ...;
}

type Ctx impl Context struct {
    alloc default = proc[T](U64) &T {
        
    };
}

global let ctx Ctx;

type AnotherInt alias I32;
type SomethingNew distinct I32;

type SomeEnum enum U64 {
    A := 1 <- iota;
    B;
    D;
    E;
}

proc attemptingSwitch(something SomeEnum) {
    #partial if something == {
    case A do print(<<{A}>>); break;
    case B do print(<<Something else {B}>>); break;
    case D do print(<<String {D}s nuutz>>); break;
    }
}

type MyError flaw {
    errorName {reason := <<Expected a name with 10 characters>>};
    anotherError;
    justError;
    yetAnotherError;
}

type Version[T num::Ints = U8] struct {
    major, minor, fix T;
    phase             String? = null;
}

proc toString[T](using version Version[T]) String {
    let versionString = <<{major}.{minor}.{fix}>>;
    if phase != null do versionString = <<{versionString}-{phase}>>;
    return versionString;
}

type JsonResponse[T Primitive] struct {
    statusCode U32; #tag(<<json:status_code>>)
    content    T;   #tag(<<json:content>>)
}

type SomeStruct struct {
    username String;
    password String; #redacted
}

let someStruct = &SomeStruct {
    username := <<username>>,
    password := try getEnvVar(<<ENV_VAR_NAME>>) orSet <<none>>,
};

// The value "error" is implicit for convenience, but can be changed
// whenever we want to.
proc main() U64 {
    if let window Window |err| = initializeWindow(100, 100, <<Window>>); catch err {
        printfn(<<Something went wrong in here - reason: {error.reason()}>>);
        return 1;
    }

    let window Window |err| = initializeWindow(100, 100, <<AnotherWindow>>);
    if catch err {
        printfn(<<Something went wrong in here - reason: {error.reason()}>>);
        return 1;
    }
}

proc testListCreateAccess() {
    let someList List[4, String] = [<<Hello>>, <<World>>];
    if let firstString String |err| = someList[5]; catch err {
        exitWith Err.outOfBounds, <<Accessing element out of bounds>>;
    }
}

proc testMapCreateAccess() {
    let someMap Map[4, String, String; false] = {
        [<<someKey>>] = <<some value>>, // If runtime is set to false, maps cannot have cont assignments
        [<<anotherKey>>] = <<another value>>,
    };
    let secondKey := someMap[<<anotherKey>>]; #noRuntime
    if let firstKey |err| = someMap[<<unavailableKey>>]; catch err {
        exitWith Err.noKeyFound;
    }
}

proc newCounter() (&U64, proc() U64)! #noDiscard {
    let someVariable = try ctx.mem.allocAndAssign(U64, 0) orReturn Err.nullPointer;
    return someVariable, proc() U64 {
        return ++(someVariable.*);
    }
}

proc freeCounter(value *Void) {
    ctx.free(value);
    ctx.memset(value, 0);
}

type SomeFunc[T] alias proc[T](...) T!;

proc someFunc[T](someProc SomeFunc[T], <args>) T! {
    if let result T |err| = someProc[T](<args>); catch err {
        return error;
    }
}
let result Bool = try someFunc[Bool](funcWithInput, <10, <<somethingNew>>, false>) orSet true;

inline proc ResultReturns(#noArguments) {
    #if T #impl {
    #case Iterable #do Bool = false #break
    #case Incrementable #do I64 = 0 #break
    }
}

proc anotherTest[T impl Iterable | Incrementable](input T, value String) (result ResultReturns) {
    ...;
    return result;
}

proc initHashTable[T]() &HashTable[T]! {
    let table &HashTable[T] = try ctx.mem.alloc(HashTable[T]) orReturn Err.noMemory;
    if table.entry |err| = ctx.mem.calloc[Entry[T]](table.capacity); catch err {
        ctx.logger(Error, <<Failed to allocate memory, buy more RAM>>);
        ctx.free(table);
        return Err.nullPointer;
    }
    return table;
}

proc destroy[T](using ht HashTable[T]) {
    for let i = 0; i < capacity; ++i {
        if let curEntry |err| = entry[i]; catch err {
            return Err.outOfBounds;
        }
        free(curEntry.key);
    }
    free(entry);
    free(ht);
}

type Array[S Literal[num::Natural | dynamic], T Type] struct {
    items    T   = ...;
    count    U64 = #0;
    capacity U64 = S #if S != dynamic #else 256;
}

proc Array[default].something() {
    #if RunTimeCheck #do ...;
}

proc loopWithLabel() Bool! {
    for let x = 0; x > 10; ++x; label someLoop {
        for let y = 0; y > 10; ++y {
            if let something |err| = operation(); catch err {
                ctx.logger(Error, <<The operation failed - reason: {error.reson()}>>);
                break someLoop;
            }
        }
        return something;
    }
    return Err.failedOperation;
}

let new = &NewStruct{};

