test firstTestSuite with tearUp: TearUp, tearDown: TearDown executes

    proc firstTestName with t: &UnitTest executes
        let something := run someConditionMustHappen with «abc»
        assert something, «Expected something to have a value, but it doesn't...»
    end proc

    proc secondTestName with t &UnitTest executes
        if let somethingElse := run someConditionMustHappen «ab» catch error executes
            assert error && «Expected an error, but found nothing»
        end if
    end proc

end test

