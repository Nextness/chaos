first-test-suite :: test (tear-up: Tear-Up, tear-down: Tear-Down) {
    first-test-name :: proc (t: *Unit-Test) {
        something :: some-condition-must-happen(«abc»);
        assert something, «Expected something to have a value, but it doesn't...»;
    }

    second-test-name :: proc (t: *Unit-Test) {
        if not [error, reason] from some-condition-must-happen(«ab») {
            assert false, «Expected an error, but found nothing»;
        }
    }
}
