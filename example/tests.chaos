test firstTestSuite(tearUp TearUp, tearDown TearDown) do
    proc firstTestName(t &UnitTest) do
        let something := someConditionMustHappen(«abc»)
        assert something && «Expected something to have a value, but it doesn't...»
    endproc

    proc secondTestName(t &UnitTest) do
        if let somethingElse |error| := someConditionMustHappen(«ab»); catch error do
            assert error && «Expected an error, but found nothing»
        endif
    endproc
endtest

