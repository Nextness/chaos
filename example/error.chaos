interface Err {
    name: String,
    description: String?,
}

struct Err.Error {
    name: String = default,
    description: String? = default,
    libName: String? = null,
    mut stack: Error? = null,
    mut context: String? = null,
}

macro Error.string(using self: *Self) -> String {
    let mut errorFmt := "";
    if (!libName?) errorFmt = i"[{libName}]";
    if (!description?) errorFmt = i"{errorFmt}: {description}";
    if (!context?) errorFmt = i"{errorFmt}\n{context}";
    if (!stack?) errorFmt = i"{errorFmt}\n{stack}";
    set errorFmt;
}

let outOfMemory: Error = {
    "outOfMemory",
    "Your computer seems to be out of memory. Buy more RAM, lol!"
};

let nullPointer: Error = {
    "nullPointer",
    "Null pointer, do better..."
};

let zeroValue: Error = {
    "zeroValue",
    "Provided 0 valued parameters, but expected something else..."
};

let overflowValue: Error = {
    "overflowValue",
    "The value overflow."
};

