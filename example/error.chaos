#interface #struct ErrorInterface {
    name: String = ...,
    description: String? = ...,
}

#struct ErrorInterface::Error {
    name: String = default,
    description: String? = default,
    libName: String? = null,
    stack: *Error? = null,
}

proc Error.__String__(using self: *Self) -> String {
    let errorFmt := "";
    libName!? errorFmt = i"[{libName}] {errorFmt}";
    description!? errorFmt = i"{errorFmt}: {description}";
    stack!? errorFmt = i"{errorFmt}\n{stack}";
    return errorFmt;
}

#let #const {
    outOfMemory: Const[err.Error] = {
        name="outOfMemory",
        description="Your computer seems to be out of memory. Buy more RAM, lol!"
    };
    nullPointer: Const[err.Error] = {
        name="nullPointer",
        description="Null pointer, do better..."
    };
    zeroValue: Const[err.Error] = {
        name="zeroValue",
        description="Provided 0 valued parameters, but expected something else..."
    };
    overflowValue: Const[err.Error] = {
        name="overflowValue",
        description="The value overflow."
    };
};

