module errors;

inline proc AnyFlaw.string(&self) String then set #literalName(self);
inline proc AnyFlaw.reason(&self) String then set self.reason;

type Error flaw {
    nullPointer;
    outOfMemory;
    outOfBounds;
    somethingElse;
}

proc main() {
    let error AnyFlaw = Error.nullPointer{<<You suck and need more RAM, lol!>>};
    printfn(<<The error is "{error.string()}" - reason: "{error.reason()}">>);
    return;
}

import core::fmt::io;

