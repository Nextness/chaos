module errors;

interface Err
{
    name: String;
    description: String? = null;
    proc Self.string(self: *Self) -> String;
}

struct Err.Error
{
    name: String = default;
    description: String? = default;
    libName: String? = null;
    mut stack: Error? = null;
    mut context: String? = null;
}

proc Error.string(using self: *Self) -> String
{
    let mut @free errorFmt: sb::StringBuilder = sb::allocStringBuilder();
    defer sb::freeStringBuilder(errorFmt);

    libName ?: errorFmt.sb::append(<<[{libName}]>>);
    description ?: errorFmt.sb::append(<<: {description}>>);
    context ?: errorFmt.sb::append(<<\n{context}>>);
    stack ?: errorFmt.sb::append(<<\n{stack}>>);

    return errorFmt.sb::string();
}

enum CoreError {
    OutOfMemory: Err = {
        <<outOfMemory>>, <<Your computer seems to be out of memory. Buy more RAM, lol!>>
    };
    NullPointer := {
        <<nullPointer>>, <<Null pointer, do better...>>
    };
    ZeroValue := {
        <<zeroValue>>, <<Provided 0 valued parameters, but expected something else...>>
    };
    OverflowValue := {
        <<overflowValue>>, <<The value overflow.>>
    };
}

#scope(__file__);

let sb := import <<core:stringBuilder>>;

