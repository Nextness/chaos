module errors

interface Err
{
    name: String
    description: String? = null
    proc Self.string(&self) => String
}

struct Err.Error
{
    name: String = default
    description: String? = default
    mut context: String? = null
}

proc Error.string(using &self) => String
{
    let mut errorFmt: sb::StringBuilder = sb::AllocStringBuilder()
    defer sb::freeStringBuilder(errorFmt)

    if libName != null then errorFmt.sb::append(<<[{libname}]>>)
    if description != null then errorFmt.sb::append(<<: {description}>>)
    if context != null then errorFmt.sb::append(<<\n{context}>>)

    return errorFmt.sb::string()
}

error CoreError
{
    outOfMemory = {
        name = <<outOfMemory>>,
        description = <<Your computer seems to be out of memory. Buy more RAM, lol!>>
    }
    nullPointer = {
        name = <<nullPointer>>,
        description = <<Null pointer, do better...>>
    }
}

#scope(__file__);

let sb := import core::stringBuilder

