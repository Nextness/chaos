    mut currentDate: U64 = ...,
    mut currentTime: U64 = ...,
    local $$specification := {
        Seconds, Minutes, Hours, Days, Months, Years
    },
}

proc Time.now(self: *Self) -> String {
    return "";
}

let time: Time(Seconds) = {#0};
proc acceptsTime(time: Time(Seconds)) -> String {
    return time.string();
}

macro List[default].get(self: *Self, position) -> T! {
    if (self.length < position) set err.outOfBounds;
    set #unsafe $$get(self, position);
}

macro List[default].insert(mut self: *Self, position: U64, value: T) -> Nihil! {
    if (self.length < position) set err.outOfBounds;
    #unsafe $$insert(self, position, value);
}

