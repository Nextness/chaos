type JsonResponse[T: types::Primitive] struct {
    `json:<<status_code>>` statusCode: U32 = ...;
    `json:<<content>>` content: T = ...;
}

macro Literal[T] then return $$Literal[T];

type Array[S: Literal[num::Natural | dynamic], T: Type] struct {
    items: T = ...;
    count: U64 = #0;
    capacity: U64 = S #if (S != dynamic) #else 256;
}

proc checkFirstElementExists(mut element: Array[dynamic, ___]?) -> Bool! {
    if element != null then element = Array[dynamic, String](#0);
    --- Checks for the size of the array, if the accessing index is greater,
    --- raises and nullpointer error or something like this.
    let some := if catch element.get(0) |excuseMe| {
        fmt::eprintf(<<Failed to get first element - reason: {excuseMe.string()}>>);
        return false;
    }
    return true;
}

