macro NamedContext[T] {
    $$NamedContext[T]
}

let context: NamedContext[proc(...) -> (...) | macro(...) -> (...)] = {
    macro drawUI(callback: *proc(Nihil) -> Nihil) {
        rl.beginDrawing();
        rl.clearBackground(rl.rayWhite);
        callback();
        rl.endDrawing();
    }
}


macro gameNextSecond(timeFrame: *F64, callback: proc(Nihil) -> Nihil) {
    if (*timeFrame += rl.getFrameTime()) >= 1.0f {
        callback();
        *timeFrame = 0.0f;
    }
}

#let frameRate := 60;
proc main() -> U64 {
    let timeFrame: F64 = 0.0f;
    let swordAxe: String = "10";
    let axeValue: String = "10";
    let swordExperience: String = "100";

    rl.setTargetFPS(frameRate);
    while !rl.windowShouldClose() {
        rpg.gameNextSecond(&timeFrame, *proc() {
            swordProgress += 2;
            gmp.mpzAddUI(skills.swordFighting.currentLevel, skills.swordFighting.currentLevel, 1);
            swordValue = gmp.mpzGetStr(null, 10, skills.swordFighting.currentLevel);
            gmp.mpzAddUI(skills.axeFighting.currentLevel, skills.axeFighting.currentLevel, 1);
            axeValue = gmp.mpzGetStr(null, 10, skills.axeFighting.currentLevel);
        });

        rpg.context.drawUI(*proc() {
            let formattedText := rl.textFormat("%s %s", skills.swordFighting.name, swordValue);
            rl.drawText(formattedText, 200, 80, 20, rl.black);
            rl.drawRectangle(200, 120, 200, 20, rl.lightGray);
            formattedText = rl.textFormat("%s %s", skills.axeFighting.name, axeValue);
            rl.drawText(formattedText, 200, 160, 20, rl.black);
            rl.drawRectangle(200, 120, swordProgress, 20, rl.darkGreen);
        });
    }
    rl.closeWindow();
}

proc main() -> U32 {
    with openedFile: List[dynamic, String] = try openFile("./somepah", "r") {
        for (line in openedFile.readline()) printf("%s\n", line);
    } orReturn err.fileNotFound;

    with openedFile := try openFile("./somepath", "r") {
        for line in openedFile.readline() {
            println("%s\n", line);
        }
    } |error| {
        case err.invalidPath {
            println(i"error while loading file: {error}");
        }
        case default {
            println(i"error while loading file: {error}");
            return err.fileNotFound;
        }
    };
    return 0;
}

