module random;

struct Version {
    major: U32     = ...,
    minor: U32     = ...,
    fix:   U32     = ...,
    phase: String? = null,
}

proc Version.string(using self: *Self) -> String {
    let versionString := i"{major}.{minor}.{fix}";
    if (!phase:?) versionString = i"{versionString}-{phase}";
    return versionString;
}

{
    proc somethingElseNow(string: *String, newValue: *String) -> err.nullPointer {
        if (!string || !newValue) return err.nullPointer;
        defer mem.free(newValue);
        string = i"{*string} {newValue}";
        println(*string);
    }

    let stillExists := "hello world";
    let noLongerExists := "how are you?";
    somethingElseNow(&stillExists, &noLongerExists);

    struct SomeStruct {
        username: String = ...,
        password: #redacted String = ...
    }
    let someStruct := &SomeStruct {
        username="username",
        password=getEnvVar("ENV_VAR_NAME")
    };
}

proc testingNullable(input1: Bool?) -> Bool! {
    if (!input1:?) return err.nullPointer;
    return true;
}

