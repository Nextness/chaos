macro NamedContext[T] {
    $$NamedContext[T]
}

let context: NamedContext[proc(...) -> (...) | macro(...) -> (...)] = {
    macro drawUI(callback: *proc(Void) -> Void) {
        rl.beginDrawing()
        rl.clearBackground(rl.rayWhite)
        callback()
        rl.endDrawing()
    }
}


macro gameNextSecond(timeFrame: *F64, callback: proc(Void) -> Void) {
    if (*timeFrame += rl.getFrameTime()) >= 1.0f {
        callback()
        *timeFrame = 0.0f
    }
}

proc main() -> U32
{
    let openedFile: List[dynamic, String] = try open(<<./somepath/file.ext>>, <<r>>) |err| {
        logger.error(<<Error while loading file - reason: {err.string()}>>);
        return 1;
    };
    defer close(openedFile);

    label handlingFileContent {
        let lineContent := try openedFile.readline() |err| {
            logger.error(<<Failed to parse line - reason: {err.string()}>>);
            return 1;
        }
        if lineContent.hasEnded() then break handlingFileContent;
        print(<<{lineContent}>>);
        goto handlingFileContent;
    }

    return 0;
}

