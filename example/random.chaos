proc attemptingSwitch(something: some::Enum) => Void {
    #extensive if something == {
        case A then fmt.print(<<{A}>>);
        case B then fmt.print(<<Something else {B}>>);
        case D then fmt.print(<<String {D}s nuutz>>);
    }
}

