proc tryingShitOut(input: StringBuilder) => Void! {
    label loopString {
        currentChar := if catch input.get() |nani| {
            logger.error(<<Failed to get character>>);
            return nani;
        }
        if currentChar == <<\0>> then break loopString;
        if catch doSomeOperation(currentChar) |nani| {
            logger.error(<<Failed to do some operation>>);
            return nani;
        }
        goto loopString;
    }
}


