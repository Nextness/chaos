proc multiple_returns :: (toggle: Bool) => (String, U32)! {
    inline let result := if toggle then Err.null_pointer! else (<<h>>, 10);
    return result;
}

proc multipleReturns :: (toggle: Bool) => (String, U32)! {
    return Err.nullPointer if toggle else <<h>>, 10;
}

