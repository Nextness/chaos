type Array[S: Literal[num::Natural | dynamic], T: Type] struct
{
    items: T = ...
    count: U64 = #0
    capacity: U64 = S #if (S != dynamic) #else 256
}

proc checkFirstElementExists(mut element: Array[dynamic, ___]?) -> Bool!
{
    if (!element.?) element = Array[dynamic, String]{#0}
    --- Checks for the size of the array, if the accessing index is greater,
    --- raises and nullpointer error or something like this.
    let some := try element.get(0) orSet <<>>
    return true
}

