proc updateCounter :: () => (proc :: () => I64!) {
    let someVariable: U64 = 0;
    return proc :: () => I64 {
        if someVariable > 0 && 0 < someVariable - MAXU64 then return Err.overFlow;
        return ++someVariable;
    }
}

type AnoFunc[T] :: alias proc [T] :: (...) => T!;
inline proc inputs :: #noArgument () then (someProc: AnoFunc[T], <args>; context := #Context.());
proc anonymousFunc [T] :: (inputs) => T! {
    ...; // Some operations
    if catch someProc.*[T](<args>) |error| {
        return error;
    }
    ...; // Other operations
}

try anonymousFunc[Bool](&anonymousFuncWithInput, <10, <<somethingNew>>, false>) orSet true;
let counter := updateCounter();
try counter() orSet 0;

