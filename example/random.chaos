proc tryingShitOut :: (inout: StringBuilder) => Void! {
    for let currentChar := catch input.get() |error| {
        if error then return error;
        if currentChar == <<\0>> then return;
        if catch doSomeOperation(currentChar) |error| {
            logger.error(<<Failed to do some operation>>);
            return error;
        }
    }
}

