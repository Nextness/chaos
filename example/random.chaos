#entensive
enum Enum: U64 {
    A = 1,
    B,
    D,
}

struct EnumMap[E: enum, T: Type] {
    mut map: Map[E, T],
}

proc attemptingSwitch(something: some.Enum) {
    if something == {
        case (A) fmt.print(i"{A}");
        case (B) fmt.print(i"Something else {B}");
        case (D) fmt.print(i"String {D}s nuutz");
    }
}

let allocation: *Hello = try mem.alloc(sizeOf(Hello)) orReturn |error|;

try mem.alloc[*Hello](sizeOf(Hello)) |error| return error;
try mem.alloc(sizeOf(Hello)) as *Hello |error| {
    return err.nullPointer;
};

