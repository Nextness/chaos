// interface with no input names
interface proc someNameForProc1(U32, U64, F64 = 10) -> Bool | ___ { ... }

// interface with input names
interface proc someNameForProc2(in1: U32, in2: U64, in3: F64 = 100) -> Bool | ___ { ... }

// Exact match interface
#exact interface proc someNameForProc3(in1: U32, in2: U64, in3: F64 = 100) -> Bool | ___ { ... }

struct Version {
    major, minor, fix: U32,
    phase: String? = null,
}

proc Version.__String__(using self: *Self) -> String {
    if !major || !minor || !fix {
        exitWith 1, "Missing major, minor or fix field in the struct...";
    }
    let versionString := i"{major}.{minor}.{fix}";
    phase :? versionString = i"{versionString}-{phase}";
    return versionString;
}

{
    proc somethingElseNow(#gainOwnership string: *String, #loseOwnership newValue: *String) -> error.nullPointer {
        if (!string || !newValue) return error.nullPointer;
        defer free(newValue);
        string = i"{*string} {newValue}";
        println(*string);
    }

    let stillExists := "hello world";
    let noLongerExists := "how are you?";
    somethingElseNow(stillExists, noLongerExists);

    struct SomeStruct {
        username: String = ...,
        password: #redacted String = ...,
    }
    let someStruct := SomeStruct {
        username="username",
        password=getEnvVar("ENV_VAR_NAME")
    };
}

proc testingNullable(input1: Bool?) -> Bool | err.nullPointer {
    input1 :? return err.nullPointer;
    return true;
}

proc main(nothing: Nihil) -> U64 {
    let window := try initializeWindow(100, 100, "Chaos Window!") |error| {
        eprintln("Something went wrong in here...");
        return 1;
    };
    defer destroyWindow(window=window);
}

struct #singleton Another[T] {
    somethingElse: T? = null,
    item: String = "",
    number: U32 = 0,
}

struct Something {
    valA: U32 = ..., `swizzling:"a"`
    valB: U32 = ..., `swizzling:"b"`
    valC: U32 = ..., `swizzling:"c"`
}
something: Something = (1000, 2000, 3000);
something.abc = something.abc * 10;

proc multipleReturns(toggle: Bool) -> String, U32 | err.nullPointer {
    if (toggle) return err.nullPointer;
    return "hi", 10;
}

proc noDiscardReturn() -> #noDiscard Bool, String {
    return true, "hello world";
}

noDiscardReturn(); --- This should result in a compile time error
let someVariableName := noDiscardReturn(); --- This should result in a compile time error
let someVariableName1, someVariableName2 := noDiscardReturn(); --- This should work just fine
let nothing := noDiscardReturn(); --- This should work just fine

struct JsonResponse[T] {
    statusCode: U32 = ...,
    content: Dict[String, T] = ...,
}

let #inline Number := U8 | U16 | U32 | U64 | I8 | I16 | I32 | I64 | F16 | F32 | F64;

struct Array[S: Literal[Number] | Literal[dynamic], T: Type] {
    items: T = ...,
    local count: U64 = #0,
    local capacity: U64 = #id (S != dynamic) S #else 256,
}

proc Array.__RunTimeCheck__(self: *Self) -> Nihil {
}

struct Array[S: Literal[U64] | Literal[dynamic] = ..., T: Type = ...] {
    items: T = ...,
    count: U64 = #0,
    capacity: U64 = #if (S != dynamic) S #else 256,

    #if __RunTimeCheck__ {
        --- do some run time check here using introspection...
    }

    #if S == dynamic {
        #configuration __IncludeElement__ := (using * self: *Self, other: T) Nihil, error.outOfMemory {
            if count >= capacity {
                capacity = 2 * capacity;
                items = try mem.realloc(items, capacity * sizeOf(items)) |error| {
                    eprintln("{error}");
                    return error.outOfMemory;
                }
            }
            items[count++] = other;
        },
        #configuration __RemoveElement__ := {},
        #configuration __ReplaceElement__ := {},
    }
}

proc checkFirstElementExists(element: Array?[dynamic, ___]) -> Bool, err.nullPointer {
    --- expands to the following:
    --- if (element == null) { element = Array[dynamic, String]{}; }
    element :? element = Array[dynamic, String]{};

    --- Checks for the size of the array, if the accessing index is greater,
    --- raises and nullpointer error or something like this.
    // try let some := element[0] orReturn <err.nullPointer>;
    let some := try element[0] orSet "";
    return true;
}

let someList := Array[dynamic, String]{};
try checkFirstElementExists(someList);

proc SimpleStruct.__Addition__[T, U, V](self: T, other: U) -> V {
    #if typeOf(self) == *Self && typeOf(other) == *Self {
        self.field1 += other.field1;
        self.field2 += other.field2;
        return Nihil;
    }
}

proc SimpleStruct.__Subtraction__() -> Nihil {
}

struct SimpleStruct {
    field1: F64 = ...,
    field2: U64 = ...,

    #configuration private __Addition__ := {
        #case (self: *Self, other: *Self) -> Nihil {
            self.field1 += other.field1;
            self.field2 += other.field2;
        }
