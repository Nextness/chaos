/** DOCUMENTATION *********************************************************************************
   The idea here is that the exampleString variable is constant, meaning that after assignment,
 no assignment or change can be made to it. However, if we get the address of the variable and
 assign it to a able variable, we can change the value of the address using the mutable
 variable.
   At the end of the operation, both variables have the same value, even though the variable
 exampleString is constant.
**************************************************************************************************/

proc main() => Void {
    let exampleString := <<Testing something with strings>>;
    let changeableVar := &exampleString;
    changeableVar.set(0, <<t>>);
    assert exampleString == changeableVar && <<Strings should match>>;
    return;
}

macro List[default].get(&self, position) => T! {
    if self.length < position then return err.outOfBounds;
    return #unsafe $$get(self, position);
}

macro List[default].insert(&self, position: U64, value: T) => Void! {
    if self.length < position then return err.outOfBounds
    #unsafe $$insert(self, position, value)
}

proc someProcExample() => String! {
    let someList := List[4, String](<<Hello>>, <<World>>, <<!>>);
    let result1 := if catch someList[0] |error| then return Err.outOfBounds;
    // #unsafe somelist[10] = <<>>;
    if catch someList[3] = <<\n>> |error| then return Err.someError;
    return someList.string();
}



let someContext: NameScope = {
    macro drawUI(callback: *proc(nothing) => Void) {
        rl::beginDrawing();
        rl::clearBackgroud(rl::rayWhite);
        callback();
        rl::endDrawing();
    }
}

macro gameNextSecond :: (timeFrame: *F64, callback: proc :: () => Void) => Void {
    if *timeFrame += rl::getFrameTime() >= 1.0 {
        callback();
        timeFrame = 0.0;
    }
}

proc main :: () => U32 {
    let openedFile: List[dynamic, String] = if catch open(<<./somepath/file.ext>>, <<r>>) |nani| {
        logger.error(<<Error while loading file - reason: {err.string()}>>);
        return 1;
    }
    defer close(openedFile);

    while let lineContent := catch openedFile.readline() |error| {
        if error == AnyFlaw {
            logger.error(<<Failed to parse line - reason: {error.reason()} >>);
            return 1;
        }
        if openedFile.hasEnded() then break;
        io::println(lineContent);
    }

    return 0;
}

