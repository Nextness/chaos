// if allocatedString is never destroyed, the compiler will fail
let allocated_string: *String = try mem::alloc_heap(128) or_return Err.null_pointer;
let allocatedString: *String = try mem::allocHeap(128) orReturn Err.nullPointer;
defer mem::freeHeap(allocatedString);

type Version[T: num::Ints = U8] :: struct {
    major, minor, fix: U8;
    phase:             String? = null;
}

let testVersion0 : Version[U16] = .(major=10, minor=0, fix=0, phase=<<development>>);
let testVersion1 := Version[U16].(major=10, minor=0, fix=0, phase=<<development>>);

proc Version[default].string :: (using &self) => String {
    let versionString := <<{major}.{minor}.{fix}>>;
    if phase != null then versionString = <<{versionString}-{phase}>>;
    return versionString;
}

{
    proc somethingElseNow :: (string: *String, @destroyed newValue: *String) => Void! {
        if !string || !newValue then return Err.nullPointer;
        defer allocator::heapFree(newValue);
        string = <<{*string} {newValue}>>;
        println(*string);
    }

    let stillExists := <<hello world>>;
    let  @destroyed noLongerExists := allocator::heapAlloc[*String](20);
    noLongerExists = <<how are you?>>;
    somethingElseNow(&stillExists, &noLongerExists);
}

