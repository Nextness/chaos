struct JsonResponse[T] {
    statusCode: U32 `json:"status_code"` = ...,
    content:    T   `json:"content"`     = ...,
}

macro Literal[T] $$Literal[T];

struct Array[S: LiteralValue[num.Natural | dynamic], T: Type, CT: num.Natural = U64, CP: num.Natural = U64] {
    items: T,
    count: U64 = #0,
    capacity: U64 = 1 #if (S != dynamic) #else S,
}

struct Array[S: Literal[num.Natural | dynamic], T: Type] {
    items: T = ...,
    count: U64 = #0,
    capacity: U64 = 256 #if (S != dynamic) #else S,
}

proc checkFirstElementExists(mut element: Array?[dynamic, ___]) -> Bool! {
    if (element:?) element = Array[dynamic, String]{};
    --- Checks for the size of the array, if the accessing index is greater,
    --- raises and nullpointer error or something like this.
    let some := try element.get(0) orSet "";
    return true;
}

