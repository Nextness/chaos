let const helloWorld: Const[String] = "Hello World";

proc main() -> U32 {
    try with openFile("/somepath", "r") using openedFile {
        for line in openedFile.readline() {
            println("%s\n", line);
        }
    } |error| {
        case default {
            println(i"error while loading file: {error}");
            return err.fileNotFound;
        }
    };
    return 0;
}

proc testingLikelyUnlikely(field1, field2, field3: String) -> Bool {
    if likely field1 != field2 && field2 != field3 {
        doSomethingHere();
    } else unlikely {
        doSomethingElseHere();
    }
}

