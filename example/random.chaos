/** DOCUMENTATION ****************************************************************************************
      The following will be the result. Because we have a iterable type, the return value of the function
  is a boolean. On the otherhand, if the implementation uses something incrementable, the return will be a
  I64. Any other value will be considered unrecheable and will be a compile time error.
      Also this is considered a macro, because it has a inline keyword.

  let result: Bool = another_test[SomeIterableImplementation](someValue, <<another name>>);
********************************************************************************************************/
inline proc another_test [T: impl.Iterable | impl.Incrementable] :: (input: T, value: String) => (
    result: #if #containsImplOf(T, impl.Iterable) #then Bool = false
            #elif #containsImplOf(T, impl.Incrementable) #then I64 = 0
            #else #unreacheable
) {
    
}

proc anotherTest[T: impl.Iterable | impl.Incrementable] :: (input: T, value: String) => (
    #if typeOf(T) == { #case Iterable #then Bool; #case Incrementable # then I64; }
) {
    
}

