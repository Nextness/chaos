type Comparable[T: Primitive] :: interface #composable {
    proc operator <  :: (this, that: T) => Bool;
    proc operator >  :: (this, that: T) => Bool;
    proc operator >= :: (this, that: T) => Bool;
    proc operator <= :: (this, that: T) => Bool;
    proc operator == :: (this, that: T) => Bool;
    proc operator != :: (this, that: T) => Bool;
}

