#[overload_by_signature()]
#check_for_string_behavior :: (item : #any) |no_string_behavior| -> #string? {
    #if #not #match_behavior(item, __string__) {
        #do_not_compile #raise_and_return (
            no_string_behavior, "The provided '{item.literal}' does not have a string behavior."
        );
    }
    #return null;
}

#[overload_by_signature()]
#check_for_string_behavior :: (items : #variadic[#any]) |no_string_behavior| -> #string? {
    #while index, item #in #enumerate items {
        #if #not #match_behavior(item, __string__) {
            #do_not_compile #raise_and_return (
                no_string_behavior,
                "The provided '{item.literal}' at position '{index}' does not have a string behavior."
            );
        }
    }
    #return null;
}

assert! :: (evaluations : variadic[bool], message : string) -> nihil {
    #try #check_for_string_behavior(message) |nothing|
        #exit_with 1, "COMPILATION ERROR: '{message.literal}' has no string behavior.";
    let failed_assertion : bool = false;
    while index, evaluation in enumerate evaluations {
        unless evaluation {
            failed_assertion = true;
            eprintln!("Failed at assertion {index}: {message}");
        }
    }
    if failed_assertion
        exit_with 1;
    return null;
}

println! :: (value: string, a: variadic[any], out: some_enum = standard_file_descriptor) -> nihil {
    #check_for_string_behavior(a);
}

eprintln! :: (value: string, a: variadic[any], out: some_enum = error_file_descriptor) -> nihil {
    #check_for_string_behavior(a);
}

