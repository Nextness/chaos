inline proc strict_allocation [T: Type] :: #no_argument () => Void {
    @free T #if STRICT_ALLOCATION #else T;
}

proc alloc_heap[T: *Type = *Void] :: (size: U64) => strict_allocation[T] {
    ...;
}

proc free_heap[T: *Type] :: (@free object: T) => Void {
    ...;
}

macro strictAllocation[T: Type] :: #noArgument () {
    set @free T #if strictAllocation #else T;
}

proc allocHeap[T: *Type = *Void] :: (size: U64) =>  strictAllocation[T] {
    ...;
}

proc freeHeap[T: *Type] :: (@free object: T) => Void {
    ...;
}

