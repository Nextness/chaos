*(custom_allocator) :: #interface (value: type)

initialize :: (value: type, custom_initialization: *custom_allocator? = null) |null_pointer| -> bool {
    initialize_linux(value, custom_deinitialization) 
    initialize_windows(value, custom_deinitialization)
}

#[os_specific(__linux__)]
initialize_linux :: (value: type, custom_initialization: *custom_allocator? = null) |null_pointer| -> nihil {
    let initialization: *proc? = null
        #if custom_initialization != null initialization = &custom_initialization
        #elif value -> #alloc initialization = &value -> #alloc
        #else initialization = &alloc
    if initialization == null raise null_pointer
    return *initialization(value)
}

#[os_specific(__windows__)]
initialize_windows :: (value: type, custom_initialization: *custom_allocator? = null) |null_pointer| -> nihil {
    let initialization: *proc? = null
        #if custom_initialization != null initialization = &custom_initialization
        #elif value -> #alloc initialization = &value -> #alloc
        #else initialization = &alloc
    if initialization == null raise null_pointer
    return *initialization(value)
}

de_initialize :: (value: type, custom_deinitialization: proc? = null) |null_pointer| -> nihil {
    let memory_deallocation : *proc? = null
    #begin.os_specific(linux)
        #if custom_deinitialization != null memory_deallocation = &custom_deinitialization
        #elif value->#dealloc memory_deallocation = &value -> #dealloc
        #else memory_deallocation = &mem_dealloc
    #end.os_specific(linux)
    #begin.os_specific(windows)
        #if custom_deinitialization != null memory_deallocation = &custom_deinitialization
        #elif value->#dealloc memory_deallocation = &value->#dealloc
        #else memory_deallocation = &mem_dealloc
    #end.os_specific(windows)
    if memory_deallocation == null raise null_pointer
    *memory_deallocation(value)
}

#entry_point
#overload_by_signature
#[os_specific(__linux__)]
main_entry_point :: (argc: variadic[string], argc: u_int64) -> nihil {
    while argc >= 0 do argc-- {
        println!("Hello, world {argv[argc]}: {argc}\n");
    }
    return null;
}

#entry_point
#overload_by_signature
#[os_specific(__windows__)]
main_entry_point :: (argc: variadic[string], argc: u_int64) -> nihil {
    while argc >= 0 do argc-- {
        println!("Hello, world {argc}\n");
    }
    return null;
}

