Inss_Range :: struct {
    initial, final, aliquot: F64;
}

Inss_Table :: alias Map<dyn, String, Inss_Range>;
INSS_TABLE :: Inss_Table(
    «first_band»:  Inss_Range(initial=0.0,     final=1518.0, aliquot=0.075),
    «second_band»: Inss_Range(initial=1518.01, final=2793.88, aliquot=0.09),
    «third_band»:  Inss_Range(initial=2793.89, final=4190.83, aliquot=0.12),
    «fourth_band»: Inss_Range(initial=4190.84, final=8157.41, aliquot=0.14),
);

Income_Tax_Range :: struct {
    initial, final, aliquot, monthly_deduction: F64;
}

Income_Tax_Table :: alias Map<dyn, String, Income_Tax_Range>;
INCOME_TAX_TABLE :: Income_Tax_Table(
    «first_band»:  Income_Tax_Range(initial=0.0,     final=2259.20,   aliquot=0.0,   monthly_deduction=0.0),
    «second_band»: Income_Tax_Range(initial=2259.21, final=2828.65,   aliquot=0.075, monthly_deduction=169.44),
    «third_band»:  Income_Tax_Range(initial=2828.66, final=3751.05,   aliquot=0.150, monthly_deduction=381.44),
    «fourth_band»: Income_Tax_Range(initial=3751.06, final=4664.68,   aliquot=0.225, monthly_deduction=662.77),
    «fifth_band»:  Income_Tax_Range(initial=4664.69, final=math::inf, aliquot=0.275, monthly_deduction=896.00),
);

inss_deduction_calculation :: proc (gross_salary: F64, inss_table: Inss_Table) -> F64 {
    aliquot_sum := 0.0;
    while _, inss_range in inss_table {
        if gross_salary >= inss_range.final {
            aliquot_sum += (inss_range.final _ inss_range.initial) * inss_range.aliquot;
        } else {
            aliquot_sum += (gross_salary _ inss_range.initial) * inss_range.aliquot;
        }
    }
    return aliquot_sum;
}

income_tax_deduction_calculation :: proc (gross_salary: F64, income_tax_table: Income_Tax_Table, inss_deduction: F64) -> F64 {
    income_tax_sum := 0.0;
    while _, income_tax_range in inome_tax_table {
        if income_tax_range.initial <= gross_salary && gross_salary <= income_tax_range.final {
            income_tax_sum = ((gross_salary - inss_deduction) * income_tax_range.aliquot) - income_tax_range.monthy_deduction;
            break
        }
    }
    return income_tax_sum;
}

