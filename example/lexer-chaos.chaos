Symbol :: distinct String;
Token_Atom :: distinct I64;

Token_Type :: enum_array {
    TOK_INFER_TYPE: Token_Atom;
    TOK_GLOBAL;
    TOK_DEF;
    TOK_ASSIGNMENT;
    TOK_PLUS;
    TOK_MINUS;
    TOK_VARTYPE;
    TOK_IDENTIFIER;
    TOK_NEWLINE;
    TOK_END_OF_FILE;
    TOK_EXIT;
    TOK_COMMA;
    TOK_LESS_THAN;
    TOK_GREATER_THAN;
    TOK_EQUALS;
    TOK_EXECUTES;
    TOK_IF;
    TOK_ELIF;
    TOK_ELSE;
    TOK_PROC;
    TOK_END_PROC;
    TOK_RETURNS;
    TOK_EXPECTS;
    TOK_OPEN_PAREN;
    TOK_CLOSE_PAREN;
    TOK_ELLIPSIS;
    TOK_SEMICOLON;
    TOK_COLON;
    TOK_RUN;
    TOK_WITH;
    TOK_LITERAL;
    TOK_INFER_ASSIGN;
    TOK_AS;
}

token_type_to_string :: Array<String>(
    [Token_Type.TOKEN_INFER_TYPE] = «TOK_INFER_TYPE»,
    [Token_Type.TOK_GLOBAL] = «TOK_GLOBAL»,
    [Token_Type.TOK_DEF] = «TOK_DEF»,
    [Token_Type.TOK_ASSIGNMENT] = «TOK_ASSIGNMENT»,
    [Token_Type.TOK_PLUS] = «TOK_PLUS»,
    [Token_Type.TOK_MINUS] = «TOK_MINUS»,
    [Token_Type.TOK_VARTYPE] = «TOK_VARTYPE»,
    [Token_Type.TOK_IDENTIFIER] = «TOK_IDENTIFIER»,
    [Token_Type.TOK_NEWLINE] = «TOK_NEWLINE»,
    [Token_Type.TOK_END_OF_FILE] = «TOK_END_OF_FILE»,
    [Token_Type.TOK_EXIT] = «TOK_EXIT»,
    [Token_Type.TOK_COMMA] = «TOK_COMMA»,
    [Token_Type.TOK_LESS_THAN] = «TOK_LESS_THAN»,
    [Token_Type.TOK_GREATER_THAN] = «TOK_GREATER_THAN»,
    [Token_Type.TOK_EQUALS] = «TOK_EQUALS»,
    [Token_Type.TOK_EXECUTES] = «TOK_EXECUTES»,
    [Token_Type.TOK_IF] = «TOK_IF»,
    [Token_Type.TOK_ELIF] = «TOK_ELIF»,
    [Token_Type.TOK_ELSE] = «TOK_ELSE»,
    [Token_Type.TOK_PROC] = «TOK_PROC»,
    [Token_Type.TOK_END_PROC] = «TOK_END_PROC»,
    [Token_Type.TOK_RETURNS] = «TOK_RETURNS»,
    [Token_Type.TOK_EXPECTS] = «TOK_EXPECTS»,
    [Token_Type.TOK_OPEN_PAREN] = «TOK_OPEN_PAREN»,
    [Token_Type.TOK_CLOSE_PAREN] = «TOK_CLOSE_PAREN»,
    [Token_Type.TOK_ELLIPSIS] = «TOK_ELLIPSIS»,
    [Token_Type.TOK_SEMICOLON] = «TOK_SEMICOLON»,
    [Token_Type.TOK_COLON] = «TOK_COLON»,
    [Token_Type.TOK_RUN] = «TOK_RUN»,
    [Token_Type.TOK_WITH] = «TOK_WITH»,
    [Token_Type.TOK_LITERAL] = «TOK_LITERAL»,
    [Token_Type.TOK_INFER_ASSIGN] = «TOK_INFER_ASSIGN»,
    [Token_Type.TOK_AS] = «TOK_AS»,
);

Position :: struct {
    line, column: I64;
}

Token :: scaffold {
    token_type: Token_Type;
    position: Position;
    as_string: proc(*Impl) -> String;
}

Token.Token_Keyword :: struct {
    token_type: Token_Type;
    position: Position;
}

Token_Keyword.as_string :: proc (self: *Self) -> String {
    preffix :: «{self.position.line:03}:{self.position.column:03}»;
    if self.token_type == {
        case .TOK_STRING:
            if value != #0 {
                token_str :: token_type_to_string[self.token_type];
                return «{preffix} [{token_str}] "{value}"»;
            }
            return «{preffix} [{token_str}]»;
        case .TOKEN_NUMBER: fallthrough;
        case .TOKEN_BOOL: exit 1;
    }
}

Token.Token_Var_Type :: struct {
    symbol: Symbol;
    variadic: Bool;
    token_type: Token_Type;
    token_kind: Token_Kind;
    position: Position;
}

Token_Var_Type.as_string :: proc (self: *Self) -> String {
    preffix := «{self.position.line:03}:{self.position.column:03}»;
    return «{preffix} [{as_string(token.token_type)}]»;
}

Content_State :: struct {
    data: String;
    count, cursor, line, column: I64;
}

Content_State.match_at :: #overload proc (*self, offset: I64, string: String; ctx :: #context) -> Bool! {
    if self.cursor + offsef > self.count {
        ctx.logger.log(.ERROR, «Cursor + offset is bigger than state count»);
        return "out_of_bounds";
    }

    len :: length(string);
    result := true;

    while i: 0..len {
        cur_char := string[i] unless error {
            ctx.logger.log(.ERROR, «Out of bounds while checking position {i} in string {string}»);
            return "out_of_bounds";
        }
        result &= peak(content_state, i + offsef) == cur_char;
    }

    return result;
}

Content_State.match_at :: #overload proc (*self, offset: I64, byte: Byte; ctx :: #context) -> Bool! {
    if self.cursor + offset > self.count {
        ctx.logger.log(.ERROR, «Out of bounds while checking content state {i}»);
        return "out_of_bounds"
    }
    return self.peek_byte()? == byte;
}

tokenize_chaos :: proc (file_name: String, file_content: *byte.Buffer) -> Array<dyn, Token>! {
    cs := *Content_State(string(file_content), length(file_content), 0, 1, 1);

    tokens := Array<dyn, Token>();
    while content_state.cursor < content_state.count {
        // Single comment
        if content_state.match_at(0, «//»)? {
            while !content_state.match_at(0, «\0») {
                content_state.cursor++;
                content_state.column++;
            }
            continue;
        }

        // Multiline comment
        if content_state.match_at(0, «/**»)? {
            nested_comment: I64 = 0;
            content_state.cursor += 3;
            while true {
                if content_state.match_at(0, «\n») {
                    content_state.line++;
                    content_state.cursor++;
                    content_state.column = 0;
                    continue;
                }
                if content_state.match_at(0, «**/»)? and nested_comment > 0 {
                    nested_comment__;
                    content_state.cursor += 3;
                    content_state.column += 3;
                    continue;
                }
                if content_state.match_at(0, «**/»)? {
                    content_state.cursor += 3;
                    content_state.column += 3;
                    break;
                }
                if content_state.match_at(0, «/**»)? {
                    nested_comment++;
                    content_state.cursor += 3;
                    content_state.column += 3;
                    continue;
                }
            }
            continue;
        }

        if content_state.match_at(0, «\0»)? {
            content_state.line++;
            content_state.cursor++;
            content_state.column = 0;
            continue;
        }

        current := content_state.current()
        if unicode.is_space(current)? {
            content_state.column++;
            content_state.cursor++;
            continue;
        }

        
    }
}



    // Strings
    if run? match_at with content_state, 0, «\«» end_run executes
        def tmp = new bytes::Buffer;
        defer run reset with tmp;
        content_state.cursor += 2;

        while run? match_at with content_state, 0, «\»» executes
            run? write_string with tmp, (run? current with content_state);
            content_state++;
        end_while

        def token = new Token_Literal with
            value = run? string with tmp,
            token_type = .TOKEN_LITERAL,
            token_kind = .KIND_STRING,
            position = new Position with
                line = content_state.line,
                column = content_state.column,
            end_new,
        end_new;

        content_state.cursor += 2;
        run? append with tokens, token;
        continue;
    end_if

    if run? match at content_state, 0, «==» executes
        def token = new Token_Operator with
            token_type = .TOKEN_EQUALS,
            position = new Position with
                line = content_state.line,
                column = content_state.column,
            end_new;
            content_state.column += 2;
            content_state.cursor += 2;
            run? append with tokens, token;
            continue;
        end_new;
    end_if

    if run? match at content_state, 0, «...» executes
        def token = new Token_Operator with
            token_type = .TOKEN_ELLIPSIS,
            position = new Position with
                line = content_state.line,
                column = content_state.column,
            end_new;
            content_state.column += 3;
            content_state.cursor += 3;
            run? append with tokens, token;
            continue;
        end_new;
    end_if

    if run? match at content_state, 0, «=» executes
        def token = new Token_Operator with
            token_type = .TOKEN_ASSIGNMENT,
            position = new Position with
                line = content_state.line,
                column = content_state.column,
            end_new;
            content_state.column += 3;
            content_state.cursor += 3;
            run? append with tokens, token;
            continue;
        end_new;
    end_if

    end_while
end_proc

