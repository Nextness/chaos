Symbol :: distinct String;
Token-Atom :: distinct I64;

Token-Type :: enum-array {
    TOK-INFER-TYPE: Token-Atom;
    TOK-GLOBAL;
    TOK-DEF;
    TOK-ASSIGNMENT;
    TOK-PLUS;
    TOK-MINUS;
    TOK-VARTYPE;
    TOK-IDENTIFIER;
    TOK-NEWLINE;
    TOK-END-OF-FILE;
    TOK-EXIT;
    TOK-COMMA;
    TOK-LESS-THAN;
    TOK-GREATER-THAN;
    TOK-EQUALS;
    TOK-EXECUTES;
    TOK-IF;
    TOK-ELIF;
    TOK-ELSE;
    TOK-PROC;
    TOK-END-PROC;
    TOK-RETURNS;
    TOK-EXPECTS;
    TOK-OPEN-PAREN;
    TOK-CLOSE-PAREN;
    TOK-ELLIPSIS;
    TOK-SEMICOLON;
    TOK-COLON;
    TOK-RUN;
    TOK-WITH;
    TOK-LITERAL;
    TOK-INFER-ASSIGN;
    TOK-AS;
}

token-type-to-string :: Map<dyn, Token-Type, String>(
    .TOKEN-INFER-TYPE: «TOK-INFER-TYPE»,
    .TOK-GLOBAL: «TOK-GLOBAL»,
    .TOK-DEF: «TOK-DEF»,
    .TOK-ASSIGNMENT: «TOK-ASSIGNMENT»,
    .TOK-PLUS: «TOK-PLUS»,
    .TOK-MINUS: «TOK-MINUS»,
    .TOK-VARTYPE: «TOK-VARTYPE»,
    .TOK-IDENTIFIER: «TOK-IDENTIFIER»,
    .TOK-NEWLINE: «TOK-NEWLINE»,
    .TOK-END-OF-FILE: «TOK-END-OF-FILE»,
    .TOK-EXIT: «TOK-EXIT»,
    .TOK-COMMA: «TOK-COMMA»,
    .TOK-LESS-THAN: «TOK-LESS-THAN»,
    .TOK-GREATER-THAN: «TOK-GREATER-THAN»,
    .TOK-EQUALS: «TOK-EQUALS»,
    .TOK-EXECUTES: «TOK-EXECUTES»,
    .TOK-IF: «TOK-IF»,
    .TOK-ELIF: «TOK-ELIF»,
    .TOK-ELSE: «TOK-ELSE»,
    .TOK-PROC: «TOK-PROC»,
    .TOK-END-PROC: «TOK-END-PROC»,
    .TOK-RETURNS: «TOK-RETURNS»,
    .TOK-EXPECTS: «TOK-EXPECTS»,
    .TOK-OPEN-PAREN: «TOK-OPEN-PAREN»,
    .TOK-CLOSE-PAREN: «TOK-CLOSE-PAREN»,
    .TOK-ELLIPSIS: «TOK-ELLIPSIS»,
    .TOK-SEMICOLON: «TOK-SEMICOLON»,
    .TOK-COLON: «TOK-COLON»,
    .TOK-RUN: «TOK-RUN»,
    .TOK-WITH: «TOK-WITH»,
    .TOK-LITERAL: «TOK-LITERAL»,
    .TOK-INFER-ASSIGN: «TOK-INFER-ASSIGN»,
    .TOK-AS: «TOK-AS»,
);

Position :: struct {
    line, column: I64;
}

Token :: scaffold {
    token-type: Token-Type;
    position: Position;
}

Token.Token-Keyword :: struct {
    token-type: Token-Type;
    position: Position;
}

Token.Token-Var-Type :: struct {
    symbol: Symbol;
    variadic: Bool;
    token-type: Token-Type;
    token-kind: Token-Kind;
    position: Position;
}

Token-Var-Type.as-string :: proc (self: *Self) -> String {
    preffix := «{self.position.line:03}:{self.position.column:03}»;
    return «{preffix} [{as-string(token.token-type)}]»;
}

#[overload]
proc as-string
    expects token as Token-Literal
    returns String
executes
    def preffix as String = «{t.position.line:03}:{t.position.column:03}»;

    if value = token.value as?
    case String executes
        if (value != #0) return «{preffix} [{run as-string with token.toke-type}] "{value}"»;
        return «{preffix} [{run as-string with token.toke-type}]»;
    case I64 executes
        return «{preffix} [{run as-string with token.toke-type}] "{value}"»;
    case Bool executes
        return «{preffix} [{run as-string with token.toke-type}] "{value}"»;
    case F64 executes
        return «{preffix} [{run as-string with token.toke-type}] "{value}"»;
    end-if

    exit 1, «Unexpected token literal found: {token.value}»;
end-proc

Content-State :: struct {
    data: String;
    count, cursor, line, column: I64;
}

Content-State.match-at :: #overload proc (*self, offset: I64, string: String) -> Bool! {
    if self.cursor + offsef > self.count {
        return "out-of-bounds :: Cursor + offset is bigger than state count";
    }

    len :: length(string);
    result := true;

    for i := 0 while i..len {
        cur-char := string[i] unless |error| {
            return "out-of-bounds :: Out of bounds while checking position {i} in string {string}";
        }
        result = result and peak(content-state, i + offsef) == cur-char;
    }

    return result;
}

Content-State.match-at :: #overload proc (*self, offset: I64, byte: Byte) -> Bool! {
    if self.cursor + offset > self.count {
        return "out-of-bounds :: Out of bounds while checking content state {i}"
    }
    return self.peek-byte()? == byte;
}

tokenize-chaos :: proc (file-name: String, file-content: *byte.Buffer) -> Array<dyn, Token>! {
    cs := *Content-State(
        data = string(file-content),
        count = length(file-content),
        cursor = 0,
        line = 1,
        column = 1,
    );

    tokens := Array<dyn, Token>();
    while content-state.cursor < content-state.count {
        // Single comment
        if content-state.match-at<String>(0, «//»)? {
            while not content-state.match-at(0, «\0») {
                content-state.cursor++;
                content-state.column++;
            }
            continue;
        }

        // Multiline comment
        if content-state.match-at(0, «/**»)? {
            nested-comment: I64 = 0;
            content-state.cursor += 3;
            while true {
                if content-state.match-at(0, «\n») {
                    content-state.line++;
                    content-state.cursor++;
                    content-state.column = 0;
                    continue;
                }
                if content-state.match-at(0, «**/»)? and nested-comment > 0 {
                    nested-comment--;
                    content-state.cursor += 3;
                    content-state.column += 3;
                    continue;
                }
                if content-state.match-at(0, «**/»)? {
                    content-state.cursor += 3;
                    content-state.column += 3;
                    break;
                }
                if content-state.match-at(0, «/**»)? {
                    nested-comment++;
                    content-state.cursor += 3;
                    content-state.column += 3;
                    continue;
                }
            }
            continue;
        }

        if content-state.match-at(0, «\0»)? {
            content-state.line++;
            content-state.cursor++;
            content-state.column = 0;
            continue;
        }

        current := content-state.current()
        if unicode.is-space(current)? {
            content-state.column++;
            content-state.cursor++;
            continue;
        }

        
    }
}



    // Strings
    if run? match-at with content-state, 0, «\«» end-run executes
        def tmp = new bytes::Buffer;
        defer run reset with tmp;
        content-state.cursor += 2;

        while run? match-at with content-state, 0, «\»» executes
            run? write-string with tmp, (run? current with content-state);
            content-state++;
        end-while

        def token = new Token-Literal with
            value = run? string with tmp,
            token-type = .TOKEN-LITERAL,
            token-kind = .KIND-STRING,
            position = new Position with
                line = content-state.line,
                column = content-state.column,
            end-new,
        end-new;

        content-state.cursor += 2;
        run? append with tokens, token;
        continue;
    end-if

    if run? match at content-state, 0, «==» executes
        def token = new Token-Operator with
            token-type = .TOKEN-EQUALS,
            position = new Position with
                line = content-state.line,
                column = content-state.column,
            end-new;
            content-state.column += 2;
            content-state.cursor += 2;
            run? append with tokens, token;
            continue;
        end-new;
    end-if

    if run? match at content-state, 0, «...» executes
        def token = new Token-Operator with
            token-type = .TOKEN-ELLIPSIS,
            position = new Position with
                line = content-state.line,
                column = content-state.column,
            end-new;
            content-state.column += 3;
            content-state.cursor += 3;
            run? append with tokens, token;
            continue;
        end-new;
    end-if

    if run? match at content-state, 0, «=» executes
        def token = new Token-Operator with
            token-type = .TOKEN-ASSIGNMENT,
            position = new Position with
                line = content-state.line,
                column = content-state.column,
            end-new;
            content-state.column += 3;
            content-state.cursor += 3;
            run? append with tokens, token;
            continue;
        end-new;
    end-if

    end-while
end-proc

