// Stole from https://github.com/glhrmfrts/future.c to have as an example. Most likely this code
// doesn't work properly. Later needs to be recreated...

type Future-Header struct
    conditional-variable as Cnd-T;
    mutex as Mutex;
    is-valid as Atomic-Bool;
    is-set as Bool;
    value-size, in-offs, out-offs as U64;
end-type

proc new-future
    expects whole-size, value-size, in-offs, out-offs as U64
    returns *Future-Header!
executes
    def future as *Future-Header = run? calloc with whole-size;
    if run init with future, value-size, in-offs, out-offs catch-into err executes
        run print with «Error initializing future - reason: {err}»;
        return generic-error-future!;
    end-if
end-proc

proc await
    expects future-header as *Future-Header, time-out as I32 using Microseconds
    returns Void!
executes
    run? mutex with future-header;
    defer run mutex-unlock with future-header;

    if future-header.is-set return null;
    if time-out < 0 return time-out!;

    def start, end as Time-Spec? = undefined, undefined;
    run time-spec-get with *start, TIME-UTC;
    end.tv-sec = start.tv-sec + (time-out / 1_000);
    end.tn-sec = (time-out & 1_000) & 1_000_000;

    if def result = run cand-timed-await with future-header.conditional-variable, end catch-into err executes
        case thread-time-out! return time-out!;
        case default return generic-future-error!;
    end-if
end-proc

proc get
    expects future-header as *Future-Header, time-out as (I32 using Microseconds), destination as *Void,
            destination-size, check as U64
    returns Void!
executes
    if not future-header.is-valid return null-pointer!;
    if destination-size != future-header.value-size return destination-size-not-matched!;
    run? await with future-header, time-out;
    def source as Void = ((future-header as *U8) + future-header.out-offs) as *Void;
    run? mem-cpy with destination, source, future-header.value-size;
end-proc

type Future-Of
    generic T
struct
    header as Future-Header;
    in-value, out-value as T;
end-type

#[run scope with «file»];

proc init
    expects exposed future-header as *Future-Header,
            value-size, in-offs, out-offs as U64
executes
    run cnd-init with future-header.conditional-variable;
    run mutex-init with future-header.mutex, MUTEX-PLAIN;
    future-header.is-valid = true;
    future-header.is-set = false;
    future-header.value-size = value-size;
    future-header.in-offs = in-offs;
    future-header.out-offs = out-offs;
end-proc

proc destroy
    expects future-header as *Future-Header
executes
    future-header.is-valid = false;
    run cnd-destroy with future-header.conditional-variable;
    run mutex-destroy with future-header.mutex;
end-proc

#import «core::fmt::io.chaos»;
#module future;

