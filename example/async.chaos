// Stole from https://github.com/glhrmfrts/future.c to have as an example. Most likely this code
// doesn't work properly. Later needs to be recreated...

module future;

type AsyncError flaw {
    nullPointer;
    timeout;
    noMemory;
    threadTimedout;
    destinationSizeNotMatched;
    genericFutureError;
}

type FutureHeader struct {
    conditionalVariable CndT;
    mutex Mutex;
    isValid AtomicBool;
    isSet Bool;
    valueSize, inOffs, outOffs U64;
}

proc newFuture(wholeSize, valueSize, inOffs, outOffs U64) &FutureHeader! {
    let future &FutureHeader = try calloc(wholeSize) orReturn error;
    if catch future.init(valueSize, inOffs, outOffs) {
        print(<<Error initializing future - reason: {error.reason()}>>);
        return AsyncError.genericErrorFuture;
    }
    return future;
}

proc FutureHeader.await(&self, timeout I32[Microseconds]) Void! {
    try self.mutex() orReturn AsyncError.genericFutureError;
    defer self.mutexUnlock();

    if self.isSet then return null;
    if timeout < 0 then return AsyncError.timeout;

    start, end Timespec = ...;
    timespecGet(&start, timeUtc);
    end.tvSec = start.tvSEC + (timeout / 1_000);
    end.nSec = (timeout % 1_000) & 1_000_000;

    if catch cndTimedWait(self.conditionalVariable, end) {
    case AsyncError.threadTimedout then return AsyncError.timeout;
    case default then return AsyncError.genericFutureError;
    }
}

proc FutureHeader.get(&self, timeout I32[Microseconds], destination &Void, destinationSize, check U64) Void! {
    if !self.isValid return AsyncError.nullPointer;
    if destinationSize != self.valueSize then return AsyncError.destinationSizeNotMatched;
    try self.await(timeout) orReturn error;

    let source &Void = self.(&U8) + self.outOffs.(&Void);
    memcpy(destination, source, self.valueSize);
}

type FutureOf[T] struct {
    header            FutureHeader;
    inValue, outValue T;
}

--- Private scope ---
#scope(__file__);

proc Future.init(&self, valueSize, inOffs, outOffs U64) {
    cndInit(self.conditionalVariable);
    mutexInit(self.mutex, mutexPlain);
    &self.{isValid=true, isSet=false, valueSize=valueSize, inOffs=inOffs, outOffs=outOffs};
}

proc FutureHeader.destroy(&self) Void! {
    self.isValid = false;
    cndDestroy(self.conditionalVariable);
    mutexDestroy(self.mutex);
}

import core::fmt::io;

