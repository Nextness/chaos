// Stole from https://github.com/glhrmfrts/future.c to have as an example. Most likely this code
// doesn't work properly. Later needs to be recreated...

module future;

type AsyncError flaw {
    nullPointer;
    timeout;
    noMemory;
    threadTimedout;
    destinationSizeNotMatched;
    genericFutureError;
}

type FutureHeader struct {
    CndT       conditionalVariable;
    Mutex      mutex;
    AtomicBool isValid;
    Bool       isSet;
    U64        valueSize, inOffs, outOffs;
}

def &FutureHeader! newFuture(U64 wholeSize, valueSize, inOffs, outOffs) func {
    let &FutureHeader future = try calloc(wholeSize) orReturn error;
    if catch future.init(valueSize, inOffs, outOffs) {
        print(<<Error initializing future - reason: {error.reason()}>>);
        return AsyncError.genericErrorFuture;
    }
    return future;
}

def Void! await(&FutureHeader fh, I32[Microsends] timeout) func {
    try mutex(fh) orReturn AsyncError.genericFutureError;
    defer mutexUnlock(fh);

    if fh.isSet then return null;
    if timeout < 0 then return AsyncError.timeout;

    start, end Timespec = ...;
    timespecGet(&start, timeUtc);
    end.tvSec = start.tvSEC + (timeout / 1_000);
    end.nSec = (timeout % 1_000) & 1_000_000;

    if let result |err| = cndTimedWait(fh.conditionalVariable, end); catch err {
    case AsyncError.threadTimedout then return AsyncError.timeout;
    case default then return AsyncError.genericFutureError;
    }
}

def Void! get(&FutureHeader fh, I32[Microseconds] timeout, &Void destination, U64 destinationSize, check) func {
    if !self.isValid return AsyncError.nullPointer;
    if destinationSize != self.valueSize then return AsyncError.destinationSizeNotMatched;
    try await(fh, timeout) orReturn error;

    let &Void source = fh.(&U8) + fh*.&outOffs.(&Void);
    memcpy(destination, source, fh*.valueSize);
}

type FutureOf[T] struct {
    header            FutureHeader;
    inValue, outValue T;
}

--- Private scope ---
#scope(__file__);

def init(&FutureHeader fh, U64 valueSize, inOffs, outOffs) method {
    cndInit(fh*.conditionalVariable);
    mutexInit(fh*.mutex, mutexPlain);
    ft*.{isValid=true, isSet=false, valueSize=valueSize, inOffs=inOffs, outOffs=outOffs};
}

def Void! destroy() method {
    fh*.isValid = false;
    cndDestroy(fh*.conditionalVariable);
    mutexDestroy(fh*.mutex);
}

import <<core::fmt::io>>;

