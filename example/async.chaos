// Stole from https://github.com/glhrmfrts/future.c to have as an example. Most likely this code
// doesn't work properly. Later needs to be recreated...

type FutureHeader struct
    conditionalVariable:        CndT;
    mutex:                      Mutex;
    isValid:                    AtomicBool;
    isSet:                      Bool;
    valueSize, inOffs, outOffs: U64;
end type

proc newFuture
    expects wholeSize, valueSize, inOffs, outOffs: U64
    returns *FutureHeader!
executes
    let future *FutureHeader = call calloc with wholeSize or return nullPointer!;
    if run futute.init with valueSize, inOffs, outOffs catch err executes
        run print with «Error initializing future - reason: {err}»;
        return genericErrorFuture!;
    end if
    return future;
end proc

proc await
    receiver fh: *FutureHeader
    expects timeout: I32 using Microseconds
    returns Void!
executes
    run mutex with fh or return genericFutureError!;
    defer call mutexUnlock with fh;

    if fh.isSet return null
    if timeout < 0 return timeout!

    start, end: Timespec = undefined, undefined;
    run timespceGet with *start, timeUtc;
    end.tvSec = start.tvSEC + (timeout / 1_000);
    end.tSec = (timeout % 1_000) & 1_000_000;

    if let result = run candTimedWait with fh.confitionalVariable, end catch err executes
        case threadTimedout! return timeout!;
        case default return genericFutureError!;
    end if
end proc


proc get
    receiver fh: *FutureHeader
    expects timeout: I32 using Microseconds, destination: *Void, destinationSize, check: U64
    returns Void!
executes
    if not fh.isValid return nullPointer!;
    if destinationSize != fh.valueSize return destinationSizeNotMatched;
    run await with fh, timeout or return;

    let source *Void = ((fh as *U8) + fh.outOffs) as *Void;
    run memcpy with destination, source, fh.valueSize;
end proc

type FutureOf
    generic T
struct
    header:            FutureHeader;
    inValue, outValue: T;
end type

#scope(«file»);

receiver fh *FutureHeader
proc init
    expects valueSize, inOffs, outOffs: U64
executes
    run cndInit with fh.conditionalVariable*;
    run mutexInit with fh.mutex*, mutexPlain;
    fh.isValid = true;
    fh.isSet = false;
    fh.valueSize = valueSize;
    fh.inOffs = inOffs;
    fh.outOffs = outOffs;
end proc

proc destroy
    receiver fh: *FutureHeader
executes
    fh.isValid* = false;
    run cndDestroy with fh.conditionalVariable;
    run mutexDestroy with fh.mutex;
end proc

#module future;
#import «core::fmt::io»;

