let da_init_size :: 256;
let da_increase_proportion :: 2;
#let allowed_item_types :: [1] << self.items.type #when T #in __real_numbers >>;

dynamic_array_t :: struct[T] {
    items: T? = #0,
    count: u_int64 = #0,
    capacity: u_int64 = da_init_size,
}

#[receiver(da: using dynamic_array_t pointer)]
append :: (item : self.items.type) |out_of_memory| -> nihil {
    if deref count >= deref capacity {
        deref capacity = da_increase_proportion * deref capacity;
        deref items = try mem.realloc(deref items, deref capacity * size_of(deref items)) |error| {
            eprintln!("{error.error_number}-{error.error_id}: {error.description}");
            raise_and_return out_of_memory, false;
        }
    }
    deref items[deref count++] = item;
}

#[receiver(da: using dynamic_array_t pointer #where self.items.type #in __real_numbers)]
sum :: (nothing : nihil) |zero_value or overflow_value| -> self.items.type {
    let temporary: result_cast_t = #0;
    unless deref count > 0
        raise_and_return zero_value, temporary;
    let i := 0 while deref count > i do ++i {
        temporary += deref items[i]
        if overflows!(temporary) {
            delete temporary;
            raise_and_return overflow_value, 0;
        }
    }
    return temporary;
}

#[receiver(da: using dynamic_array_t pointer #where self.items.type #in __real_numbers)]
mean :: (nothing : nihil) |zero_value| -> self.items.type {
    let temporary: T = #0;
    unless deref count > 0
        raise_and_return zero_value, temporary;
    for i: u_int32 = 0 while deref count > i do ++i
        temporary += deref items[i];
    return temporary / deref count;
}

#[receiver(da: using dynamic_array_t pointer #where self.items.type #in __real_numbers)]
standard_deviation :: (nothing : nihil) |zero_value| -> self.items.type {
    let temporary: T = #0;
    unless deref count > 0
        raise_and_return zero_value, temporary;
    for i: u_int32 = 0 while deref count > i do ++i
        temporary += deref items[i];
    not_implemented "Implemet stadard deviation";
}


include "errors";
