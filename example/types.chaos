// Numbers

Ints       :: tagged_union { I8   | I16 | I32 | I64 | I128; }
UInts      :: tagged_union { U8   | U16 | U32 | U64 | U128; }
Floats     :: tagged_union { F16  | F32 | F64 | F128; }
Complex    :: tagged_union { C64  | C128; }
Quaternion :: tagged_union { Q128 | Q256; }

Natural    :: tagged_union { Ints    | UInts; }
Real       :: tagged_union { Natural | Floats; }
Any_Number :: tagged_union { Real    | Complex | Quaternion; }

Matrix[Type, Row, Column] :: struct {
    #if (!Type.match(Any_Number))         #compilation_error «Expected any number type but got {Type}»;
    #if (!Row.match(Literal<Natural>))    #compilation_error «Expected a Literal value for {Natural.expand()} but got {Row} ({type_of Row})»;
    #if (!Column.match(Literal<Natural>)) #compilation_error «Expected a Literal value for {Natural.expand()} but got {Column} ({type_of Column})»;

    #while (r: 1..Row+1) #insert «row{r}: Array<{Column}, {T}>;\n»;
}

Vector[Type] :: struct {
    #if (!Type.match(Any_Number)) #compilation_error «Expected any number type but got {Type}»;
    x, y: Type;
}

#module types;

