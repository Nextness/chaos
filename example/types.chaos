// Numbers

Ints       :: alias I8 or I16 or I32 or I64 or I128;
UInts      :: alias U8 or U16 or U32 or U64 or U128;
Floats     :: alias F16 or F32 or F64 or F128;
Complex    :: alias C64  or C128;
Quaternion :: alias Q128 or Q256;

Natural   :: alias Ints or UInts;
Real      :: alias Natural or Floats;
AnyNumber :: alias Real or Complex or Quaternion;

Vector <T> :: struct { x, y: T; }

#module types;

