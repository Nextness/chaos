type SomeInterface scaffold
    mandatoryFieldOne String
    mandatoryFieldTwo Bool
    proc doSomeOperation[T](&Self)
endtype

type Example builds SomeInterface struct
    mandatoryFieldOne String
    mandatoryFieldTwo Bool = false
    anotherField      Bool
endtype

receiver self *Example proc doSomeOperation() do
    example.anotherFieldOne = true
endproc

type SomeInterface builds AnotherExample struct
    mandatoryFieldOne String = «»
    mandatoryFieldTwo Bool = false
endtype

receiver self *AnotherExample proc doSomeOperation() do
    anotherExample.mandatoryFieldOne = «»
    anotherExample.mandatoryFieldTwo = false
endproc

proc main() do
    // TODO: reconsider how to handle scaffolds - specifically the '<type> build <identifier>'
    let newExample *SomeInferface = make *Example with
        mandatoryFieldOne = «Hello, world»,
        mandatoryFieldTwo = false
    endmake

    printfn(«{newExample*.mandatoryFieldOne} is {newExample*.anotherField}»)
    newExample*.doSomeOperation()
    printfn(«{newExample*.mandatoryFieldOne} is {newExample*.anotherField}»)

    return
endproc

#module exampleScaffold
#import «core::fmt::io.chaos»

