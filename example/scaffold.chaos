scaffold
type Some-Interface
    generic T
struct
    mandatory-field-1 as String;
    mandatory-field-2 as T;
    proc do-some-operation generic T expects (*Build using Self) returns Void!;
end-type

type Example
    builds Some-Interface
    generic T
struct
    mandatory-field-1 as String;
    mandatory-field-2 as T;
    another-field as Bool;
end-type

proc do-some-operation
    builds Some-Interface
    expects example as *Example
    returns Void!
executes
    mandatory-field-1 as String = «»;
    mandatory-field-2 = #0;
end-proc

#[entry-point]
proc main executes
    def new-example as *Build using Some-Interface = new *Example with
        mandatory-field-1 = «Hello world»,
        mandatory-field-2 = false,
    end-new

    run print-fn with «{newExample*.mandatoryFieldOne} is {newExample*.anotherField}»;
    run do-some-operation with new-example;
    run print-fn with «{newExample*.mandatoryFieldOne} is {newExample*.anotherField}»;

    return;
end-proc

#module exampleScaffold;
#import «core::fmt::io.chaos»;

