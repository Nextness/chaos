generic T in
type SomeInterface scaffold
    mandatoryFieldOne String,
    mandatoryFieldTwo Bool,
    generic T for receiver &Self for proc doSomeOperation end proc,
end type

type Example struct
    mandatoryFieldOne String
    mandatoryFieldTwo Bool = false
    anotherField      Bool
end type

generic T for
receiver self *Example proc doSomeOperation executes
    example.anotherFieldOne = true
end proc

type AnotherExample struct
    mandatoryFieldOne String = «»
    mandatoryFieldTwo Bool = false
end type

generic T for
receiver self *AnotherExample proc doSomeOperation executes
    anotherExample.mandatoryFieldOne = «»
    anotherExample.mandatoryFieldTwo = false
end proc

proc main do
    // TODO: reconsider how to handle scaffolds - specifically the '<type> build <identifier>'
    let newExample *SomeInferface = new *Example with
        mandatoryFieldOne = «Hello, world»,
        mandatoryFieldTwo = false
    end new

    run printfn with «{newExample*.mandatoryFieldOne} is {newExample*.anotherField}»
    run newExample*.doSomeOperation
    run printfn «{newExample*.mandatoryFieldOne} is {newExample*.anotherField}»

    return
end proc

#module exampleScaffold
#import «core::fmt::io.chaos»

