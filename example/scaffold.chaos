Some-Interface <T> :: #scaffold {
    mandatory-field-1: String;
    mandatory-field-2: T;
    do-some-operation: proc (*Impl) -> Void!;
}

Some-Interface.Example <T> :: struct {
    mandatory-field-1: String;
    mandatory-field-2: T;
    another-field: Bool;
}

Example.do-some-operation :: proc (self: *Self) -> Void! {
    self.mandatory-field-1 = «»;
    self.mandatory-field-2 = #0;
}

main :: #entry proc () -> Void {
    new-example := Example(
        mandatory-field-1 = «Hello world»,
        mandatory-field-2 = true,
    );

    print(«{new-example.*.mandatory-field-1} is {new-example.*.another-field}»);
    new-example.do-some-operation();
    print(«{new-example.*.mandatory-field-1} is {new-example.*.another-field}»);

    return;
}

#module exampleScaffold;
#import «core::fmt::io.chaos»;

