type SomeInterface scaffold
{
    mandatoryFieldOne String ;
    mandatoryFieldTwo Bool;
    method def soSomeOperation[T](&Self);
}

type SomeInterface build Example struct
{
    mandatoryFieldOne String;
    mandatoryFieldTwo Bool = false;
    anotherField Bool;
}

#overload method def doSomeOperation[T](example &Example) T
{
    let example*.anotherFieldOne = true;
    return;
}

type SomeInterface build AnotherExample struct
{
    mandatoryFieldOne String = «»;
    mandatoryFieldTwo Bool = false;
}

#overload method def doSomeOperation[T](anotherExample &AnotherExample) T
{
    let String anotherExample*.mandatoryFieldOne = «»;
    let Bool anotherExample*.mandatoryFieldTwo = false;
}

func def main()
{
    // TODO: reconsider how to handle scaffolds - specifically the '<type> build <identifier>'
    let newExample &SomeInterface.scaffold = &Example
    {
        mandatoryFieldOne = «Hello, world»,
        anotherField = false
    };

    printfn(«{newExample*.mandatoryFieldOne} is {newExample*.anotherField}»);
    newExample*.doSomeOperation();
    printfn(«{newExample*.mandatoryFieldOne} is {newExample*.anotherField}»);

    return;
}

module exampleScaffold;
import «core::fmt::io.chaos»;

