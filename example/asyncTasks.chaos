proc asyncTask
    expects p proc returns AsyncTask
executes
    
end proc

proc getUserByUsername
    expects username: String, session: Session
    returns (Async using User)!
executes
    if username.len >= 4096 return largeText!;
    let getUserQuery := «SELECT username FROM user_database WHERE username={username}»;
    let user := run performQuery with session, getUserQuery;
    return user;
end proc

proc getUser
    expects username: String
    returns User!
executes
    proc task
        returns User!
    executes
        let globalSession := run getGlobalSession or return noSessionAvailable!;
        let user := run getUserByUsername with username, globalSession or return userNotFound!;
        return user;
    end proc

    let currentuser AsyncTask := run asyncTask with task;
    if let user := run currentUser.await catch executes
        run logger with «Failed to get user {username}»;
        return err;
    end if

    return user;
end proc

#module asyncTasks;
#import «core::tasks.chaos»;

