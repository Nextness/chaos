proc createUser(username, firstName, lastName: String) -> Bool {
    let newUser: User = asyncTask {
        let globalSession := try getGlobalSession() orReturn <noSessionAvailable>;
        set createNewUser(username, firstName, lastName) orReturn <failedToCreateUser>;
    }
    return try newUser.await() |error| return <error>;
}

proc getUserByUsername(username: String, session: Session) -> Async[User] | err.userNotFound {
    let const getUserQuery := sql"SELECT username FROM user_database WHERE username='{username}'";
    let user := try performQuery(session, getUserQuery) orReturn err.userNotFound;
    return user;
}

proc getUser(username: String) -> User | err.userNotFound | err.noSessionAvailable {
    let currentUser: User = async (asyncConfiguration) {
        let globalSession := try getGlobalSession() orReturn err.noSessionAvailable;
        set try getUserByUsername(username, globalSession) orReturn err.userNotFound;
    }
    return currentUser.await();
}

proc __MakeAsyncTask__[T](procedure: proc(...) -> T | <___>) -> Async[T] {
    return Async[T].{ value = procedure };
}

proc asyncTask[T](procedure: proc(...) -> T) -> Async[T] | <___> {
    let const aTask := __MakeAsyncTask__() {
        set try procedure() |error| {
            return <error>;
        };
    };
    return aTask;
}

proc getEmailByUsername(username: String, session: Session, logger: Logger? = null) -> String | err.emailNotFound {
    let const getEmailQuery := sql"SELECT email FROM user_database WHERE username='{username}'";
    let email: Async[String] = asyncTask() {
        set try performQuery(session, getEmailQuery) |error| {
            logger? logger.error("Failed to perform query to get user email");
            return err.emailNotFound;
        };
    };
    let const result: String = try email.await() |error| {
        logger :? logger.error("Failed to get user email");
        return error;
    };
    return result;
}

proc getEmail(username: String) -> String | noSessionAvailable | emailNotFound {
    let currentUser: Async[User] = asyncTask {
        let globalSession := try getGlobalSession() orReturn err.noSessionAvailable;
        set email := getEmailByUsername(username, globalSession) orReturn err.emailNotFound;
    }
    let result: String = try currentUser.await() |error| return error;
    return result;
}

let tasks := import "core/tasks/default";

