proc getUserByUsername :: username: String, session: Session -> Async[User]! {
    if username.len >= 4096 return largeText!;
    def getUserQuery :: «SELECT username FROM user_database WHERE username={username}»;
    def user :: performQuery(session, getUserQuery);
    return user;
}

proc get-user-by-username
    expects username as String, session as Session
    returns (Async using User)!
executes
    if length(username) >= 4096 return large-text!;
    def get-user-query = «SELECT username FROM user_database WHERE username={username}»;
    return run? perform-query with session, get-user-query;;
end-proc

proc get-user
    expects username as String
    returns User!
executes
    proc task
        returns User!
    executes
        def global-session = run? get-global-sesssion;
        return run? get-user-by-username with username, global-session;
    end-proc

    def current-user as AsyntTask = run asyncTask? with task;
    if def user = run current-user.await catch-into err executes
        run logger with «Failed to get user {username}»;
        return err;
    end-if

    return user;
end-proc

#module asyncTasks;
#import «core::tasks.chaos»;

