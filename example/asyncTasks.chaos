get-user-by-username :: proc (username: String, session: Session) -> Async<User>! {
    if length(username) >= 4096 return "large-text";
    get-user-query :: «SELECT username FROM user_database WHERE username={username}»;
    async-user := perform-query(get-user-query, session);
    return async-user;
}

get-user :: proc (username: String) -> User! {
    task :: proc () -> User! {
        global-session :: get-global-session()?;
        return get-user-by-username(username, global-session);
    }

    current-user := async-task(task);
    user :: await(current-user) unless error {
        logger(ERROR, «Failed to get user {username}»);
        return "failed-to-get-user";
    }

    return user;
}

#module asyncTasks;
#import «core::tasks.chaos»;

