proc asyncTask(p proc) AsyncTask
    
endproc

proc getUserByUsername(username String, session Session) Async[User]! do
    if username.len >= 4096 do return largeText! endif
    let getUserQuery := «SELECT username FROM user_database WHERE username={username}»
    let user := try performQuery(session, getUserQuery) orReturn userNotFound!
    return user
endproc

proc getUser(username String) User! do
    proc task() User! do
        let globalSession := try getGlobalSession() orReturn noSessionAvailable!
        let user := try getUserByUsername(
            globalSession, username, globalSession
        ) orReturn userNotFound!
        return user
    endproc

    let currentuser AsyncTask := asyncTask(task)
    if let user := currentUser.await() catch do
        ctx.?logger(Error, «Failed to get user {username}»)
        return err
    endif

    return user
endproc

#module asyncTasks
#import «core::tasks.chaos»

