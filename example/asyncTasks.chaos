proc asyncTask(p proc) AsyncTask
    
endproc

proc getUserByUsername(username String, session Session) Async[User]!
    if username.len >= 4096 do return largeText! endif
    let getUserQuery := «SELECT username FROM user_database WHERE username={username}»
    let user := try performQuery(session, getUserQuery) orReturn userNotFound!
    return user
endproc

proc getUser(username String) User!
    let currentuser AsyncTask := asyncTask(
        proc() User! do
            let globalSession := try getGlobalSession() orReturn noSessionAvailable!
            let user := getUserByUsername(globalSession, username,
                                          globalSession) orReturn userNotFound!
            return user
        endproc
    )

    if let user := currentUser.await() catch err do
        case largeText!:          ctx.?logger(Error, «The provided username is larger than 4096 characters»); break
        case noSessionAvailable!: ctx.?logger(Error, «Failed to get session»); break
        case failedToCreateUser!: ctx.?logger(Error, «Failed to get user {username}»); break
        return err
    endif

    return user
endproc

module asyncTasks
import «core::tasks.chaos»

