First_Example_Struct :: struct {
    input_1 : string,
    input_2 : string,
    input_3 : u_int64,
    input_4 : bool,

    __string__ :: behavior {
        set "{self.input_1} {self.input_2} {self.input_3} {self.input_4}";
    }
}

Second_Example_Struct :: struct {
    input_1: string = "example init string",
    input_2: string,
    input_3: u_int64 = 0,
    input_4: bool,
}
