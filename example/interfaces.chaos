module exampleInterface;

type SomeInterface scaffold {
    mandatoryFieldOne String;
    mandatoryFieldTwo Bool;
    proc doSomeOperation(*Self impl);
}

type SomeInterface impl Example struct {
    mandatoryFieldOne String;
    mandatoryFieldTwo Bool = false;
    anotherField Bool;
}

#overload proc doSomeOperation(example *Example) {
    self.anotherFieldOne = true;
    return;
}

type SomeInterface impl AnotherExample struct {
    mandatoryFieldOne String = <<>>;
    mandatoryFieldTwo Bool = false;
}

#overload proc doSomeOperation(anotherExample *AnotherExample) {
    mandatoryFieldOne String = <<>>;
    mandatoryFieldTwo Bool = false;
}

proc main() {
    let newExample *SomeInterface impl = &Example {
        mandatoryFieldOne = <<Hello, world>>,
        anotherField = false
    };

    printfn(<<{newExample.mandatoryFieldOne} is {newExample.anotherField}>>);
    doSomeOperation(&newExample);
    printfn(<<{newExample.mandatoryFieldOne} is {newExample.anotherField}>>);

    return;
}

import <<core::fmt::io>>;

