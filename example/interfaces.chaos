module exampleInterface;

type SomeInterface interface {
    mandatoryField String;
    proc doSomeOperation(&self);
}

type Example impl SomeInterface struct {
    mandatoryField String;
    anotherField Bool;
}

#overload proc Example.doSomeOperation(&self) {
    self.annotherField = true;
    return;
}

proc main() {
    let newExample *impl SomeInterface = &Example {
        mandatoryField = <<Hello, world>>,
        anotherField = false
    };

    printfn(<<{newExample.mandatoryField} is {newExample.anotherField}>>);
    newExample.doSomeOperation();
    printfn(<<{newExample.mandatoryField} is {newExample.anotherField}>>);

    return;
}

import core::fmt::io;

