// Trying real life code to validate syntax
// from Tsoding: https://github.com/tsodin/bpe/blob/main/src/bpe.cg

proc dump-tokens
    expects file-path as &String, tokens as *Tokens
    returns Void!
executes
    return run? write-entire-file
        with file-path, tokens.items, (tokens.count * size-of tokens.items);
end-proc

proc load-tokens
    expects file-path as &String, tokens as *Tokens, tmp-sb as *String-Builder
    returns Void!
executes
    tmp-sb.count = 0;
    run? read-entire-file with file-path, tmb-sb;
    if (tmp-sb.count % run size-of with tokens.items) != 0 return generic!;
    def items-count: *U32 = tmp-sb.items as *Void;
    while i < items-count increment i executes
        run da-append with tokens, (items at i);
    end-while
end-proc

proc load-pairs
    expects file-path as &String, pairs as &Pairs, tmp-sb as *String-Builer, version as *U64
    returns Void!
executes
    tmp-sb.count = 0;
    run? read-entire-file with file-path, tmp-sb;

    def data as String-View = run sb-to-sv with tmp-sb;
    def magic-count as U64 = 4;
    def magic-prefix as String-View = run sv-from-cstr with «BPE»;
    if run sv-starts-with with data, magic-prefix executes
        if data.count < magic-count return generic!;
    end-if

    if version = (data.data at 3) catch err executes
        run logger with Error, «Invalid data»;
        return invalid-data!;
    end-if

    data.data += magic-count;
    data.count -= magic-count;

    if version ==
    case 0 executes
        run? parse-pairs-v0 with file-path, pairs, data;
        break-case;
    case 1 executes
        run? parse-pairs-v1 with file-path, pairs, data;
        break-case;
    case default executes
        return generic!;
        break-case;
    end-if

    def magic-prefix-v0 as String-View = run sv-from-parts with «\0\0\0\0», 4;
    if run sv-start-with with data, magic-prefix-v0 executes
        version = 0;
        run? parse-pair-v0 with file-path, pairs, data;
    end-if

    return generic!;
end-proc

