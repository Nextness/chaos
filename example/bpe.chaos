// Trying real life code to validate syntax
// from Tsoding: https://github.com/tsodin/bpe/blob/main/src/bpe.cg

proc dumpTokens(filePath &String, tokens &Tokens) Void! do
    writeEntireFile(filePath, tokens.items, tokens.count*sizeOf(tokens.items)) orReturn
endproc

proc loadTokens(filePath &String, tokens &Tokens, tmpSb &StringBuilder) Void! do
    tmpSb.count = 0;
    readEntireFile(filePath, tmpSb) orReturn
    if tmpSb.count % sizeOf(tokens.items) != 0 do return generic! endif

    let itemsCount &U32 = tmpSb.items.(&Void)
    while i < itemsCount : ++i do daAppend(tokens, items[i]) endwhile
endproc

proc loadPairs(filePath &String, pairs &Pairs, tmpSb &StringBuilder, version &U64) Void! do
    tmpSb.count = 0
    readEntireFile(filePath, tmpSb) orReturn

    let data StringView = sbToSv(tmpSb)
    let magicCount U64 := 4
    let magicPrefix StringView := svFromCstr(«BPE»)
    if svStartsWith(data, magicPrefix) do
        if data.count < magicCount do return generic! endif
    endif

    version = assert data.data[3]
    data.data += magicCount
    data.count -= magicCount

    if version == do
        case 0 do
            parsePairsV0(filePath, pairs, data) orReturn
        endcase
        case 1 do
            parsePairsV1(filePath, pairs, data) orReturn
        endcase
        case default do
            return generic!
        endcase
    endif

    let magicPrefixV0 StringView = svFromParts(«\0\0\0\0», 4)
    if svStartsWith(data, magicPrefixV0) do
        version = 0
        parsePairsV0(filePath, pairs, data) orReturn
    endif

    return generic!
endproc

