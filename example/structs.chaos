type HelloWorld struct
    hello: String;
    world: String = «world!»;
end type

type AnotherHello
    generic T: AnyType
struct
    another: T;
    hello:   String = «world!»;
end type

proc main executes
    let value = new HelloWorld with «Hello,» end new;
    run printfn with «{value.hello} {value.world}»;
    return;
end proc

#module exampleStructs;
#import «core::fmt:io.chaos»;

