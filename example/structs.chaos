type Hello-World struct
    hello as String;
    world as String = «world»;
end-type

type Another-Hello
    generic T
struct
    another as T;
    hello as String = «world!»;
end-type

#[entry-point]
proc main executes
    def value = new Hello-World with «Hello,» end-new;
    run print-fn with «{value.hello} {value.world}»;
    return
end-proc

#module exampleStructs;
#import «core::fmt:io.chaos»;

