module exampleStructs;

type HelloWorld struct {
    hello String;
    world String = <<world!>>;
}

type AnotherHello[T] struct {
    another T;
    hello String = <<world!>>;
}

proc main() {
    let value = HelloWorld{<<Hello,>>};
    printfn(<<{value.hello} {value.world}>>);
    return;
}

import core::fmt:io;

