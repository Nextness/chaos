type HelloWorld struct
    hello String
    world String = «world!»
endtype

type AnotherHello[T] struct
    another T
    hello   String = «world!»
endtype

proc main() do
    let value = HelloWorld{«Hello,»}
    printfn(«{value.hello} {value.world}»)
    return
endproc

