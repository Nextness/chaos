type HelloWorld struct
    hello String
    world String = «world!»
end type

generic T in
type AnotherHello struct
    another T
    hello   String = «world!»
end type

proc main do
    let value = new HelloWorld with «Hello,» end new
    call printfn with «{value.hello} {value.world}»
    return
end proc

