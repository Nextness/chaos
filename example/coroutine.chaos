// Using https://github.com/tsoding/c3ws/tree/main as example...

proc init() do
    ...
endproc

inline proc yield(#noArguments) do
    if compTime.os == «arch» do
        assembly do
            pushq %rdi
            pushq %rbp
            pushq %rbx
            pushq %r12
            pushq %r13
            pushq %r14
            pushq %r15
            movq %rsp, %rdi // rsp
            movq $0, %rsi   // sm = SM_NONE
            jmp coroutine_switch_context
        endassembly
    endif
endproc

