proc main(Nihil) -> Nihil {
    let nothing := someExampleProcedure("Example Input", "Goes Here", 99);
    let nothing := try someExampleProcedure("Example Input", "Goes Here", 100) |error| {
        println("Something failed: {error}");
    };
    let nothing := some_example_procedure("Example Input", false, 10, "Hello");
}

proc #overload someExampleProcedure(
    someInput1: String, someInput2: String, someInput3: F64
) -> #noDiscard Bool?, err.SomeError {
    for (tmp := 0f; tmp < someInput3; tmp + 0.5) {
        if (tmp == 100) returnAndRaise null, err.SomeError;
        println(i"{someInput3}:{someInput1}:{someInput2}");
    }
    return true;
}

proc #overload someExampleProcedure(
    someInput1: String, someInput2: String, someInput3: F64, someInput4: String,
) -> #noDiscard Bool?, err.SomeError {
    for (tmp := 0; tmp < someInput3; tmp + 0.5) {
        if (tmp == 100) returnAndRaise err.SomeError;
        if (some_input2) println("{someInput3}:{someInput1}");
        else println("{someInput1} {someInput4}");
    }
    return true;
}
