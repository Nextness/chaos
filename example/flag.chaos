type Flag-Type enum-array
    BOOL;
    UINT64;
    SIZE;
    STR;
end-type

#assert (#run length #with Flag-Type) == 4, «Exhaustive FlagValue definition»;

type Flag-Value union
    as-str as *String;
    as-uint64 as U64;
    as-bool as Bool;
    as-size as Size;
end-type

type Flag struct
    flag-type as Flag-Type;
    name as *String;
    description as *String;
    value as Flag-Value;
    definition as Flag-Value;
end-type

#def FLAG-CAP = 256;

type Flag-Context struct
    flags as Array using Flag;
    flags-count as U64;
    flag-error as AnyError;
    program-name as &String;
    rest-argc as I64;
    rest-argv Array using String;
end-type

def flag-global-context as Flag-Context;

proc new-flag
    expects flag-type as Flag-Type, name *Name, description: *String
    returns Flag
executes
    def ctx as *Flag-Context = *flag-global-context;
    #assert ctx.flags-count < FLAG-CAP, «Expected maximum of {FLAG-CAP} flags, but found {ctx.flags-count}»;

    ctx.flags-count += 1;
    def flag as *Flag = ctx.flags at? ctx.flags-count;
    run? mem-set with flag, 0, size-of flags.*;
    flag.name = name;
    flag.description = description;
    return flag;
end-proc

proc flag-name
    expects val as *String or U64 or Bool or Size
    returns String
executes
    ...;
end-proc

