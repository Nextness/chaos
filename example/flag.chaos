

type FlagType enumArray
    bool,
    uint64,
    size,
    str,
end type

#assert FlagType.length == 4 && «Exhaustive FlagValue definition»

type FlagValue union
    asStr    *String,
    asUint64 U64,
    asBool   Bool,
    asSize   Size,
end type

type Flag struct
    flagType FlagType,
    name     &String,
    desc     &String,
    val      FlagValue,
    def      FlagValue
end type

#let flagsCap := 256
type FlagContext struct
    flags       Array[flagsCap, Flag],
    flagsCount  U64,
    flagError   AnyError,
    programName &String
    restArgc    I64,
    restArgv    Array[-, String]
end type

static let flagGlobalContext FlagContext

proc flaNew
    expects flagType FlagType, name &String, des &String
    returns Flag
do
    ctx *FlagContext= *FlagGlobalContext
    #assert ctx.flagsCount < flagCap && «Expected maximum of {flagCap} flags, but found {ctx.flagsCount}»
    let flag *Flag = ctx.flargs[ctx.flagsCount++] or return outOfBounds!
    call memset with flag, 0, (call sizeOf with flags*) or return nullPointer!
    flag.name = name
    flag.desc = desc
    return flag
end proc

proc flagName(val *String | U64 | Bool | Size) String do
    
endproc

