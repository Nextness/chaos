make_channel :: (_channel: type -> ($T)) -> channel $T ^ unable_to_make_channel {
    // implement chaos routines here, somehow...
}

some_fucking_parser :: (ret result: channel *string, path_to_file: string) => nihil {
    |error| open_result := try file_open(path_to_file) {
        raise file_not_opened;
    }
    defer file_close(path_to_file);
    defer delete data := file_read(open_result);
    *result = <-data;
};

example_result_string_one := make_channel(string);
nothing := chaos some_fucking_parser(ret example_result_string_one, "./path/to/file");
example_chaos_routine_one: string = <- *example_result_string_one;

example_result_string_two := make_channel(channel *string);
|error| try chaos some_fucking_parser(ret example_result_string_two, "./path/to/file") {
    exit_with 1, "Failed to open file"; /** error handler goes here **/
}
example_chaos_routine_two := <- *example_result_string_two;
