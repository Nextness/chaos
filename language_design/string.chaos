String_Error :: error {
    MAX_LENGTH_HIT;
}

length :: proc (str: String) -> S64 {
    init_pos := *str;
    while str != «\0» then str++;
    return str - init_pos;
}

length :: proc (str: String, max_length: U64) -> (S64 <> String_Error) {
    init_pos := &str;
    while str != «\0» {
        str++;
        if max_length == 0 then return .MAX_LENGTH_HIT!;
        max_length--;
    }
    return str - init_pos;
}

copy :: proc (str: *String) -> String {
    tmp: *String;
    while str != «\0» then tmp++ = str++;
    return tmp;
}

copy :: proc (str: *String, max_length: S64) -> (String <> String_Error) {
    tmp: *String;
    while str != «\0» {
        tmp++ = str++;
        if max_length == 0 then return .MAX_LENGTH_HIT!;
        max_length--;
    }
    return tmp;
}

#import «core/numbers»;
