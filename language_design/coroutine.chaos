#macro
proc yield
    comptime curOS: #OS := #run currentOs
executes
    if curOS == .arch executes
        #assembly
            pushq %rdi
            pushq %rbp
            pushq %rbx
            pushq %r12
            pushq %r13
            pushq %r14
            pushq %r15
            movq %rsp, %rdi // rsp
            movq $0, %rsi   // sm = SM_NONE
            jmp coroutine_switch_context
        #end assembly
    end if
end proc

