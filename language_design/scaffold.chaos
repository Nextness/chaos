Some_Interface :: scaffold <T> {
    mandatory_field_1: String;
    mandatory_field_2: T;
    do_some_operation: proc (*impl Self) -> Void!;
}

Example :: struct impl Some_Interface <T: Type> {
    mandatory_field_1: String;
    mandatory_field_2: T;
    another_field: Bool;
}

do_some_operation :: proc (example: *Example) -> Void! {
    example.mandatory_field_1 = «»;
    example.mandatory_field_2 = #0;
}

#entry main :: proc -> Void {
    new_example := Example.{
        mandatory_field_1 = «Hello world», mandatory_field_2 = true
    };

    print(«{new_example.*.mandatory_field_1} is {new_example.*.another_field}»);
    new_example.do_some_operation();
    print(«{new_example.*.mandatory_field_1} is {new_example.*.another_field}»);

    return;
}

#module exampleScaffold;
#import «core::fmt::io.chaos»;

