@new_test_suite(tear_up, tear_down) {
first_test_suit :: test (tear_up: Tear_Up, tear_down: Tear_Down) {
    first_test_name :: proc (t: *Unit_Test) {
        something :: some_condition_must_happen(«abc»);
        assert something, «Expected something to have a value, but it doesn't...»;
    }

    second_test_name :: proc (t: *Unit_Test) {
        some_confidition_must_happen(«ab») unless {
            return assert true; /** Error is expected, do nothing **/
        }
        assert false, «Expected an error, but found nothing»;
    }
}
}
