/** -- Explanation --
 *  Perform Sha3 using '<nameOfEnum>.<value>' and get the first 64 bits starting fromthe begining.
 *  At comp time sha3(AnotherEnum.somethingInHere) is 1cc2a66e347661378dde3fc074c46e...
 *  When we call AnotherEnum.somethingInHere we will have 482518638 [1cc2a66e3]
**/
Another_Enum :: enum {
    SOMETHING_IN_HERE: S64 = iota;
    ANOTHER_THING_HERE;
    YET_ANOTHER_THING_IS_HERE;
}

Random_Error :: error {
    GENERIC;
    FAILED_TO_GENERATE_STRING;
    INVALID_STATUS_CODE;
    OPERATION_FAILED;
}

Json_Response <T: Type> :: struct {
    status_code: U32 = #0;
    content:     T   = #0;
}

something_crazy :: proc (json: *Json_Response, status_code: U32) -> (Void <> Random_Error) {
    if status_code > 400 then return .INVALID_STATUS_CODE!;
    json.status_code = status_code;
}

response := Json_Response<String>.{};
result :: #run something_crazy(response, 401);
ifl result catch err {
    exit 1;
}

Some_Struct :: struct {
    username: String;
    password: String; &redacted
}

some_struct := Some_Struct.{
    username = «username»,
    password = get_env_var(«ENV_VAR_NAME», «None»)?,
};

Another_Redacted :: struct {
    id       &redacted: U64;
    username &redacted: String;
    password &redacted: String;
}

redacted :: Another_Redacted.{10, «username», «some_password»};
print(«{redacted.reveal()}»);

#entry main :: proc -> (U64 <> Error) {
    window := initialize_with(100, 100, «Window») unless catch err {
        print(«Something went wrong in here - {error}»);
        return 1;
    }
}

loop_with_label :: proc -> Bool! {
    'loop while x: 0..10 {
        while y: 0..10 {
            operation() unless catch err {
                logger.log(ERROR, «The operation failed - reason: {err}»);
                break 'loop;
            }
        }
        return something;
    }
    return .OPERATION_FAILED!;
}

complex: C64 = c«100 + 10i» * c«10»; // result should be c'1000 + 100i'
complex_2: C64 = c«1-i» * c«1+i»; // result shoulb be c'2'
a: Q256 = q«1 - 2i + j - 0.1k»;


handling_errors :: proc (some_input_1: Bool, some_input_2: String) -> (Void <> Random_Error) {
    #local some_result, err;

    if some_input_1 {
        some_result := optional_operation_with_possible_error() unless catch err {
            print(«{some_input_2} has failed: {err}\n»);
            return .GENERIC!;
        }
        return;
    }

    some_result := operation_with_possible_error() unless catch err {
        print(«{some_input_2} has failed: {err}\n»);
        return .GENERIC!;
    }
    print(«{some_input_2} was successful\n»);

    return;
}

handling_error(true, «something»)?;

#inline is_falsy :: proc (value: Any, other_checks: *proc? (Any) -> Bool = null) -> Bool {
    if type_of value == {
        case String   then return self == «»;
        case [dyn]Any then return self.length() == 0;
        case [?]Any   then return self.count == 0;
    }
    if other_checks != null then return other_checks(value);
    return false;
}

#inline is_truthy :: proc (value: Any, other_checks: *proc? (Any) -> Bool = null) -> Bool {
    return !is_falsy(value, other_checkes = other_checks);
}

get_ownership :: proc (input1: *String?, input2: *Some_Struct?) -> (*Another_Struct <> Error) {
    if input1 != null then input1 = «undefined»;

    value_b := malloc(Another_Struct) unless catch err {
        print(«Failed to allocate memoery: {err.reason}»);
        return err;
    }
    err_defer free(value_b);

    if input2 == null {
        value_b = more_operations(input1, input2) unless catch err {
            print(«Something failed here: {err.reason}»);
            return .FAILED_TO_GET_OWNERSHIP!;
        }
    }

    return value_b;
}

capture_groups :: proc (something: String, another_thing: *New_Struct) -> *Another_Struct {
    another_crazy_op :: proc (s: String) |another_thing| -> Bool {
        ...;
    }

    if another_crazy_op(something) {
        ...;
    }
}

String_Limit :: constraint (L: Logger) {
    MAX_SIZE :: 4096;
    if length(string(this)) >= MAX_SIZE {
        log(.ERROR, L, «String length must be less than {MAX_SIZE}»);
        assert false;
    }
}

some_proc_with_generic <K: "String" | impl string> :: proc (
    input1: Bool,
    input2: K with String_Limit(Current_Logger)
) -> (result: *String <> err: Random_Error) {
    return ifx input1 then *string(input2)
           else .FAILED_TO_GENERATE_STRING!;
}

some_proc_with_generic <K: "String" | impl string> :: proc (
    input1: Bool, input2: K \ String_Limit(Current_Logger)
) -> *String | Random_Error {
    if input1 then return *string(input2);
    return .FAILED_TO_GENERATE_STRING!;
}

some_proc_with_generic(true, Some_Struct_With_String_Proc.{})?;
some_proc_with_generic<String>(true, «something»)?;
some_proc_with_generic<Struct_Without_String_Proc>(true, Struct_Without_String_Proc.{})?; // Compilation error

#scope = «file»;

#import «allocator»;
#import «logger»;
num :: #import «numbers»;
ray :: #import «raylib» as #h;

#let(«cto») WINDOW_CONTEXT_COUNT := 0;
new_window_context :: macro (body: #Scope_Proc, window_should_close := ray.WindowShouldClose, close_window := ray.CloseWindow) {
    #hook(what = #current_macro_name, triggered_when = «called») {
        #if WINDOW_CONTEXT_COUNT == 0 WINDOW_CONTEXT_COUNT++;
        #else #compile_error(«You can't have nested Window Contexts»);
        #defer WINDOW_CONTEXT_COUNT--;
    }

    while !window_should_close() then `body;
    close_window();
}

#let «cto» DRAWING_CONTEXT_COUNT := 0;
new_draw_context :: macro (body: #Scope_Proc_Like, begin_drawing := ray.BeginDrawing, end_drawing := ray.EndDrawing) {
    #hook(what = #current_macro_name, triggered_when = «called») {
        #if DRAWING_CONTEXT_COUNT == 0 DRAWING_CONTEXT_COUNT++;
        #else #compile_error(«You can't have nested Drawing Contexts»);
        #defer DRAWING_CONTEXT_COUNT--;
    }

    begin_drawing();
    `body;
    end_drawing();
}

some_weird_macro :: macro #ast {
    #when '[' 'identifier' ']' {
        #set 'identifier' := «Weird shit»;
    }
}

@some_weird_macro(something);

#entry main :: proc -> S64 {
    scren_width, screen_height :: 800, 450;

    ray.InitWindow(scren_width, screen_height «raylib from chaos»);
    ray.SetTargetFPS(60);

    @new_window_context() {
        @new_draw_context() {
            ray.ClearBackground(ray.RAYWHITE);
            ray.DrawLineEx(ray.Vector2.{ 0, 0 }, ray.Vector2.{ screenWidth, screenHeight }, 2.0, ray.RED);
            ray.DrawLineEx(ray.Vector2.{ 0, screenHeight }, ray.Vector2.{ screenWidth, 0 }, 2.0, ray.RED);
            ray.DrawText(«example base code template», 260, 400, 20, ray.LIGHTGRAY);
        }
    }

    return 0;
}



New_Struct <K: Any> :: scaffold {
    something: String;
    another: K;

    impl {
        do_something <V: String | U64> :: proc (String, Bool, Self, Self.K) -> (Bool <> Error);
    }
}

Another_Struct <V: String | F32> :: scaffold {
    first_field: V;
    second_field: String;

    impl {
        another_thing :: proc (*Self, Self.V) -> String;
    }
}

The_Struct <K: Any, V: String | F32> :: struct {
    #base New_Struct {
        something: String;
        another: K;
    }
    #base Another_Struct {
        first_field: V;
        second_field: String;
    }
}

New_Struct impl {
    do_something <V: String | U64> :: proc (input1: String, input2: Bool, input3: Self, input4: Self.K) -> (Bool <> Error) {

    }
}

do_something<String>(...);

