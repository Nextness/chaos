/** -- Explanation --
 *  Perform Sha3 using '<nameOfEnum>.<value>' and get the first 64 bits starting fromthe begining.
 *  At comp time sha3(AnotherEnum.somethingInHere) is 1cc2a66e347661378dde3fc074c46e...
 *  When we call AnotherEnum.somethingInHere we will have 482518638 [1cc2a66e3]
**/
Another_Enum :: enum {
    SOMETHING_IN_HERE : #unique = iota;
    ANOTHER_THING_HERE;
    YET_ANOTHER_THING_IS_HERE;
}

Json_Response :: struct <T: Type> {
    status_code: U32? = #0; #tag(«json:status_code»)
    content:     T    = #0; #tag(«json:content»)
}

something_crazy :: proc (json: *Json_Response, status_code: U32) -> Void! {
    if status_code > 400 then return "invalid_status_code";
    json.status_code = status_code;
}

response := Json_Response<String>.{};
result :: something_crazy(response, 401) unless |error| {
    exit 1;
}

reveal :: proc (value: Any) -> String {
    result := «<redacted>»;
    #if chaos_flags.CHAOS_DEBUG {
        result = to_string(value);
    }
    return result;
}

Some_Struct :: struct {
    username: String;
    password: String #redacted;
}

some_struct := Some_Struct.{
    username = «username»,
    password = get_env_var(«ENV_VAR_NAME», «None»)?,
};

Another_Redacted :: struct #redacted {
    id:       U64;
    username: String;
    password: String;
}

redacted :: Another_Redacted.{10, «username», «some_password»};
print(«{redacted.reveal()}»);

#entry main :: proc (Void) -> U64! {
    window := initialize_with(100, 100, «Window») unless |error| {
        print(«Something went wrong in here - {error}»);
        return 1;
    }
}

loop_with_label :: proc -> Bool! {
    loop: while x: 0..10 {
        while y: 0..10 {
            operation() unless |error| {
                logger.log(ERROR, «The operation failed - reason: {error.reason}»);
                break loop;
            }
        }
        return something;
    }
    return "operation_failed - Because you suck!";
}

complex: C64 = c'100 + 10i' * 10; // result should be c'1000 + 100i'
complex_2: C64 = c'1-i' * c'1+i'; // result shoulb be c'2'
a: Q256 = q'1 - 2i + j';


// Think about a way to track allocations and deallocations during compilation
#global allocator_count :: 0;
#global list_of_functions_with_allocator :: Array[Proc_Details].{};

new_variable :: .{ key=«asd», value=100 };

Allocator :: scaffold {
    malloc:  proc (~size: U64) -> *Void!;
    calloc:  proc () -> *Void;
    realloc: proc () -> *Void;
    free:    proc (~val: *AnyType) -> Void!;
}

Allocator :: struct impl Default_Allocator {}

Default_Allocator.malloc = proc (size: U64) -> *Void! {
    
}

Default_Allocator.free = proc (val: *AnyType) -> Void! {
    
}


Allocator impl Allocator_With_Info :: struct {
    internal_memory: U64 = 0;

    malloc := default;
    calloc := default;
    realloc := default;
    free := default;
    another_operation: proc (self: *Self) -> I64!;
}

Allocator_With_Info.malloc = proc (size: U64) -> *Void! {
    #not_implemented
}

Allocator_With_Info.free = proc (val: *AnyType) -> Void! {
    #not_implemented
}

Allocator_With_Info.another_operation :: proc (self: *Self) -> Void!{
    #not_implemented
}

something := Allocator_With_Info(internal_memory = 0);
result := something.malloc(100)?;
something.another_operation() unless |error| {
    
}

