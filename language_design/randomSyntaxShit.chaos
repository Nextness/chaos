    return null;
}

generic_error :: error;

handling_errors :: proc (some_input_1: Bool, some_input_2: String) -> Void! {
    some_result: U64!;

    if some_unput_1 {
        some_result = optional_operation_with_possible_error();
        if catch some_result |err| {
            print(«{some_input_2} has failed: {err}\n»);
            return generic_error!;
        }
        return;
    }

    some_result = operation_with_possible_error() unless |err| {
        print(«{some_input_2} has failed: {err}\n»);
        return generic_error!;
    }
    print(«{some_input_2} was successful\n»);

    return;
}

handling_error(true, «something»)?;

#inline is_falsy :: proc (value: Any, other_checks: *proc? (Any) -> Bool = null) -> Bool {
    if type_of(value)      == String   then return self == «»;
    if type_of(value)      == [dyn]Any then return self.length() == 0;
    if type_of(value)      == [?]Any   then return self.count == 0;
    if other_checks(value) != null     then return other_checks(value);
    return false;
}

#inline is_truthy :: proc (value: Any, other_checks: *proc? (Any) -> Bool = null) -> Bool {
    return !is_falsy(value, other_checkes = other_checks);
}

get_ownership :: proc (input1: *String?, input2: *Some_Struct?) -> Addr<Another_Struct>! {
    input1 ?= «undefined»;

    value_a, value_b: New_Struct = #0;
    value_b: *Another_Struct? = malloc(size_of Another_Struct, zero_initialize = true) unless |error| {
        print(«Failed to allocate memoery: {error.reason}»);
        return error;
    }

    if input2 == null {
        value_a :: do_a_bund_of_operations();
        value_b :: more_operations(a) unless |error| {
            print(«Something failed here: {error.reason}»);
            return failed_to_get_ownership!;
        }
    }

    return &value_b;
}

capture_groups :: proc (something: String, another_thing: *New_Struct) -> *Another_Struct {
    another_crazy_op :: proc (s: String) |another_thing| -> Bool {
        ...;
    }

    if another_crazy_op(something) {
        ...;
    }
}

failed_to_generate_string :: error;

String_Limit :: constraint <L: Logger> {
    #inline MAX_SIZE :: 4096;
    if length(it) >= MAX_SIZE {
        log(Err, Logger, «String length must be less than {MAX_SIZE}»);
        assert false;
    }
}

some_proc_with_generic :: proc <K: "String" | impl string> (input1: Bool, input2: K \ String_Limit<Current_Logger>) -> *String! {
    if input1 then return *string(input2);
    return failed_to_generate_string!;
}

some_proc_with_generic(true, Some_Struct_With_String_Proc.{})?;
some_proc_with_generic<String>(true, «something»)?;
some_proc_with_generic<Struct_Without_String_Proc>(true, Struct_Without_String_Proc.{})?; // Compilation error

