// Numbers
Any_Integer :: S8 | S16 | S32 | S64 | S128;

Any_UInteger :: U8 | U16 | U32 | U64 | U128;

Any_Float :: F16 | F32 | F64 | F128;

Any_Complex :: C64 | C128;

Any_Quaternion :: Q128 | Q256;

Any_Natural :: Any_Integer | Any_UInteger;

Any_Real :: Any_Natural | Any_Float;

Any_Number :: Any_Real | Any_Complex | Quaternion;

Matrix <T: "{Any_Number}", R: "{Any_Natural}", C: R.V> :: struct {
    #while r: 1..R+1 {
        #insert «row_{r}: [{C}]{T};\n»;
    }
}

Vector :: struct <T: Any_Number> {
    x, y: T;
}

#module types;

