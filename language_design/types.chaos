// Numbers

Ints       :: type_union { S8   | S16 | S32 | S64 | S128; }
UInts      :: type_union { U8   | U16 | U32 | U64 | U128; }
Floats     :: type_union { F16  | F32 | F64 | F128; }
Complex    :: type_union { C64  | C128; }
Quaternion :: type_union { Q128 | Q256; }

Natural    :: type_union { Ints    | UInts; }
Real       :: type_union { Natural | Floats; }
Any_Number :: type_union { Real    | Complex | Quaternion; }

Matrix :: struct <T: Any_Number, R: Literal<Natural>, C: R> {
    #while r: 1..R+1 {
        #insert «row_{r}: [{C}]{T};\n»;
    }
}

Vector :: struct <T: Any_Number> {
    x, y: T;
}

#module types;

