// Got from https://github.com/biaofuxmu/linked_list/blob/master/double_list/double_list.c
// to use as example

#inline length :: proc (dll: *Double_Linked_List) -> U64 {
    return dll.*.count as U64;
}

#inline head :: proc (dll: *Double_Linked_List) -> *Node! {
    return dll.head != null ? dll.head : "null_pointer";
}

#inline tail :: proc (dll: *Double_Linked_List) -> *Node! {
    return dll.tail != null ? dll.tail : "null_pointer";
}

print :: proc (dll: *Double_Linked_List) -> Void {
    node: *Node = dll.head;
    while i: 0..dll.count {
        pad := i * 2;
        io.print(«{pad:node.data}»);
        node = node.next;
    }
}

Double_Linked_List :: struct <C: num.Ints, T: Type> {
    count: C = #0;
    head: *Node<T>?;
    tail: *Node<T>?;
}

Node :: struct <T: Type> {
    data: *T;
    prev: *Node<T>?;
    next: *Node<T>?;
}

Err : Named_Scope : {
    out_of_memory :: error <D: #ct String> {
        name := «Out of memory»;
        reason := «Some reason for the error»;
        details := D;
    }
}

init_node :: proc <T> -> *Node<T>! {
    new_node: *Node<T> = alloc(size_of Node<T>) unless |err| {
        logger(logger_state, .ERROR, «Failed to allocate node - {err}»)
        return Err.@out_of_memory;
    }

    logger(logger_state, .TRACE, «Allocated memory for node: {new_node.address}»);
    return new_node;
}

push_head :: proc (node: *Node, data: Node.T) -> Void! {
    new_node := init_node(data) unless |err| {
        if err == Err.@out_of_memory then return report_oom(err);
        else return err;
    }
    if dll.count == 0 {
        dll.head = newNode;
        dll.tail = newNode;
    } else {
        new_node.next = dll.head;
        dll.head.prev = new_node;
        dll.head = newNode;
    }
    dll.count++;
}

insert_node :: proc (node: *Node, data: Node.T, index: U64) -> Void! {
    if index < 0 || index > dll.count {
        return "out_of_bounds: doesn't know how to measure...";
    }

    if index == 0           then return push_head(dll, data);
    elif index == dll.count then return push_tail(dll, data);

    tmp: *Node<Node.T>;
    if index <= (dll.count / 2) then
        while i: 0..index then
            tmp = tmp.next;
    else then
        while i: 0..dll.count then
            tmp = tmp.prev;

    new_node := init_node(data)?;
    tmp.next.prev = new_node;
    new_node.next = tmp.next;
    tmp.next = new_node;
    new_node.prev = tmp;
    dll.count++;
}

delete_head :: proc (dll: *Double_Linked_List) -> Void! {
    #todo;
}

#module doubleLinkedList;

