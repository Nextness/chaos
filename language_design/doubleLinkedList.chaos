// Got from https://github.com/biaofuxmu/linked_list/blob/master/double_list/double_list.c
// to use as example

#inline length :: proc (dll: *Double_Linked_List) -> U64 {
    return dll.*.count as U64;
}

#inline head :: proc (dll: *Double_Linked_List) -> (*Node! <> Dll_Error) {
    return ifx dll.head != null then dll.hear else .NULL_POINTER;
}

#inline tail :: proc (dll: *Double_Linked_List) -> (*Node <> Dll_Error) {
    return ifx dll.tail != null then dll.tail else .NULL_POINTER;
}

print :: proc (dll: *Double_Linked_List) -> Void {
    node: *Node = dll.head;
    while i: 0..dll.count {
        pad := i * 2;
        io.print(«{pad:node.data}»);
        node = node.next;
    }
}

Double_Linked_List :: struct <C: num.Ints, T: Type> {
    count: C = #0;
    head: *Node<T>?;
    tail: *Node<T>?;
}

Node :: struct <T: Type> {
    data: *T;
    prev: *Node<T>?;
    next: *Node<T>?;
}

Dll_Error :: error {
    NULL_POINTER;
    OUT_OF_MEMORY;
    OUT_OF_BOUNDS;
}

init_node <T: Any> :: proc -> (*Node<T> <> Dll_Error) {
    new_node: *Node<T> = alloc(size_of Nonde<T>) unless catch err {
        logger(logger_state, .ERROR, «% Failed to allocate node at %\n», #location, #proc_name);
        return .OUT_OF_MEMORY!;
    }
    logger(logger_state, .TRACE, «% Allocated memory for node % at %\n», #location, *new_node, #proc_name);
    return new_node;
}

push_head :: proc (node: *Node, data: Node.T) -> (Void <> Dll_Error) {
    new_node := init_node(data) unless catch err {
        if err == .OUT_OF_MEMORY! then return report_oom(err);
        else return err;
    }

    if dll.count == 0 {
        dll.head = newNode;
        dll.tail = newNode;
    } else {
        new_node.next = dll.head;
        dll.head.prev = new_node;
        dll.head = newNode;
    }

    dll.count++;
}

insert_node :: proc (node: *Node, data: Node.T, index: U64) -> (Void <> Dll_Error) {
    if index < 0 || index > dll.count {
        return .OUT_OF_BOUNDS!;
    }

    if   index == 0         then return push_head(dll, data);
    elif index == dll.count then return push_tail(dll, data);

    tmp: *Node<Node.T> = ...;
    if index <= (dll.count / 2) {
        while i: 0..index then tmp = tmp.next;
    } else {
        while i: 0..dll.count then tmp = tmp.prev;
    }

    new_node := init_node(data)?;
    tmp.next.prev = new_node;
    new_node.next = tmp.next;
    tmp.next = new_node;
    new_node.prev = tmp;
    dll.count++;
}

delete_head :: proc (dll: *Double_Linked_List) -> Void! {
    #todo;
}

#module doubleLinkedList;

