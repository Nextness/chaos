Flag_Type :: enum_array {
    BOOL;
    UINT64;
    SIZE;
    STR;
}
#assert length(Flag_Type) == 4, «Exhaustive FlagValue definition»;

Flag_Value :: union {
    as_str: String;
    as_uint64: U64;
    as_bool: Bool;
    as_size: Size;
}

Flag :: struct {
    flag_type: Flag_Type;
    name: *String;
    description: *String;
    value: Flag_Value;
    definition: Flag_Value;
}

FLAG_CAP :: 256;

Flag_Content :: struct {
    flags:        [dyn]Flag;
    flags_count:  U64;
    flag_error:   Error;
    program_name: &String;
    rest_argc:    S64;
    rest_argv:    [dyn]String;
}

flag_global_context: Flag_Context;

new_flag :: proc (flag_type: Flag_Type, name: Name, description: String) -> Flag! {
    ctx := flag_global_context;
    assert ctx.flags_count < FLAG_CAP, «Expected maximum of {FLAG_CAP} flags, but found {ctx.flags_count}»;

    ctx.flags_count++;
    flag: *Flag = ctx.flags[flags_count]?;
    mem_set(flag, 0, size_of flags);
    flag.name = name;
    flag.description = description;
    return flag;
}

