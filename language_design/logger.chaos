Logger_Level :: enum_array {
    trace: U64;
    debug;
    info;
    warning;
    error;
    critical;
    disabled;
}

Log :: scaffold {
    date_format: String = «%YEAR-%MONTH-%DAY %hour:%minute:%second»;
    output: Array<dyn, Stream> = (STD_OUT);
    include_os_name: Bool = false;
    log_level: ...? = undefined;
    log: proc (*Impl, Enum_Array<U64>, String) -> Void;
}

Log.Logger :: struct {
    date_format := default;
    output := default;
    include_os_name := default;
    log_level: Logger_Level = .info;
}

Logger.log :: proc (self: *Self, log_level: Logger_Level, message: String) {
    #if? self.log_level < log_level {
        #optimize_out;
    }
}

#module logger;
#let io = #import «core::fmt::io.chaos»;

