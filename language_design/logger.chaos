Logger_Level :: enum_array {
    TRACE: U64;
    DEBUG;
    INFO;
    WARNING;
    ERROR;
    CRITICAL;
    DISABLED;

}

Log :: scaffold {
    date_format: String = «%YEAR-%MONTH-%DAY %hour:%minute:%second»;
    output: [dyn]Stream = [STR_OUT];
    include_os_name: Bool = false;
    log_level: Logger_Level = .WARNING;

    impl {
        log :: proc (~self: Self, ~log_level: Enum_Array<U64>, ~msg: String);
    }
}

Log_State :: struct {
    #base Log;
    date_format := #0;
    output := #0;
    include_os_name := #0;
    log_level := .INFO;
}

Log_State impl {
    log :: proc (~self log_state: *Log_State, ~log_level level: Logger_Level, ~msg message: String) {
        print(«{message}»);
    }
}

#import «fmt»;

