compile_chaos :: proc (filepath: String, src: [dyn]Byte) -> Void | Error {
    file_content := newBuffer(src)?;
    tokens_slice := chaos_content_tokenize(file_content)?;
    program, scope := chaos_content_ast(&token_slice)?;
    chaos_infer_and_check_type(program, scope)?;
    buffer := chaos_code_gen(program, scope)?;

    program_name := «main.asm»;
    create_file_if_not_exist(program_name)?;
    file := open_file(program_name)?;
    defer close_file(file);

    write_buffer(buffer, file)?;
}

main :: proc (argc: U64, argv: ...String) {
    program_name := argv[0]?;

    if argc <= 1 {
        fprintf(.STD_ERR, «[ERROR] Failed to load the program {program_name}\n»);
        printf(«Usage: {program_name} <file.chaos>\n»);
        exit 1;
    }

    while i: 1..argc {
        if suffix_match(argv[i], «.chaos») {
            
        }
    }
}

#entry main :: proc {
    go_rebuild_yourself_tek();

    build_dir :: «./../build/»;
    os.stat(build_dir) unless catch {
        os.mkdir(build_dir) unless catch err {
            print(«Failed to create directory '{build-dir}' because of {err}», stream=.STR_ERR);
            return 1;
        }
    }

    main :: «./chaos.chaos»;
    program_name :: assert argv[0];
    other_args :: argv[1..] unless catch err {
        print(«Failed to get other args because of {err}», stream=.STR_ERR);
        return 1;
    }

    new_command := init_new_command();
    defer de_init(new_command);

    if length(other_args) <= 0 {
        append(new_command, «chaosc build -o {build_dir} {main}»);
        run_and_reset(new_command) unless catch err {
            print(«Failed to run command {new_command} because of {err}»);
            return 1;
        }
        return 0;
    }

    while arg: other_args {
        if arg == «default» {
            default_file_chaos :: «./assignment.chaos»;
            append(new_command, «chaosc build -o {build_dir} {main} && ./../build/main»);
            run_and_reset(new_command) unless catch err {
                print(«Failed to run command {new_command} because of {err}»);
                return 1;
            }
        } else {
            print(«Unknown command '{arg}'», stream=.STR-ERR);
            print(«Usage: {program_name} [default]»)
            return 1;
        }
    }

    return 0;
}

main :: proc (argc: U64, argv: ...String) -> U64 {
    go-rebuild-your-self-tek();

    build-dir :: «./../build/»;
    os.stat(build-dir) unless error {
        os.mkdir(build-dir) unless error {
            print(«Failed to create directory '{build-dir}' because of {err}», stream=os.STR-ERR);
            return 1;
        }
    }

    main :: «./chaos.chaos»;
    program-name :: assert argv[0];
    other-args :: argv[1..] unless error {
        print(«Failed to get other args because of {err}», stream=os.STR-ERR);
        return 1;
    }

    new-command := init-new-command();
    defer de-init(new-command);

    if length(other-args) <= 0 {
        append(new-command, «chaosc build -o {build-dir} {main}»);
        run-and-reset(new-commands) unless error {
            print(«Failed to run command {string(new-command)} because of {err}»);
            return 1;
        }
        return 0;
    }

    while arg in other-args {
        if arg == «default» {
            default-file-chaos :: «./assignment.chaos»;
            append(new-command, «chaosc build -o {build-dir} {main} && ./../build/main»);
            run-and-reset(new-command) unless error {
                print(«Failed to run command {string(new-command)} because of {err}»);
                return 1;
            }
        } else {
            print(«Unknown command '{arg}'», stream=os.STR-ERR);
            print(«Usage: {program-name} [default]»)
            return 1;
        }
    }

    return 0;
}



go-rebuild-your-self-tek :: proc -> Void {
    build-source-path :: «./../chaosBuild.go»;
    time-src := touch-file(build-source-path) unless error {
        print(«Unable to touch file '{build-source-path}' because of {err}», stream=os.STD-ERR);
        exit 1;
    }

    build-bin-path :: «./../chaosBuild»;
    time-bin := touch-file(build-bin-path) unless error {
        print(«Unable to touch file '{build-bin-path}' because of {err}», stream=os.STR-ERR);
        exit 1;
    }

    if time-src == time-bin {
        if error from os.stat(build-bin-path) {
            print(«File '{build-bin-path}' not found. Skipping renaming...»);
        } else {
            old-file :: «{build-bin-path}.old»;
            print(«Renaming {build-bin-path} to {old-file}»);
            assert os.rename(build-bin-path, old-file);
            assert os.remove(old-file);
        }
    }

    new-command := assert init-new-command();
    defer de-init(new-command);

    append(new-command, «chaosc build {build-source-path}»);
    if error from run-and-reset(new-command) {
        exit 1;
    }

    go-rebuild-your-self-tek();
}

