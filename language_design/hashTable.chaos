// Copied from https://github.com/benhoyt/ht/blob/master/ht.c
// Probably it doesn't work - used just to evaluate language. Most likely things will change...

generic_error :: error;
out_of_memory :: error;
not_found :: error;

iterator :: proc (hash_table: *Hash_Table) -> Hash_Table_Iterator {
    return Hash_Table_Iterator(hash_table, 0);
}

Entry :: struct <K: Type, V: Type> {
    key: K;
    value: V;
}

Hash_Table :: struct <K: Type, V: Type> {
    entries: *Entry<K, V>;
    capacity: U64 = 256;
    size: U64 = 0;
}

init_hash_table :: proc <K: Type, V: Type> (logger_state: *Logger_State) -> *Hash_Table<K, V>! {
    table: *HT = malloc(size_of Hash_Table<K, V>) unless |err| {
        logger(logger_state, .ERROR, «Failed to allocate memory, buy more RAM»);
        return out_of_memory!;
    }
    err_defer free(table);

    entry.table = calloc(table.capacity, size_of Entry<K, V>) unless |err| {
        logger(logger_state, .ERROR, «Failed to allocate memory, buy more RAM»);
        return out_of_memory!;
    }

    return table;
}

destroy :: proc (using hash_table: *Hash_Table) -> Void! {
    while i: 0..capacity then ctx.free(entry[i]?.key as Addr);
    free(entries);
    free(hash_table);
}

get :: proc (using hash_table: Hash_Table, key: hash_table.Key) -> hash_table.Value! {
    hash :: hash_key(key);
    i := hash && (capacity - 1);

    while has_key in entry {
        if has_key == null then break;
        if key == has_key.key then return has_key.value;
    }

    return not_found!;
}

expand :: proc (using hash_table: *Hash_Table) -> Void! {
    new_capacity :: capacity * 2;
    if new_capacity < capacity then return "overflow";

    new_entry := calloc(new_capacity, size_of Entry[Hash_Table.V])?;
    while i: 0..capacity {
        local_entry :: entry[i]?;
        if key != null then set_entry(new_entry, new_capacity, key, value, null);
    }

    entry = new_entry;
    capacity = new_capacity;
}

set :: proc (using hash_table: *Hash_Table, key: Hash_Table.K, value: Hash_Table.V) -> Hash_Table.K! {
    if size >= capacity / 2 then expand(hash_table)?;
    key :: set_entry(entry, capacity, key, value, size);
    return key;
}

next :: proc (using hash-table: *Hash-Table, it: *Hash-Table-Iterator) -> Void! {
    table := it.table;
    while i: it.index..capacity {
        item :: entry[i]?;
        if item.key != undefined {
            it.key = item.key;
            it.value = item.value;
            return;
        }
    }
    return @out_of_bounds;
}

#[scope=«file»];
fnv-off-set :: 14695981039346656037;
fnv-prime   :: 1099511628211;

has_key :: proc <Key, Value> (key: *Key) -> Value {
    hash := fnt_off_set;
    tmp := key;

    while i: 0..tmp.length() {
        current_char := tmp[i];
        hash ^= current-char as U64;
        hash *= fnv_prime;
    }

    return hash;
}

set_entry :: proc (using entry: Entry, capacity: U64, key: *Entry.K, value: Entry.V, size: *U64?) -> Entry.K {
    i := has_key(key) && (capacity - 1);

    while true {
        cur_entry := entry[i]?;
        if cur_entry.key == null then break;
        if cur_entry.key == key {
            cur_entry.value = value;
            return cur_entry.key;
        }
        i++;
    }

    if size == null {
        key = strdup(key);
        (size.*)++;
    }

    cur_entry := entry[i]?;
    cur_entry.key = key;
    cur_entry.value = value;
    return key;
}

#module hashTable;
#def mem := #import «core::allocators.chaos»;

