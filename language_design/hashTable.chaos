// Copied from https://github.com/benhoyt/ht/blob/master/ht.c
// Probably it doesn't work - used just to evaluate language. Most likely things will change...

Hash_Table_Error :: error {
    GENERIC;
    OUT_OF_MEMORY;
    NOT_FOUND;
    OUT_OF_BOUNDS;
}

iterator <hash_table: *Hash_Table> :: macro -> Hash_Table_Iterator {
    #set Hash_Table_Iterator.{hash_table, 0};
}

Entry <K, V: Type> :: struct {
    key:   K;
    value: V;
}

Hash_Table <K, V: Type> :: struct {
    entries:  *Entry<K, V>;
    capacity: U64 = 256;
    size:     U64 = 0;
}

init_hash_table <K, V: Type> :: proc (logger_state: *Logger_State) -> (*Hash_Table<K, V> <> Hash_Table_Error) {
    table := malloc(Hash_Table<K, V>) unless catch {
        logger(logger_state, .ERROR, «Failed to allocate memory, buy more RAM»);
        return .OUT_OF_MEMORY!;
    }
    err_defer free(table);

    table.entries = calloc(table.capacity, size_of(Entry<K, V>)) unless catch {
        logger(logger_state, .ERROR, «Failed to allocate memory, buy more RAM»);
        return .OUT_OF_MEMORY!;
    }

    return table;
}

destroy :: proc (using hash_table: *Hash_Table) -> (Void <> Hash_Table_Error) {
    while i: 0..size {
        current_entry := entry[i] unless {
            return .GENERIC!;
        }
        free(*currenty_entry.key);
    }
    free(entries);
    free(hash_table);
}

#operator [] :: proc (hash_table: *Hash_Table, key: hash_table.K) -> (hash_table.V <> Hash_Table_Error) {
    hash := hash_key(key);
    i := hash && (capacity - 1);

    while i: 0..size {
        e := entries[i] unless return .GENERIC!;
        if e.key == null || has_key == null then break;
        if key == has_key.key then return has_key.value;
    }

    return .NOT_FOUND!;
}

#operator []= :: proc (hash_table: *Hash_Table, key: hash_table.K, value: hash_table.V) -> (hash_table.V <> Hash_Table_Error) {
    hash := hash_key(key);
    i := hash && (capacity - 1);

    while i: 0..size {
        e := entries[i] unless catch then return .GENERIC!;
        if e.key == null || hash_key == null then break;
        if key == hash_key.key {
            hash_key.value = value;
            return hash_key.value;
        }
    }

    return .NOT_FOUND!;
}

expand :: proc (using hash_table: *Hash_Table) -> (Void <> Hash_Table_Error) {
    new_capacity :: capacity * 2;
    if new_capacity < capacity then return overflow!;

    new_entry := calloc(new_capacity, size_of Entry<hash_table.V>)?;
    while i: 0..capacity {
        local_entry := entry[i] unless {
            return .GENERIC!;
        }
        if key != null then set_entry(new_entry, new_capacity, key, value, null);
    }

    entry = new_entry;
    capacity = new_capacity;
}

set :: proc (using hash_table: *Hash_Table, key: hash_table.K, value: hash_table.V) -> (hash_table.K <> Hash_Table_Error) {
    if size >= (capacity / 2) {
        expand(hash_table) unless {
            return .GENERIC!;
        }
    }
    key := set_entry(entry, capacity, key, value, size);
    return key;
}

next :: proc (using hash_table: *Hash_Table, it: *Hash_Table_Iterator) -> (Void <> Hash_Table_Error) {
    table := it.table;
    while i: it.index..capacity {
        item := entry[i] unless {
            return .GENERIC!;
        }
        if item.key != null {
            it.key = item.key;
            it.value = item.value;
            return;
        }
    }
    return .OUT_OF_BOUNDS!;
}

#scope «file»;

fnv_off_set :: 14695981039346656037;
fnv_prime   :: 1099511628211;

hash_key <K, V: Type> :: proc (key: *K) -> V {
    hash := fnt_off_set;
    tmp := key;

    while i: 0..length(tmp) {
        current_char := tmp[i];
        hash ^= current-char as U64;
        hash *= fnv_prime;
    }

    return hash;
}

set_entry :: proc (using entry: Entry, capacity: U64, key: *entry.K, value: entry.V, size: *U64?) -> (entry.K <> Hash_Table_Error) {
    i := has_key(key) && (capacity - 1);

    while true {
        cur_entry := entry[i] unless {
            .GENERIC!;
        }
        if cur_entry.key == null then break;
        if cur_entry.key == key {
            cur_entry.value = value;
            return cur_entry.key;
        }
        i++;
    }

    if size == null {
        key = strdup(key);
        (size.*)++;
    }

    cur_entry := entry[i] unless {
        return .GENERIC!;
    }
    cur_entry.key = key;
    cur_entry.value = value;
    return key;
}

mem :: #import «core/allocators»;
