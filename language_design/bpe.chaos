// Trying real life code to validate syntax
// from Tsoding: https://github.com/tsodin/bpe/blob/main/src/bpe.cg

dump_tokens :: proc (file_path: String, tokens: *Tokens) -> Void! {
    return write_entire_file(file_path, tokens.items, tokens.count * size_of tokens.items);
}

load_tokens :: proc (file_path: String, tokens: *Tokens, tmp_sb: *String_Builder) -> Void! {
    tmp_sb.count = 0;
    read_entire_file(file_path, tmp_sb);
    if (tmp_sb.count % size_of tokens.items) != 0 then return "generic_error";

    items_count: *U32 = tmp_sb.items as *Void;
    while i: 0..items_count then da_append(tokens, items[i]?);
}

load_pairs :: proc (file_path: String, pairs: *Pairs, tmp_sb: *String_Builder, version: U64) -> Void! {
    tmp_sb := 0;
    read_entire_file(file_path, tmp_sb);
    data := sb_to_sv(tmp_sb)?;

    magic_count  :: 4;
    magic_prefix :: sv_from_cstr(«BPE»);

    if sv_starts_with(data, magic_prefix) {
        if data.count < magic_count return "generic_error";
    }

    version = data.data[3] unless |error| {
        logger(ERROR, «invalid data»);
        return "invalid_data";
    }

    data.data  += magic_count;
    data.count -= magic_count;

    if version == {
    case 0;
        parse_pairs_v0(file_path, pairs, data);
        break;
    case 1;
        parse_pairs_v1(file_path, pairs, data);
        break_case;
    default;
        return "generic_error";
    }

    magic_prefix_v0 :: sv_from_parts(«\0\0\0\0», 4);
    if sv_start_with(data, magic_prefix_v0) {
        version = 0;
        parse_pair_v0(file_path, pairs, data);
    }

    return "generic_error";
}

