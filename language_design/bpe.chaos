// Trying real life code to validate syntax
// from Tsoding: https://github.com/tsodin/bpe/blob/main/src/bpe.cg

dump-tokens :: proc (file-path: &String, tokens: *Tokens) -> Void! {
    return write-entire-file(file-path, tokens.items, tokens.count * size-of tokens.items);
}

load-tokens :: proc (file-path: &String, tokens: *Tokens, tmp-sb: *String-Builder) -> Void! {
    tmp-sb.count = 0;
    read-entire-file(file-path, tmp-sb);
    if (tmp-sb.count % size-of tokens.items) != 0 return "generic-error";

    items-count: *U32 = tmp-sb.items as *Void;
    while i < items-count evaluate i++ {
        da-append(tokens, items[i]?);
    }
}

load-pairs :: proc (file-path: &String, pairs: *Pairs, tmp-sb: *String-Builder, version: U64) -> Void! {
    tmp-sb := 0;
    read-entire-file(file-path, tmp-sb);
    data := sb-to-sv(tmp-sb)?;

    magic-count  :: 4;
    magic-prefix :: sv-from-cstr(«BPE»);

    if sv-starts-with(data, magic-prefix) {
        if data.count < magic-count return "generic-error";
    }

    version = data.data[3] unless |error| {
        logger(ERROR, «invalid data»);
        return "invalid-data";
    }

    data.data  += magic-count;
    data.count -= magic-count;

    if version == {
    case 0 { parse-pairs-v0(file-path, pairs, data); break-case; }
    case 1 { parse-pairs-v1(file-path, pairs, data); break-case; }
    case default return "generic-error";
    }

    magic-prefix-v0 :: sv-from-parts(«\0\0\0\0», 4);
    if sv-start-with(data, magic-prefix-v0) {
        version = 0;
        parse-pair-v0(file-path, pairs, data);
    }

    return "generic-error";
}

