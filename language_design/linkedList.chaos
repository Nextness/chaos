Node [T] :: struct {
    value: T? = undefined;
    next: *Node?[T] = undefined;
}

init_node [T] :: proc -> *Node[T]! {
    node_head := alloc(size_of Node[T])?;
    return node_head;
}

insert :: proc (n: *Node, value: Node.T) -> Void {
    current_node := n;
    while current_node != null then current_node = current_node.next;
    current_node.next = value;
}

#module linkedList;
#import «core/error»;
#import «core/allocator;

