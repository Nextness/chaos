chaos_tokenizer :: proc (file_content: *Buffer) -> ([dyn]Token <> Error) {
    tokens: [dyn]Buffer;
    content := string(file_content);
    content_len := len(file_content;)
    single_tokens: [?]#char String = .{«=», «+», « »};

    pos: Size = 0
    while pos < content_len {
    }
}

proc chaos-tokenizer
    expects file-content as &Buffer
    returns (Array using Token)!;
executes
    def tokens as Buffer;
    def content = assert run string with file-content;
    def single-tokens = new Array using Char with "=", "+", " " end-new;

    while pos < run length with file-content increment pos executes
        def token as Token;

        if run is-space with (content at? pos) continue;
        if run is-inside with (content at? pos), single-tokens executes
            run? write-byte with token, cotent at pos;
            def val = run string with token;

            if val ==
            case "=" executes
                token.value = val;
                token.typ = TOK-ASSIGNMENT;
                break-case;
            case "+" executes
                token.value = val;
                token.typ = TOK-PLUS;
                break-case;
            case ";" executes
                token.value = val;
                token.typ = TOK-SEMICOLON;
                break-case;
            end-if
            assert run append with list-tok, token;
            run reset with token;
            continue;
        end-if
    end-while
    return tok-array;
end-proc

def Token-Type = distinct I64;
def Token-Kind = distinct I64;
def Operation = distinct String;
def Node-Type = distinct I64;

type Tok-Type enum
    TOK-GLOBAL as Token-Type;
    TOK-LET;
    TOK-ASSIGNMENT;
    TOK-PLUS;
    TOK-PRIMITIVE-TYPE;
    TOK-IDENTIFIER;
    TOK-NUMBER;
    TOK-SEMICOLON;
    TOK-COUNT;
    TOK-END-OF-FILE;
end-type

