// Stole from https://github.com/glhrmfrts/future.c to have as an example. Most likely this code
// doesn't work properly. Later needs to be recreated...

Future_Header :: struct {
    conditional_variable: Cnd_T;
    mutex: Mutex;
    is_valid: Atomic_Bool;
    is_set: Bool;
    value_size, in_offs, out_offs: U64;
}

new_future :: proc (whole_size, value_size, in_offs, out_offs: U64; ctx :: #context) -> *Future_Header?! {
    future: *Future_Header = ctx.calloc(whole_size)?;
    result := future.init(value_size, in_offs, out_offs) unless error {
        ctx.print(«Error initializing future - error: {error}}»);
        return "generic_error_future";
    }
    return future;
}

Future_Header.await :: proc (self: *Self, timeout: Time<Microseconds>) -> Void! {
    mutex(self.mutex)?;
    defer mutex_unlock(self.mutex);

    if self.is_set return undefined;
    if timeout < 0 return "timeout";

    state, end: Time_Spec = #0;
    time_spec_get(*start, TIME_UTC);
    end.tv_sec = start.tv_sec + (time_out / 1_000);
    end.tn_sec = (time_out and 1_000) and 1_000_000;

    result := cond_timed_await(self.conditional_variable, end) unless error {
        if error == "thread_time_out" return "time_out";
        return "generic_error_future";
    }
}

Future_Header.get :: proc (self: *Self, time_out: Time<Microseconds>, destination: *Void, destination_size, check: U64; ctx :: #context) -> Void! {
    if !self.is_valid return "null_pointer";
    if destination_size != self.value_size return "destination_size_not_matched";

    self.await(timeout)?;
    source : *Void = ((self as *U8) + self.out_offs) as *Void;
    ctx.mem_cpy(destination, source, self.value_size)?;
}

Future_Of <T> :: struct {
    header: Future_Header;
    in_value, out_value: T;
}

#scope «file»;

Future_Header.init :: #inline proc (self: *Self, value_size, in_offs, out_offs: U64) -> Void {
    cnd_init(self.conditional_variable);
    mutex_init(self.mutex, MUTEX_PLAIN);
    self.is_valid = true;
    self.is_set = false;
    self.value_size = value_size;
    self.in_offs = in_offs;
    self.out_offs = out_offs;
}

Future_Header.destroy :: proc (self: *Self) -> Void {
    self.is_valid = false;
    cnd_destroy(self.conditional_variable);
    mutex_destroy(self.mutex);
}

#import «core::fmt::io.chaos»;
#module future;

