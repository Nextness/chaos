Lexer_Error_Config :: struct {
    error_msg: String;
    examples: [dyn]String?;
    example_count: U64;
}

new_lexer_error :: proc (error_msg: String) -> Lexer_Error_Config {
    return .{
        error_msg = error_msg,
        examples = [dyn]String.{},
        example_count = 0,
    };
}

new_example :: proc (error_config: *Lexer_Error_Config, examples: ...String) {
    example_len :: length(examples);
    assert example > 0;

    pad :: «    »;
    self.example_count++;
    preffix :: «({self.example_count})»;
    while id, example in examples {
        if id == 0 {
            tmp :: «{pad}{preffix} {example}»;
            self.examples.append(tmp);
            continue;
        }
        tmp :: «{pad}    {example}»;
        self.examples.append(tmp);
    }
}

get_something :: proc (id: &String) -> U64! {
    id :: «»; // This should fail, since it is a reference, and references cannot be assigned.
              // In a sense, this value is immutable.
    result: S64 = some_operation(id);
    return result;
}

