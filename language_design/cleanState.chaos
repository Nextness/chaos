Context [T] :: scaffold {
    logger: Logger;
}

Custom [K] :: struct {
    value: String;
    another: U64;
    key: K;
}

some_operation [K] :: #inline proc (value: String, another: U64, key: K) -> *Custom[K] {
    result := Custom[K].{value, another, key};
    print(«Got the result: {result}\n»);
    return *result;
}

Version :: struct {
    major, minor, fix: U64;
    phase: String? = null;
}

string :: #overload proc (using version: *Version) -> String {
    version_string := «{major}.{minor}.{fix}»;
    if phase != null then version_string = «{version_string}-{phase}»;
    return version_string;
}

some_function_with_acquire :: proc (acquire some_struct: *Some_Struct) -> String! {
    ...;
}

at_another_point :: proc (input1: String, input2: U64) -> String {
    new_struct: *Some_Struct;
    acquire new_struct = malloc(size_of(Some_Struct)) unless |error| {
        logger.error(«{error}: {error.reason()}»);
        return «unknown»;
    }
    result := some_function_with_acquire(relinquish new_struct)?;
    return result;
}

new_counter :: proc -> (relinquish *U64, *proc -> U64)! {
    #let result :: #run get_current_os();
    #if result == .linux {
        some_variable: U64 = acquire malloc(size_of U64)?;
        counter :: proc (var := some_variable) -> U64 {
            return (var.*)++;
        }
        return relinquish some_variable, counter;
    }
    #todo;
}

acquire ptr, counter :: new_counter() unless |error| {
    exit 69, «failed be create a new counter»;
}

switch_test_new :: proc (something: Some_Enum) -> Void! {
    @something if something == {
    case .a;
        print(«{A}\n»);
        break @something;
    case .b;
        print(«Something else {B}\n»);
        break @something;
    case .c;
        print(«String {D}s nuuutz\n»);
        break @something;
    default;
        return "error";
    }
}

optional_return_assignment :: proc (value: String) -> (Bool, #optional String) {
    result := some_operation(value);
    if result != null then return true, «valid»;
    return false, «invalid»;
}

// This will only return the boolean value. Unless specified another argument, which 
// in this case, will be a string.
result := optional_return_assignment(«something that works»);
result1, result2 :: optional_return-assignment(«somethig that doesn't work»);

