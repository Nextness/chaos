// Example comment
/** Multiline Comments
 *  /** Nested comment **/
**/

new_variable :: 10;

another_operation :: proc (input: I64) -> Void {
    exit 10;
}

main :: #entry proc -> Void {
    something: F32 = 10.1;
    something_1: String = «oiashda»;
    something_2: I64 = 10;
    something_3: Bool = true;
    another_operation(1);
    exit 69;
}

