global def new-variable = 10;

proc another-operation
    expects input as I64
    returns Void
executes
    exit 10;
end-proc

proc main returns Void executes
    def something as F32 = 10.1;
    def something-1 as String = «adiasjda__»;
    def something-2 as I64= 10;
    def something-3 as Bool = true;
    run another-operation with 1 end-run;
    // run another-operation with 1 end-run;
    // run another-operation with 1 end-run;
    // run another-operation with 1 end-run;
    // run another-operation with 1 end-run;
    exit 69;
end-proc

