// Examples 1
bin_op_0 :: 1 + 0;                                        // 1
bin_op_1 := bin_op_0 + 1;                                 // 2
bin_op_2 : S64 : 3 + 4;                                   // 7
bin_op_3 : S64 = 6 + 5;                                   // 11
bin_op_4 : S64 = bin_op_0 + bin_op_0;                     // 2
bin_op_5 := bin_op_4 + bin_op_0;                          // 2 + 1 = 3
bin_op_6 := bin_op_5 + bin_op_0;                          // 3 + 1 = 4
bin_op_7 :: (bin_op_0 + 3) * 2;                           // (1 + 3) * 2 = 8
bin_op_8 : S64 = (bin_op_4 + bin_op_7) * (1 + bion_op_1); // (2 + 8) * (1 + 2) = 30
